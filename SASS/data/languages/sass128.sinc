# NVIDIA SASS, 128-bit instruction encodings (Volta and later): common definitions.
# Included by every sass_SMxx.slaspec before the generated instruction file.

define endian=little;
define alignment=16;

# generic / global address space (64-bit), plus the GPU state spaces
define space ram      type=ram_space      size=8  default;
define space shared   type=ram_space      size=4;
define space local    type=ram_space      size=4;
define space cbank    type=ram_space      size=4;    # c[bank][offset] -> bank*0x10000 + offset
define space register type=register_space size=4;

# general purpose registers (R255 = RZ reads as zero)
define register offset=0x0000 size=4 [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 R16 R17 R18 R19 R20 R21 R22 R23 R24 R25 R26 R27 R28 R29 R30 R31 R32 R33 R34 R35 R36 R37 R38 R39 R40 R41 R42 R43 R44 R45 R46 R47 R48 R49 R50 R51 R52 R53 R54 R55 R56 R57 R58 R59 R60 R61 R62 R63 R64 R65 R66 R67 R68 R69 R70 R71 R72 R73 R74 R75 R76 R77 R78 R79 R80 R81 R82 R83 R84 R85 R86 R87 R88 R89 R90 R91 R92 R93 R94 R95 R96 R97 R98 R99 R100 R101 R102 R103 R104 R105 R106 R107 R108 R109 R110 R111 R112 R113 R114 R115 R116 R117 R118 R119 R120 R121 R122 R123 R124 R125 R126 R127 R128 R129 R130 R131 R132 R133 R134 R135 R136 R137 R138 R139 R140 R141 R142 R143 R144 R145 R146 R147 R148 R149 R150 R151 R152 R153 R154 R155 R156 R157 R158 R159 R160 R161 R162 R163 R164 R165 R166 R167 R168 R169 R170 R171 R172 R173 R174 R175 R176 R177 R178 R179 R180 R181 R182 R183 R184 R185 R186 R187 R188 R189 R190 R191 R192 R193 R194 R195 R196 R197 R198 R199 R200 R201 R202 R203 R204 R205 R206 R207 R208 R209 R210 R211 R212 R213 R214 R215 R216 R217 R218 R219 R220 R221 R222 R223 R224 R225 R226 R227 R228 R229 R230 R231 R232 R233 R234 R235 R236 R237 R238 R239 R240 R241 R242 R243 R244 R245 R246 R247 R248 R249 R250 R251 R252 R253 R254 RZ ];
# 64-bit and 128-bit register tuples starting at any register (RDn = Rn:Rn+1)
define register offset=0x0000 size=8 [ RD0 RD2 RD4 RD6 RD8 RD10 RD12 RD14 RD16 RD18 RD20 RD22 RD24 RD26 RD28 RD30 RD32 RD34 RD36 RD38 RD40 RD42 RD44 RD46 RD48 RD50 RD52 RD54 RD56 RD58 RD60 RD62 RD64 RD66 RD68 RD70 RD72 RD74 RD76 RD78 RD80 RD82 RD84 RD86 RD88 RD90 RD92 RD94 RD96 RD98 RD100 RD102 RD104 RD106 RD108 RD110 RD112 RD114 RD116 RD118 RD120 RD122 RD124 RD126 RD128 RD130 RD132 RD134 RD136 RD138 RD140 RD142 RD144 RD146 RD148 RD150 RD152 RD154 RD156 RD158 RD160 RD162 RD164 RD166 RD168 RD170 RD172 RD174 RD176 RD178 RD180 RD182 RD184 RD186 RD188 RD190 RD192 RD194 RD196 RD198 RD200 RD202 RD204 RD206 RD208 RD210 RD212 RD214 RD216 RD218 RD220 RD222 RD224 RD226 RD228 RD230 RD232 RD234 RD236 RD238 RD240 RD242 RD244 RD246 RD248 RD250 RD252 RD254 ];
define register offset=0x0004 size=8 [ RD1 RD3 RD5 RD7 RD9 RD11 RD13 RD15 RD17 RD19 RD21 RD23 RD25 RD27 RD29 RD31 RD33 RD35 RD37 RD39 RD41 RD43 RD45 RD47 RD49 RD51 RD53 RD55 RD57 RD59 RD61 RD63 RD65 RD67 RD69 RD71 RD73 RD75 RD77 RD79 RD81 RD83 RD85 RD87 RD89 RD91 RD93 RD95 RD97 RD99 RD101 RD103 RD105 RD107 RD109 RD111 RD113 RD115 RD117 RD119 RD121 RD123 RD125 RD127 RD129 RD131 RD133 RD135 RD137 RD139 RD141 RD143 RD145 RD147 RD149 RD151 RD153 RD155 RD157 RD159 RD161 RD163 RD165 RD167 RD169 RD171 RD173 RD175 RD177 RD179 RD181 RD183 RD185 RD187 RD189 RD191 RD193 RD195 RD197 RD199 RD201 RD203 RD205 RD207 RD209 RD211 RD213 RD215 RD217 RD219 RD221 RD223 RD225 RD227 RD229 RD231 RD233 RD235 RD237 RD239 RD241 RD243 RD245 RD247 RD249 RD251 RD253 ];
define register offset=0x0000 size=16 [ RQ0 RQ4 RQ8 RQ12 RQ16 RQ20 RQ24 RQ28 RQ32 RQ36 RQ40 RQ44 RQ48 RQ52 RQ56 RQ60 RQ64 RQ68 RQ72 RQ76 RQ80 RQ84 RQ88 RQ92 RQ96 RQ100 RQ104 RQ108 RQ112 RQ116 RQ120 RQ124 RQ128 RQ132 RQ136 RQ140 RQ144 RQ148 RQ152 RQ156 RQ160 RQ164 RQ168 RQ172 RQ176 RQ180 RQ184 RQ188 RQ192 RQ196 RQ200 RQ204 RQ208 RQ212 RQ216 RQ220 RQ224 RQ228 RQ232 RQ236 RQ240 RQ244 RQ248 RQ252 ];
define register offset=0x0004 size=16 [ RQ1 RQ5 RQ9 RQ13 RQ17 RQ21 RQ25 RQ29 RQ33 RQ37 RQ41 RQ45 RQ49 RQ53 RQ57 RQ61 RQ65 RQ69 RQ73 RQ77 RQ81 RQ85 RQ89 RQ93 RQ97 RQ101 RQ105 RQ109 RQ113 RQ117 RQ121 RQ125 RQ129 RQ133 RQ137 RQ141 RQ145 RQ149 RQ153 RQ157 RQ161 RQ165 RQ169 RQ173 RQ177 RQ181 RQ185 RQ189 RQ193 RQ197 RQ201 RQ205 RQ209 RQ213 RQ217 RQ221 RQ225 RQ229 RQ233 RQ237 RQ241 RQ245 RQ249 ];
define register offset=0x0008 size=16 [ RQ2 RQ6 RQ10 RQ14 RQ18 RQ22 RQ26 RQ30 RQ34 RQ38 RQ42 RQ46 RQ50 RQ54 RQ58 RQ62 RQ66 RQ70 RQ74 RQ78 RQ82 RQ86 RQ90 RQ94 RQ98 RQ102 RQ106 RQ110 RQ114 RQ118 RQ122 RQ126 RQ130 RQ134 RQ138 RQ142 RQ146 RQ150 RQ154 RQ158 RQ162 RQ166 RQ170 RQ174 RQ178 RQ182 RQ186 RQ190 RQ194 RQ198 RQ202 RQ206 RQ210 RQ214 RQ218 RQ222 RQ226 RQ230 RQ234 RQ238 RQ242 RQ246 RQ250 ];
define register offset=0x000c size=16 [ RQ3 RQ7 RQ11 RQ15 RQ19 RQ23 RQ27 RQ31 RQ35 RQ39 RQ43 RQ47 RQ51 RQ55 RQ59 RQ63 RQ67 RQ71 RQ75 RQ79 RQ83 RQ87 RQ91 RQ95 RQ99 RQ103 RQ107 RQ111 RQ115 RQ119 RQ123 RQ127 RQ131 RQ135 RQ139 RQ143 RQ147 RQ151 RQ155 RQ159 RQ163 RQ167 RQ171 RQ175 RQ179 RQ183 RQ187 RQ191 RQ195 RQ199 RQ203 RQ207 RQ211 RQ215 RQ219 RQ223 RQ227 RQ231 RQ235 RQ239 RQ243 RQ247 RQ251 ];
# uniform registers (UR63 = URZ)
define register offset=0x0400 size=4 [ UR0 UR1 UR2 UR3 UR4 UR5 UR6 UR7 UR8 UR9 UR10 UR11 UR12 UR13 UR14 UR15 UR16 UR17 UR18 UR19 UR20 UR21 UR22 UR23 UR24 UR25 UR26 UR27 UR28 UR29 UR30 UR31 UR32 UR33 UR34 UR35 UR36 UR37 UR38 UR39 UR40 UR41 UR42 UR43 UR44 UR45 UR46 UR47 UR48 UR49 UR50 UR51 UR52 UR53 UR54 UR55 UR56 UR57 UR58 UR59 UR60 UR61 UR62 URZ ];
define register offset=0x0400 size=8 [ URD0 URD2 URD4 URD6 URD8 URD10 URD12 URD14 URD16 URD18 URD20 URD22 URD24 URD26 URD28 URD30 URD32 URD34 URD36 URD38 URD40 URD42 URD44 URD46 URD48 URD50 URD52 URD54 URD56 URD58 URD60 URD62 ];
define register offset=0x0404 size=8 [ URD1 URD3 URD5 URD7 URD9 URD11 URD13 URD15 URD17 URD19 URD21 URD23 URD25 URD27 URD29 URD31 URD33 URD35 URD37 URD39 URD41 URD43 URD45 URD47 URD49 URD51 URD53 URD55 URD57 URD59 URD61 ];
define register offset=0x0400 size=16 [ URQ0 URQ4 URQ8 URQ12 URQ16 URQ20 URQ24 URQ28 URQ32 URQ36 URQ40 URQ44 URQ48 URQ52 URQ56 URQ60 ];
# predicates (P7 = PT, UP7 = UPT)
define register offset=0x0500 size=1 [ P0 P1 P2 P3 P4 P5 P6 PT ];
define register offset=0x0508 size=1 [ UP0 UP1 UP2 UP3 UP4 UP5 UP6 UPT ];
# convergence barrier registers
define register offset=0x0600 size=4 [ B0 B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 B12 B13 B14 B15 ];
define register offset=0x0700 size=8 [ PC RETPC ];
define register offset=0x0800 size=8 [ RDZ URDZ ];
define register offset=0x0820 size=16 [ RQZ ];
define register offset=0x0900 size=1 [ DUMMYP ];
define register offset=0x0910 size=4 [ DUMMY4 ];
define register offset=0x0920 size=8 [ DUMMY8 ];
define register offset=0x0930 size=16 [ DUMMY16 ];

define pcodeop sass_op;
