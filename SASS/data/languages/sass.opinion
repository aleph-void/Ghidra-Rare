<?xml version="1.0" encoding="UTF-8"?>
<opinions>
  <!-- e_machine 190 = EM_CUDA; secondary = e_flags with the SM number in bits 0-7
       (CUDA <= 12) or bits 8-15 (CUDA 13). -->
  <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
    <constraint primary="190" secondary="0b........................00110010" processor="SASS" endian="little" size="64" variant="SM52"/> <!-- sm_50, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................00110010........" processor="SASS" endian="little" size="64" variant="SM52"/> <!-- sm_50, CUDA 13 -->
    <constraint primary="190" secondary="0b........................00110100" processor="SASS" endian="little" size="64" variant="SM52"/> <!-- sm_52, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................00110100........" processor="SASS" endian="little" size="64" variant="SM52"/> <!-- sm_52, CUDA 13 -->
    <constraint primary="190" secondary="0b........................00110101" processor="SASS" endian="little" size="64" variant="SM52"/> <!-- sm_53, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................00110101........" processor="SASS" endian="little" size="64" variant="SM52"/> <!-- sm_53, CUDA 13 -->
    <constraint primary="190" secondary="0b........................01001011" processor="SASS" endian="little" size="64" variant="SM75"/> <!-- sm_75, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................01001011........" processor="SASS" endian="little" size="64" variant="SM75"/> <!-- sm_75, CUDA 13 -->
    <constraint primary="190" secondary="0b........................01010000" processor="SASS" endian="little" size="64" variant="SM80"/> <!-- sm_80, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................01010000........" processor="SASS" endian="little" size="64" variant="SM80"/> <!-- sm_80, CUDA 13 -->
    <constraint primary="190" secondary="0b........................01010110" processor="SASS" endian="little" size="64" variant="SM86"/> <!-- sm_86, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................01010110........" processor="SASS" endian="little" size="64" variant="SM86"/> <!-- sm_86, CUDA 13 -->
    <constraint primary="190" secondary="0b........................01010111" processor="SASS" endian="little" size="64" variant="SM86"/> <!-- sm_87, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................01010111........" processor="SASS" endian="little" size="64" variant="SM86"/> <!-- sm_87, CUDA 13 -->
    <constraint primary="190" secondary="0b........................01011000" processor="SASS" endian="little" size="64" variant="SM86"/> <!-- sm_88, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................01011000........" processor="SASS" endian="little" size="64" variant="SM86"/> <!-- sm_88, CUDA 13 -->
    <constraint primary="190" secondary="0b........................01011001" processor="SASS" endian="little" size="64" variant="SM89"/> <!-- sm_89, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................01011001........" processor="SASS" endian="little" size="64" variant="SM89"/> <!-- sm_89, CUDA 13 -->
    <constraint primary="190" secondary="0b........................01011010" processor="SASS" endian="little" size="64" variant="SM90"/> <!-- sm_90, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................01011010........" processor="SASS" endian="little" size="64" variant="SM90"/> <!-- sm_90, CUDA 13 -->
  </constraint>
</opinions>
