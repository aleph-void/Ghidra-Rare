<?xml version="1.0" encoding="UTF-8"?>
<opinions>
  <!-- e_machine 190 = EM_CUDA; secondary = e_flags with the SM number in bits 0-7
       (CUDA <= 12) or bits 8-15 (CUDA 13). -->
  <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
    <constraint primary="190" secondary="0b........................00100011" processor="SASS" endian="little" size="64" variant="SM35"/> <!-- sm_35, CUDA <= 12 -->
    <constraint primary="190" secondary="0b................00100011........" processor="SASS" endian="little" size="64" variant="SM35"/> <!-- sm_35, CUDA 13 -->
