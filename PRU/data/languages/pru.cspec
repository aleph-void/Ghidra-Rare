<?xml version="1.0" encoding="UTF-8"?>
<!-- TI PRU C ABI (PRU Optimizing C/C++ Compiler, SPRUHV7; GCC pru-elf follows it):
     R2 = stack pointer (grows down, in data memory), R3.w2 = return address,
     arguments in R14..R29, return value in R14 (R14:R15 for 64-bit),
     save-on-entry R3.w2..R13, save-on-call R0, R1, R14..R29. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0" />
    <machine_alignment value="1" />
    <default_alignment value="1" />
    <default_pointer_alignment value="1" />
    <pointer_size value="4" />
    <char_size value="1" />
    <wchar_size value="4" />
    <short_size value="2" />
    <integer_size value="4" />
    <long_size value="4" />
    <long_long_size value="8" />
    <float_size value="4" />
    <double_size value="8" />
    <long_double_size value="8" />
    <size_alignment_map>
      <entry size="1" alignment="1" />
      <entry size="2" alignment="1" />
      <entry size="4" alignment="1" />
      <entry size="8" alignment="1" />
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="code"/>
    <range space="data"/>
    <!-- R30 (GPO) and R31 (GPI / event status) are I/O ports, keep their accesses -->
    <register name="r30"/>
    <register name="r31"/>
  </global>
  <stackpointer register="sp" space="data" growth="negative"/>
  <returnaddress>
    <register name="ra.w2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4">
          <register name="r14"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r15"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r16"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r17"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r18"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r19"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r20"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r21"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r22"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r23"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r24"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r25"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r26"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r27"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r28"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="r29"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="1">
          <addr offset="0" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="r14"/>
        </pentry>
        <pentry minsize="5" maxsize="8">
          <addr space="join" piece1="r15" piece2="r14"/>
        </pentry>
      </output>
      <unaffected>
        <register name="sp"/>
        <register name="ra"/>
        <register name="fp"/>
        <register name="r5"/>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r8"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
      </unaffected>
      <killedbycall>
        <register name="r0"/>
        <register name="r1"/>
        <register name="r14"/>
        <register name="r15"/>
        <register name="r16"/>
        <register name="r17"/>
        <register name="r18"/>
        <register name="r19"/>
        <register name="r20"/>
        <register name="r21"/>
        <register name="r22"/>
        <register name="r23"/>
        <register name="r24"/>
        <register name="r25"/>
        <register name="r26"/>
        <register name="r27"/>
        <register name="r28"/>
        <register name="r29"/>
        <register name="CARRY"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
