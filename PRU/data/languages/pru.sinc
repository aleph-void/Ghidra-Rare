  if (i >= r0.b0) goto <done>;
  local p:4 = (rd << 2) + rdb + zext(i);
  *[register]:1 p = mpy_xin(i, r25, r28, r29);
  i = i + 1;
  goto <top>;
  <done>
}
MPYB: "r0.b1" is xlen=125 & rd & rdb & xwba {
  local i:1 = 0;
  <top>
  if (i >= r0.b1) goto <done>;
  local p:4 = (rd << 2) + rdb + zext(i);
  *[register]:1 p = mpy_xin(i, r25, r28, r29);
  i = i + 1;
  goto <top>;
  <done>
}
MPYB: "r0.b2" is xlen=126 & rd & rdb & xwba {
  local i:1 = 0;
  <top>
  if (i >= r0.b2) goto <done>;
  local p:4 = (rd << 2) + rdb + zext(i);
  *[register]:1 p = mpy_xin(i, r25, r28, r29);
  i = i + 1;
  goto <top>;
  <done>
}
MPYB: "r0.b3" is xlen=127 & rd & rdb & xwba {
  local i:1 = 0;
  <top>
  if (i >= r0.b3) goto <done>;
  local p:4 = (rd << 2) + rdb + zext(i);
  *[register]:1 p = mpy_xin(i, r25, r28, r29);
  i = i + 1;
  goto <top>;
  <done>
}
@endif


# ---------------------------------------------------------------------------
# top level: hardware-loop bookkeeping
# ---------------------------------------------------------------------------
LTOP: dest is looptop [ dest = looptop << 2; ] { export *[code]:4 dest; }

:^instruction is phase=0 & loopend=0 & instruction [ phase=1; ] { build instruction; }
:^instruction is phase=0 & loopend=1 & instruction & LTOP [ phase=1; ] {
  build instruction;
  LOOP_CNT = LOOP_CNT - 1;
  if (LOOP_CNT != 0) goto LTOP;
}

with : phase=1 {

# ---- Format 1: arithmetic / logic
:add D1, S1, OP2 is op3=0 & subop=0 & rdsel<4 & D1 & S1 & OP2 { local t:8 = zext(S1) + zext(OP2); D1 = t:1; CARRY = t[8,1]; }
:add D2, S1, OP2 is op3=0 & subop=0 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local t:8 = zext(S1) + zext(OP2); D2 = t:2; CARRY = t[16,1]; }
:add D4, S1, OP2 is op3=0 & subop=0 & rdsel=7 & D4 & S1 & OP2 { local t:8 = zext(S1) + zext(OP2); D4 = t:4; CARRY = t[32,1]; }
:adc D1, S1, OP2 is op3=0 & subop=1 & rdsel<4 & D1 & S1 & OP2 { local t:8 = zext(S1) + zext(OP2) + zext(CARRY); D1 = t:1; CARRY = t[8,1]; }
:adc D2, S1, OP2 is op3=0 & subop=1 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local t:8 = zext(S1) + zext(OP2) + zext(CARRY); D2 = t:2; CARRY = t[16,1]; }
:adc D4, S1, OP2 is op3=0 & subop=1 & rdsel=7 & D4 & S1 & OP2 { local t:8 = zext(S1) + zext(OP2) + zext(CARRY); D4 = t:4; CARRY = t[32,1]; }
:sub D1, S1, OP2 is op3=0 & subop=2 & rdsel<4 & D1 & S1 & OP2 { local t:8 = zext(S1) - zext(OP2); D1 = t:1; CARRY = t[8,1]; }
:sub D2, S1, OP2 is op3=0 & subop=2 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local t:8 = zext(S1) - zext(OP2); D2 = t:2; CARRY = t[16,1]; }
:sub D4, S1, OP2 is op3=0 & subop=2 & rdsel=7 & D4 & S1 & OP2 { local t:8 = zext(S1) - zext(OP2); D4 = t:4; CARRY = t[32,1]; }
:suc D1, S1, OP2 is op3=0 & subop=3 & rdsel<4 & D1 & S1 & OP2 { local t:8 = zext(S1) - zext(OP2) - zext(CARRY); D1 = t:1; CARRY = t[8,1]; }
:suc D2, S1, OP2 is op3=0 & subop=3 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local t:8 = zext(S1) - zext(OP2) - zext(CARRY); D2 = t:2; CARRY = t[16,1]; }
:suc D4, S1, OP2 is op3=0 & subop=3 & rdsel=7 & D4 & S1 & OP2 { local t:8 = zext(S1) - zext(OP2) - zext(CARRY); D4 = t:4; CARRY = t[32,1]; }
:lsl D1, S1, OP2 is op3=0 & subop=4 & rdsel<4 & D1 & S1 & OP2 { local r:4 = S1 << (OP2 & 0x1f); D1 = r:1; }
:lsl D2, S1, OP2 is op3=0 & subop=4 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = S1 << (OP2 & 0x1f); D2 = r:2; }
:lsl D4, S1, OP2 is op3=0 & subop=4 & rdsel=7 & D4 & S1 & OP2 { D4 = S1 << (OP2 & 0x1f); }
:lsr D1, S1, OP2 is op3=0 & subop=5 & rdsel<4 & D1 & S1 & OP2 { local r:4 = S1 >> (OP2 & 0x1f); D1 = r:1; }
:lsr D2, S1, OP2 is op3=0 & subop=5 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = S1 >> (OP2 & 0x1f); D2 = r:2; }
:lsr D4, S1, OP2 is op3=0 & subop=5 & rdsel=7 & D4 & S1 & OP2 { D4 = S1 >> (OP2 & 0x1f); }
:rsb D1, S1, OP2 is op3=0 & subop=6 & rdsel<4 & D1 & S1 & OP2 { local t:8 = zext(OP2) - zext(S1); D1 = t:1; CARRY = t[8,1]; }
:rsb D2, S1, OP2 is op3=0 & subop=6 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local t:8 = zext(OP2) - zext(S1); D2 = t:2; CARRY = t[16,1]; }
:rsb D4, S1, OP2 is op3=0 & subop=6 & rdsel=7 & D4 & S1 & OP2 { local t:8 = zext(OP2) - zext(S1); D4 = t:4; CARRY = t[32,1]; }
:rsc D1, S1, OP2 is op3=0 & subop=7 & rdsel<4 & D1 & S1 & OP2 { local t:8 = zext(OP2) - zext(S1) - zext(CARRY); D1 = t:1; CARRY = t[8,1]; }
:rsc D2, S1, OP2 is op3=0 & subop=7 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local t:8 = zext(OP2) - zext(S1) - zext(CARRY); D2 = t:2; CARRY = t[16,1]; }
:rsc D4, S1, OP2 is op3=0 & subop=7 & rdsel=7 & D4 & S1 & OP2 { local t:8 = zext(OP2) - zext(S1) - zext(CARRY); D4 = t:4; CARRY = t[32,1]; }
:and D1, S1, OP2 is op3=0 & subop=8 & rdsel<4 & D1 & S1 & OP2 { local r:4 = S1 & OP2; D1 = r:1; }
:and D2, S1, OP2 is op3=0 & subop=8 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = S1 & OP2; D2 = r:2; }
:and D4, S1, OP2 is op3=0 & subop=8 & rdsel=7 & D4 & S1 & OP2 { D4 = S1 & OP2; }
:or D1, S1, OP2 is op3=0 & subop=9 & rdsel<4 & D1 & S1 & OP2 { local r:4 = S1 | OP2; D1 = r:1; }
:or D2, S1, OP2 is op3=0 & subop=9 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = S1 | OP2; D2 = r:2; }
:or D4, S1, OP2 is op3=0 & subop=9 & rdsel=7 & D4 & S1 & OP2 { D4 = S1 | OP2; }
:xor D1, S1, OP2 is op3=0 & subop=10 & rdsel<4 & D1 & S1 & OP2 { local r:4 = S1 ^ OP2; D1 = r:1; }
:xor D2, S1, OP2 is op3=0 & subop=10 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = S1 ^ OP2; D2 = r:2; }
:xor D4, S1, OP2 is op3=0 & subop=10 & rdsel=7 & D4 & S1 & OP2 { D4 = S1 ^ OP2; }
:not D1, S1 is op3=0 & subop=11 & rdsel<4 & D1 & S1 { local r:4 = ~S1; D1 = r:1; }
:not D2, S1 is op3=0 & subop=11 & rdsel>3 & rdsel<7 & D2 & S1 { local r:4 = ~S1; D2 = r:2; }
:not D4, S1 is op3=0 & subop=11 & rdsel=7 & D4 & S1 { D4 = ~S1; }
:min D1, S1, OP2 is op3=0 & subop=12 & rdsel<4 & D1 & S1 & OP2 { local r:4 = (zext(OP2 < S1) * OP2) + (zext(OP2 >= S1) * S1); D1 = r:1; }
:min D2, S1, OP2 is op3=0 & subop=12 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = (zext(OP2 < S1) * OP2) + (zext(OP2 >= S1) * S1); D2 = r:2; }
:min D4, S1, OP2 is op3=0 & subop=12 & rdsel=7 & D4 & S1 & OP2 { D4 = (zext(OP2 < S1) * OP2) + (zext(OP2 >= S1) * S1); }
:max D1, S1, OP2 is op3=0 & subop=13 & rdsel<4 & D1 & S1 & OP2 { local r:4 = (zext(OP2 > S1) * OP2) + (zext(OP2 <= S1) * S1); D1 = r:1; }
:max D2, S1, OP2 is op3=0 & subop=13 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = (zext(OP2 > S1) * OP2) + (zext(OP2 <= S1) * S1); D2 = r:2; }
:max D4, S1, OP2 is op3=0 & subop=13 & rdsel=7 & D4 & S1 & OP2 { D4 = (zext(OP2 > S1) * OP2) + (zext(OP2 <= S1) * S1); }
:clr D1, S1, OP2 is op3=0 & subop=14 & rdsel<4 & D1 & S1 & OP2 { local r:4 = S1 & ~(1 << (OP2 & 0x1f)); D1 = r:1; }
:clr D2, S1, OP2 is op3=0 & subop=14 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = S1 & ~(1 << (OP2 & 0x1f)); D2 = r:2; }
:clr D4, S1, OP2 is op3=0 & subop=14 & rdsel=7 & D4 & S1 & OP2 { D4 = S1 & ~(1 << (OP2 & 0x1f)); }
:set D1, S1, OP2 is op3=0 & subop=15 & rdsel<4 & D1 & S1 & OP2 { local r:4 = S1 | (1 << (OP2 & 0x1f)); D1 = r:1; }
:set D2, S1, OP2 is op3=0 & subop=15 & rdsel>3 & rdsel<7 & D2 & S1 & OP2 { local r:4 = S1 | (1 << (OP2 & 0x1f)); D2 = r:2; }
:set D4, S1, OP2 is op3=0 & subop=15 & rdsel=7 & D4 & S1 & OP2 { D4 = S1 | (1 << (OP2 & 0x1f)); }
# pseudo ops (binutils): nop = or r0, r0, r0 ; mov = or d, s, 0
:nop is op3=0 & subop=9 & io=0 & rs2sel=7 & rs2=0 & rs1sel=7 & rs1=0 & rdsel=7 & rd=0 { }
:mov D1, S1 is op3=0 & subop=9 & io=1 & imm8=0 & rdsel<4 & D1 & S1 { D1 = S1:1; }
:mov D2, S1 is op3=0 & subop=9 & io=1 & imm8=0 & rdsel>3 & rdsel<7 & D2 & S1 { D2 = S1:2; }
:mov D4, S1 is op3=0 & subop=9 & io=1 & imm8=0 & rdsel=7 & D4 & S1 { D4 = S1; }

# ---- Format 2: jumps, LDI, LMBD, HALT, SLP, XFR, LOOP, MVI
:jmp JT     is op3=1 & subop=0 & JT     { goto JT; }
:jmp S2     is op3=1 & subop=0 & io=0 & S2 { local w:2 = S2:2; local t:3 = zext(w) << 2; goto [t]; }
:ret        is op3=1 & subop=0 & io=0 & rs2sel=6 & rs2=3 { local t:3 = zext(ra.w2) << 2; return [t]; }

:jal D1, JT is op3=1 & subop=1 & rdsel<4 & D1 & JT { local l:2 = inst_next >> 2; D1 = l:1; call JT; }
:jal D1, S2 is op3=1 & subop=1 & io=0 & rdsel<4 & D1 & S2 { local w:2 = S2:2; local t:3 = zext(w) << 2; local l:2 = inst_next >> 2; D1 = l:1; call [t]; }
:jal D2, JT is op3=1 & subop=1 & rdsel>3 & rdsel<7 & D2 & JT { D2 = inst_next >> 2; call JT; }
:jal D2, S2 is op3=1 & subop=1 & io=0 & rdsel>3 & rdsel<7 & D2 & S2 { local w:2 = S2:2; local t:3 = zext(w) << 2; D2 = inst_next >> 2; call [t]; }
:jal D4, JT is op3=1 & subop=1 & rdsel=7 & D4 & JT { local l:2 = inst_next >> 2; D4 = zext(l); call JT; }
:jal D4, S2 is op3=1 & subop=1 & io=0 & rdsel=7 & D4 & S2 { local w:2 = S2:2; local t:3 = zext(w) << 2; local l:2 = inst_next >> 2; D4 = zext(l); call [t]; }
:call JT is op3=1 & subop=1 & rdsel=6 & rd=3 & JT { ra.w2 = inst_next >> 2; call JT; }
:call S2 is op3=1 & subop=1 & io=0 & rdsel=6 & rd=3 & S2 { local w:2 = S2:2; local t:3 = zext(w) << 2; ra.w2 = inst_next >> 2; call [t]; }
:ldi D1, imm16 is op3=1 & subop=2 & rdsel<4 & D1 & imm16 { local v:2 = imm16; D1 = v:1; }
:ldi D2, imm16 is op3=1 & subop=2 & rdsel>3 & rdsel<7 & D2 & imm16 { D2 = imm16; }
:ldi D4, imm16 is op3=1 & subop=2 & rdsel=7 & D4 & imm16 { D4 = imm16; }
@ifdef PRU_LMBD
:lmbd D1, N1, OP2 is op3=1 & subop=3 & rdsel<4 & rs1sel<4 & D1 & N1 & OP2 { local m:1 = (OP2:1 & 1) ^ 1; local x:1 = N1 ^ (m * 0xff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (7 - n)) + (zext(x == 0) * 32); D1 = r:1; }
:lmbd D1, N2, OP2 is op3=1 & subop=3 & rdsel<4 & rs1sel>3 & rs1sel<7 & D1 & N2 & OP2 { local m:2 = (OP2:2 & 1) ^ 1; local x:2 = N2 ^ (m * 0xffff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (15 - n)) + (zext(x == 0) * 32); D1 = r:1; }
:lmbd D1, N4, OP2 is op3=1 & subop=3 & rdsel<4 & rs1sel=7 & D1 & N4 & OP2 { local m:4 = (OP2 & 1) ^ 1; local x:4 = N4 ^ (m * 0xffffffff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (31 - n)) + (zext(x == 0) * 32); D1 = r:1; }
:lmbd D2, N1, OP2 is op3=1 & subop=3 & rdsel>3 & rdsel<7 & rs1sel<4 & D2 & N1 & OP2 { local m:1 = (OP2:1 & 1) ^ 1; local x:1 = N1 ^ (m * 0xff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (7 - n)) + (zext(x == 0) * 32); D2 = r:2; }
:lmbd D2, N2, OP2 is op3=1 & subop=3 & rdsel>3 & rdsel<7 & rs1sel>3 & rs1sel<7 & D2 & N2 & OP2 { local m:2 = (OP2:2 & 1) ^ 1; local x:2 = N2 ^ (m * 0xffff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (15 - n)) + (zext(x == 0) * 32); D2 = r:2; }
:lmbd D2, N4, OP2 is op3=1 & subop=3 & rdsel>3 & rdsel<7 & rs1sel=7 & D2 & N4 & OP2 { local m:4 = (OP2 & 1) ^ 1; local x:4 = N4 ^ (m * 0xffffffff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (31 - n)) + (zext(x == 0) * 32); D2 = r:2; }
:lmbd D4, N1, OP2 is op3=1 & subop=3 & rdsel=7 & rs1sel<4 & D4 & N1 & OP2 { local m:1 = (OP2:1 & 1) ^ 1; local x:1 = N1 ^ (m * 0xff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (7 - n)) + (zext(x == 0) * 32); D4 = r; }
:lmbd D4, N2, OP2 is op3=1 & subop=3 & rdsel=7 & rs1sel>3 & rs1sel<7 & D4 & N2 & OP2 { local m:2 = (OP2:2 & 1) ^ 1; local x:2 = N2 ^ (m * 0xffff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (15 - n)) + (zext(x == 0) * 32); D4 = r; }
:lmbd D4, N4, OP2 is op3=1 & subop=3 & rdsel=7 & rs1sel=7 & D4 & N4 & OP2 { local m:4 = (OP2 & 1) ^ 1; local x:4 = N4 ^ (m * 0xffffffff); local n:4 = lzcount(x); local r:4 = (zext(x != 0) * (31 - n)) + (zext(x == 0) * 32); D4 = r; }
@endif
:halt is op3=1 & subop=5 { halt(); goto inst_start; }
:slp wake is op3=1 & subop=15 & wake { sleep(wake:1); }

@ifdef PRU_XFR
:xin xwba, BD, XINB is op3=1 & subop=7 & xsub=1 & xs=0 & xwba & BD & XINB { build XINB; }
:xin "0", BD, MPYB is op3=1 & subop=7 & xsub=1 & xs=0 & xwba=0 & BD & MPYB { build MPYB; }
:fill BD, FILLB is op3=1 & subop=7 & xsub=1 & xs=0 & xwba=254 & BD & FILLB { build FILLB; }
:zero BD, ZEROB is op3=1 & subop=7 & xsub=1 & xs=0 & xwba=255 & BD & ZEROB { build ZEROB; }
@endif
@ifdef PRU_XFR
:xout xwba, BD, XOUTB is op3=1 & subop=7 & xsub=2 & xs=0 & xwba & BD & XOUTB { build XOUTB; }
@endif
@ifdef PRU_XFR
:xchg xwba, BD, XCHGB is op3=1 & subop=7 & xsub=3 & xs=0 & xwba & BD & XCHGB { build XCHGB; }
@endif
@ifdef PRU_SXFR
:sxin xwba, BD, SXINB is op3=1 & subop=7 & xsub=1 & xs=1 & xwba & BD & SXINB { build SXINB; }
@endif
@ifdef PRU_SXFR
:sxout xwba, BD, SXOUTB is op3=1 & subop=7 & xsub=2 & xs=1 & xwba & BD & SXOUTB { build SXOUTB; }
@endif
@ifdef PRU_SXFR
:sxchg xwba, BD, SXCHGB is op3=1 & subop=7 & xsub=3 & xs=1 & xwba & BD & SXCHGB { build SXCHGB; }
@endif
@ifdef PRU_LOOP
LCNT: imm is io=1 & imm8 [ imm = imm8 + 1; ] { export *[const]:2 imm; }
LCNT: S2 is io=0 & S2 { local c:2 = S2:2; export c; }
LEND: dest is loopoff [ dest = inst_start + (loopoff << 2); ] { export *[code]:4 dest; }
LLAST: dest is loopoff [ dest = inst_start + ((loopoff - 1) << 2); ] { export *[code]:4 dest; }

:loop LEND, LCNT is op3=1 & subop=8 & loopi=0 & loopoff>1 & LEND & LLAST & LCNT [ loopend=1; looptop=(inst_start >> 2) + 1; globalset(LLAST, loopend); globalset(LLAST, looptop); ] { LOOP_CNT = LCNT; LOOP_TOP = inst_next >> 2; LOOP_END = &LEND >> 2; if (LOOP_CNT == 0) goto LEND; }
:loop LEND, LCNT is op3=1 & subop=8 & loopi=0 & loopoff<2 & LEND & LCNT { LOOP_CNT = LCNT; LOOP_TOP = inst_next >> 2; LOOP_END = &LEND >> 2; if (LOOP_CNT == 0) goto LEND; }
:iloop LEND, LCNT is op3=1 & subop=8 & loopi=1 & loopoff>1 & LEND & LLAST & LCNT [ loopend=1; looptop=(inst_start >> 2) + 1; globalset(LLAST, loopend); globalset(LLAST, looptop); ] { LOOP_CNT = LCNT; LOOP_TOP = inst_next >> 2; LOOP_END = &LEND >> 2; if (LOOP_CNT == 0) goto LEND; }
:iloop LEND, LCNT is op3=1 & subop=8 & loopi=1 & loopoff<2 & LEND & LCNT { LOOP_CNT = LCNT; LOOP_TOP = inst_next >> 2; LOOP_END = &LEND >> 2; if (LOOP_CNT == 0) goto LEND; }
@endif

@ifdef PRU_MVI
PD: rd_b0 is rdsel=0 & rd=1 & rd_b0 { export rd_b0; }
PS: rs1_b0 is rs1sel=0 & rs1=1 & rs1_b0 { export rs1_b0; }
PD: rd_b1 is rdsel=1 & rd=1 & rd_b1 { export rd_b1; }
PS: rs1_b1 is rs1sel=1 & rs1=1 & rs1_b1 { export rs1_b1; }
PD: rd_b2 is rdsel=2 & rd=1 & rd_b2 { export rd_b2; }
PS: rs1_b2 is rs1sel=2 & rs1=1 & rs1_b2 { export rs1_b2; }
PD: rd_b3 is rdsel=3 & rd=1 & rd_b3 { export rd_b3; }
PS: rs1_b3 is rs1sel=3 & rs1=1 & rs1_b3 { export rs1_b3; }
MS1: S1     is mvisrc=0 & S1 { local v:1 = S1:1; export v; }
MS1: "*"^PS     is mvisrc=1 & PS { local pp:4 = zext(PS); local v:1 = *[register]:1 pp; export v; }
MS1: "*"^PS^"++" is mvisrc=2 & PS { local pp:4 = zext(PS); local v:1 = *[register]:1 pp; PS = PS + 1; export v; }
MS1: "*--"^PS   is mvisrc=3 & PS { PS = PS - 1; local pp:4 = zext(PS); local v:1 = *[register]:1 pp; export v; }
:mvib D1, MS1 is op3=1 & subop=6 & mvires=0 & mvisz=0 & mvidst=0 & mvisrc!=0 & rdsel<4 & D1 & MS1 { D1 = MS1; }
:mvib D2, MS1 is op3=1 & subop=6 & mvires=0 & mvisz=0 & mvidst=0 & mvisrc!=0 & rdsel>3 & rdsel<7 & D2 & MS1 { D2 = zext(MS1); }
:mvib D4, MS1 is op3=1 & subop=6 & mvires=0 & mvisz=0 & mvidst=0 & mvisrc!=0 & rdsel=7 & D4 & MS1 { D4 = zext(MS1); }
:mvib "*"^PD, MS1 is op3=1 & subop=6 & mvires=0 & mvisz=0 & mvidst=1 & PD & MS1 { local v:1 = MS1; local pp:4 = zext(PD); *[register]:1 pp = v; }
:mvib "*"^PD^"++", MS1 is op3=1 & subop=6 & mvires=0 & mvisz=0 & mvidst=2 & PD & MS1 { local v:1 = MS1; local pp:4 = zext(PD); *[register]:1 pp = v; PD = PD + 1; }
:mvib "*--"^PD, MS1 is op3=1 & subop=6 & mvires=0 & mvisz=0 & mvidst=3 & PD & MS1 { local v:1 = MS1; PD = PD - 1; local pp:4 = zext(PD); *[register]:1 pp = v; }
MS2: S1     is mvisrc=0 & S1 { local v:2 = S1:2; export v; }
MS2: "*"^PS     is mvisrc=1 & PS { local pp:4 = zext(PS); local v:2 = *[register]:2 pp; export v; }
MS2: "*"^PS^"++" is mvisrc=2 & PS { local pp:4 = zext(PS); local v:2 = *[register]:2 pp; PS = PS + 2; export v; }
MS2: "*--"^PS   is mvisrc=3 & PS { PS = PS - 2; local pp:4 = zext(PS); local v:2 = *[register]:2 pp; export v; }
:mviw D1, MS2 is op3=1 & subop=6 & mvires=0 & mvisz=1 & mvidst=0 & mvisrc!=0 & rdsel<4 & D1 & MS2 { D1 = MS2:1; }
:mviw D2, MS2 is op3=1 & subop=6 & mvires=0 & mvisz=1 & mvidst=0 & mvisrc!=0 & rdsel>3 & rdsel<7 & D2 & MS2 { D2 = MS2; }
:mviw D4, MS2 is op3=1 & subop=6 & mvires=0 & mvisz=1 & mvidst=0 & mvisrc!=0 & rdsel=7 & D4 & MS2 { D4 = zext(MS2); }
:mviw "*"^PD, MS2 is op3=1 & subop=6 & mvires=0 & mvisz=1 & mvidst=1 & PD & MS2 { local v:2 = MS2; local pp:4 = zext(PD); *[register]:2 pp = v; }
:mviw "*"^PD^"++", MS2 is op3=1 & subop=6 & mvires=0 & mvisz=1 & mvidst=2 & PD & MS2 { local v:2 = MS2; local pp:4 = zext(PD); *[register]:2 pp = v; PD = PD + 2; }
:mviw "*--"^PD, MS2 is op3=1 & subop=6 & mvires=0 & mvisz=1 & mvidst=3 & PD & MS2 { local v:2 = MS2; PD = PD - 2; local pp:4 = zext(PD); *[register]:2 pp = v; }
MS4: S1     is mvisrc=0 & S1 { local v:4 = S1; export v; }
MS4: "*"^PS     is mvisrc=1 & PS { local pp:4 = zext(PS); local v:4 = *[register]:4 pp; export v; }
MS4: "*"^PS^"++" is mvisrc=2 & PS { local pp:4 = zext(PS); local v:4 = *[register]:4 pp; PS = PS + 4; export v; }
MS4: "*--"^PS   is mvisrc=3 & PS { PS = PS - 4; local pp:4 = zext(PS); local v:4 = *[register]:4 pp; export v; }
:mvid D1, MS4 is op3=1 & subop=6 & mvires=0 & mvisz=2 & mvidst=0 & mvisrc!=0 & rdsel<4 & D1 & MS4 { D1 = MS4:1; }
:mvid D2, MS4 is op3=1 & subop=6 & mvires=0 & mvisz=2 & mvidst=0 & mvisrc!=0 & rdsel>3 & rdsel<7 & D2 & MS4 { D2 = MS4:2; }
:mvid D4, MS4 is op3=1 & subop=6 & mvires=0 & mvisz=2 & mvidst=0 & mvisrc!=0 & rdsel=7 & D4 & MS4 { D4 = MS4; }
:mvid "*"^PD, MS4 is op3=1 & subop=6 & mvires=0 & mvisz=2 & mvidst=1 & PD & MS4 { local v:4 = MS4; local pp:4 = zext(PD); *[register]:4 pp = v; }
:mvid "*"^PD^"++", MS4 is op3=1 & subop=6 & mvires=0 & mvisz=2 & mvidst=2 & PD & MS4 { local v:4 = MS4; local pp:4 = zext(PD); *[register]:4 pp = v; PD = PD + 4; }
:mvid "*--"^PD, MS4 is op3=1 & subop=6 & mvires=0 & mvisz=2 & mvidst=3 & PD & MS4 { local v:4 = MS4; PD = PD - 4; local pp:4 = zext(PD); *[register]:4 pp = v; }
@endif

# ---- Format 4: QBxx (branch if OP(255) <cond> REG1)
:qbgt BRT, S1, OP2 is op2b=1 & cmp=4 & BRT & S1 & OP2 { if (OP2 > S1) goto BRT; }
:qbge BRT, S1, OP2 is op2b=1 & cmp=6 & BRT & S1 & OP2 { if (OP2 >= S1) goto BRT; }
:qblt BRT, S1, OP2 is op2b=1 & cmp=1 & BRT & S1 & OP2 { if (OP2 < S1) goto BRT; }
:qble BRT, S1, OP2 is op2b=1 & cmp=3 & BRT & S1 & OP2 { if (OP2 <= S1) goto BRT; }
:qbeq BRT, S1, OP2 is op2b=1 & cmp=2 & BRT & S1 & OP2 { if (OP2 == S1) goto BRT; }
:qbne BRT, S1, OP2 is op2b=1 & cmp=5 & BRT & S1 & OP2 { if (OP2 != S1) goto BRT; }
:qba BRT is op2b=1 & cmp=7 & BRT { goto BRT; }

# ---- Format 5: QBBS / QBBC (+ WBS / WBC pseudo ops)
:qbbs BRT, S1, OP2 is op3=6 & bsbc=2 & BRT & S1 & OP2 { if (((S1 >> (OP2 & 0x1f)) & 1) != 0) goto BRT; }
:qbbc BRT, S1, OP2 is op3=6 & bsbc=1 & BRT & S1 & OP2 { if (((S1 >> (OP2 & 0x1f)) & 1) == 0) goto BRT; }
:wbc S1, OP2 is op3=6 & bsbc=2 & brhi=0 & brlo=0 & S1 & OP2 { if (((S1 >> (OP2 & 0x1f)) & 1) != 0) goto inst_start; }
:wbs S1, OP2 is op3=6 & bsbc=1 & brhi=0 & brlo=0 & S1 & OP2 { if (((S1 >> (OP2 & 0x1f)) & 1) == 0) goto inst_start; }

# ---- Format 6: LBBO/SBBO (register base) and LBCO/SBCO (constant table base)
:lbbo BD, RB, OP2, LDB is op3=7 & ls=1 & BD & RB & OP2 & LDB { build LDB; }
:sbbo BD, RB, OP2, STB is op3=7 & ls=0 & BD & RB & OP2 & STB { build STB; }
:lbco BD, cbr, OP2, LDB is op3=4 & ls=1 & BD & cbr & OP2 & LDB { build LDB; }
:sbco BD, cbr, OP2, STB is op3=4 & ls=0 & BD & cbr & OP2 & STB { build STB; }

} # with phase=1

