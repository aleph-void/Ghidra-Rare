# TI PRU / PRU-ICSS  -- generated by tools/gen_pru_sinc.py, do not edit by hand.
#
# Harvard machine: instruction memory ('code', 32-bit instruction words,
# 16-bit word PC) and data memory ('data', byte addressed, 32-bit).  The register
# file R0..R31 lives in the register space at byte offset 4*n so that the
# PRU's "register address" (&r2.b1 == 9) is the register-space offset; MVIx
# and the burst/XFR instructions use that to address the register file.
#
# Code addresses: the hardware PC counts 32-bit instruction words (16 bits,
# 64K words).  Ghidra's 'code' space is byte addressed (like the TI and GNU ELF
# files, objdump and dispru), so every instruction is 4-byte aligned and code
# address = 4 * hardware PC.  Values the program keeps in registers (the JAL
# link in ra.w2, LOOP_TOP/LOOP_END, register jump targets) are hardware word
# addresses: they are converted with "<< 2" / ">> 2" in the p-code.  PC is the
# Ghidra program counter (byte address).
#
# Feature switches (defined by the per-core-revision .slaspec files):
#   PRU_LMBD  LMBD                        (core rev >= V1)
#   PRU_XFR   XIN/XOUT/XCHG (+ZERO/FILL)  (>= V2)
#   PRU_MVI   MVIB/MVIW/MVID              (>= V2)
#   PRU_SXFR  SXIN/SXOUT/SXCHG            (>= V3)
#   PRU_LOOP  LOOP/ILOOP                  (>= V3)

define endian=little;
define alignment=4;

define space code     type=ram_space      size=3 wordsize=1 default;
define space data     type=ram_space      size=4 wordsize=1;
define space register type=register_space size=4;

define register offset=0 size=4 [ r0 r1 sp ra fp r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];
define register offset=0 size=1 [ r0.b0 r0.b1 r0.b2 r0.b3 r1.b0 r1.b1 r1.b2 r1.b3 sp.b0 sp.b1 sp.b2 sp.b3 ra.b0 ra.b1 ra.b2 ra.b3 fp.b0 fp.b1 fp.b2 fp.b3 r5.b0 r5.b1 r5.b2 r5.b3 r6.b0 r6.b1 r6.b2 r6.b3 r7.b0 r7.b1 r7.b2 r7.b3 r8.b0 r8.b1 r8.b2 r8.b3 r9.b0 r9.b1 r9.b2 r9.b3 r10.b0 r10.b1 r10.b2 r10.b3 r11.b0 r11.b1 r11.b2 r11.b3 r12.b0 r12.b1 r12.b2 r12.b3 r13.b0 r13.b1 r13.b2 r13.b3 r14.b0 r14.b1 r14.b2 r14.b3 r15.b0 r15.b1 r15.b2 r15.b3 r16.b0 r16.b1 r16.b2 r16.b3 r17.b0 r17.b1 r17.b2 r17.b3 r18.b0 r18.b1 r18.b2 r18.b3 r19.b0 r19.b1 r19.b2 r19.b3 r20.b0 r20.b1 r20.b2 r20.b3 r21.b0 r21.b1 r21.b2 r21.b3 r22.b0 r22.b1 r22.b2 r22.b3 r23.b0 r23.b1 r23.b2 r23.b3 r24.b0 r24.b1 r24.b2 r24.b3 r25.b0 r25.b1 r25.b2 r25.b3 r26.b0 r26.b1 r26.b2 r26.b3 r27.b0 r27.b1 r27.b2 r27.b3 r28.b0 r28.b1 r28.b2 r28.b3 r29.b0 r29.b1 r29.b2 r29.b3 r30.b0 r30.b1 r30.b2 r30.b3 r31.b0 r31.b1 r31.b2 r31.b3 ];
define register offset=0 size=2 [ r0.w0 r0.w2 r1.w0 r1.w2 sp.w0 sp.w2 ra.w0 ra.w2 fp.w0 fp.w2 r5.w0 r5.w2 r6.w0 r6.w2 r7.w0 r7.w2 r8.w0 r8.w2 r9.w0 r9.w2 r10.w0 r10.w2 r11.w0 r11.w2 r12.w0 r12.w2 r13.w0 r13.w2 r14.w0 r14.w2 r15.w0 r15.w2 r16.w0 r16.w2 r17.w0 r17.w2 r18.w0 r18.w2 r19.w0 r19.w2 r20.w0 r20.w2 r21.w0 r21.w2 r22.w0 r22.w2 r23.w0 r23.w2 r24.w0 r24.w2 r25.w0 r25.w2 r26.w0 r26.w2 r27.w0 r27.w2 r28.w0 r28.w2 r29.w0 r29.w2 r30.w0 r30.w2 r31.w0 r31.w2 ];
define register offset=1 size=2 [ r0.w1 _ r1.w1 _ sp.w1 _ ra.w1 _ fp.w1 _ r5.w1 _ r6.w1 _ r7.w1 _ r8.w1 _ r9.w1 _ r10.w1 _ r11.w1 _ r12.w1 _ r13.w1 _ r14.w1 _ r15.w1 _ r16.w1 _ r17.w1 _ r18.w1 _ r19.w1 _ r20.w1 _ r21.w1 _ r22.w1 _ r23.w1 _ r24.w1 _ r25.w1 _ r26.w1 _ r27.w1 _ r28.w1 _ r29.w1 _ r30.w1 _ r31.w1 _ ];

# Constant table entries C0..C31 (LBCO/SBCO base addresses).  Most entries
# are fixed by the device, C24..C31 are partly programmable (CTBIR/CTPPR).
# Set their values with Set Register Value or ghidra_scripts/PRUSetConstantTable.py.
define register offset=0x100 size=4 [ c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31 ];

define register offset=0x200 size=4 [ PC ];
define register offset=0x204 size=1 [ CARRY ];
# hardware loop state (LOOP/ILOOP)
define register offset=0x208 size=2 [ LOOP_CNT LOOP_TOP LOOP_END ];
define register offset=0x300 size=4 contextreg;

define context contextreg
  phase    = (0,0)
  loopend  = (1,1) noflow      # this instruction is the last one of a LOOP body
  looptop  = (2,17) noflow     # word address (byte/4) of the first instruction of the body
;

define token instr(32)
  op3     = (29,31)
  op2b    = (30,31)
  subop   = (25,28)
  io      = (24,24)
  rs2sel  = (21,23)
  rs2     = (16,20)
  imm8    = (16,23) dec
  imm16   = (8,23) dec
  rs1sel  = (13,15)
  rs1     = (8,12)
  rdsel   = (5,7)
  rd      = (0,4)
  rdb     = (5,6)
  cmp     = (27,29)
  brhi    = (25,26) signed
  brlo    = (0,7)
  bsbc    = (27,28)
  ls      = (28,28)
  bl64    = (25,27)
  bl31    = (13,15)
  bl0     = (7,7)
  cb      = (8,12)
  wake    = (23,23) dec
  xsub    = (23,24)
  xwba    = (15,22) dec
  xs      = (14,14)
  xlen    = (7,13)
  xlen_hi = (9,13)
  xlen_lo = (7,8)
  loopi   = (15,15)
  loopoff = (0,7)
  mvisz   = (16,17)
  mvires  = (18,20)
  mvisrc  = (21,22)
  mvidst  = (23,24)
  rd_b0 = (0,4)
  rd_b1 = (0,4)
  rd_b2 = (0,4)
  rd_b3 = (0,4)
  rd_w0 = (0,4)
  rd_w1 = (0,4)
  rd_w2 = (0,4)
  rd_d = (0,4)
  rs1_b0 = (8,12)
  rs1_b1 = (8,12)
  rs1_b2 = (8,12)
  rs1_b3 = (8,12)
  rs1_w0 = (8,12)
  rs1_w1 = (8,12)
  rs1_w2 = (8,12)
  rs1_d = (8,12)
  rs2_b0 = (16,20)
  rs2_b1 = (16,20)
  rs2_b2 = (16,20)
  rs2_b3 = (16,20)
  rs2_w0 = (16,20)
  rs2_w1 = (16,20)
  rs2_w2 = (16,20)
  rs2_d = (16,20)
  cbr     = (8,12)
;

attach variables [ rd_b0 rs1_b0 rs2_b0 ] [ r0.b0 r1.b0 sp.b0 ra.b0 fp.b0 r5.b0 r6.b0 r7.b0 r8.b0 r9.b0 r10.b0 r11.b0 r12.b0 r13.b0 r14.b0 r15.b0 r16.b0 r17.b0 r18.b0 r19.b0 r20.b0 r21.b0 r22.b0 r23.b0 r24.b0 r25.b0 r26.b0 r27.b0 r28.b0 r29.b0 r30.b0 r31.b0 ];
attach variables [ rd_b1 rs1_b1 rs2_b1 ] [ r0.b1 r1.b1 sp.b1 ra.b1 fp.b1 r5.b1 r6.b1 r7.b1 r8.b1 r9.b1 r10.b1 r11.b1 r12.b1 r13.b1 r14.b1 r15.b1 r16.b1 r17.b1 r18.b1 r19.b1 r20.b1 r21.b1 r22.b1 r23.b1 r24.b1 r25.b1 r26.b1 r27.b1 r28.b1 r29.b1 r30.b1 r31.b1 ];
attach variables [ rd_b2 rs1_b2 rs2_b2 ] [ r0.b2 r1.b2 sp.b2 ra.b2 fp.b2 r5.b2 r6.b2 r7.b2 r8.b2 r9.b2 r10.b2 r11.b2 r12.b2 r13.b2 r14.b2 r15.b2 r16.b2 r17.b2 r18.b2 r19.b2 r20.b2 r21.b2 r22.b2 r23.b2 r24.b2 r25.b2 r26.b2 r27.b2 r28.b2 r29.b2 r30.b2 r31.b2 ];
attach variables [ rd_b3 rs1_b3 rs2_b3 ] [ r0.b3 r1.b3 sp.b3 ra.b3 fp.b3 r5.b3 r6.b3 r7.b3 r8.b3 r9.b3 r10.b3 r11.b3 r12.b3 r13.b3 r14.b3 r15.b3 r16.b3 r17.b3 r18.b3 r19.b3 r20.b3 r21.b3 r22.b3 r23.b3 r24.b3 r25.b3 r26.b3 r27.b3 r28.b3 r29.b3 r30.b3 r31.b3 ];
attach variables [ rd_w0 rs1_w0 rs2_w0 ] [ r0.w0 r1.w0 sp.w0 ra.w0 fp.w0 r5.w0 r6.w0 r7.w0 r8.w0 r9.w0 r10.w0 r11.w0 r12.w0 r13.w0 r14.w0 r15.w0 r16.w0 r17.w0 r18.w0 r19.w0 r20.w0 r21.w0 r22.w0 r23.w0 r24.w0 r25.w0 r26.w0 r27.w0 r28.w0 r29.w0 r30.w0 r31.w0 ];
attach variables [ rd_w1 rs1_w1 rs2_w1 ] [ r0.w1 r1.w1 sp.w1 ra.w1 fp.w1 r5.w1 r6.w1 r7.w1 r8.w1 r9.w1 r10.w1 r11.w1 r12.w1 r13.w1 r14.w1 r15.w1 r16.w1 r17.w1 r18.w1 r19.w1 r20.w1 r21.w1 r22.w1 r23.w1 r24.w1 r25.w1 r26.w1 r27.w1 r28.w1 r29.w1 r30.w1 r31.w1 ];
attach variables [ rd_w2 rs1_w2 rs2_w2 ] [ r0.w2 r1.w2 sp.w2 ra.w2 fp.w2 r5.w2 r6.w2 r7.w2 r8.w2 r9.w2 r10.w2 r11.w2 r12.w2 r13.w2 r14.w2 r15.w2 r16.w2 r17.w2 r18.w2 r19.w2 r20.w2 r21.w2 r22.w2 r23.w2 r24.w2 r25.w2 r26.w2 r27.w2 r28.w2 r29.w2 r30.w2 r31.w2 ];
attach variables [ rd_d rs1_d rs2_d ] [ r0 r1 sp ra fp r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];
attach variables [ cbr ] [ c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31 ];

define pcodeop halt;
define pcodeop sleep;
define pcodeop xin;        # xin(device_id, byte_index) -> data from XFR bus
define pcodeop xout;       # xout(device_id, byte_index, data)
define pcodeop xchg;       # xchg(device_id, byte_index, data) -> data
define pcodeop sxin;
define pcodeop sxout;
define pcodeop sxchg;
define pcodeop mpy_xin;    # XIN from device 0 (MPY/MAC unit): mpy_xin(byte_index, r25 mode/status, r28, r29)

D1: rd_b0 is rdsel=0 & rd_b0 { export rd_b0; }
D1: rd_b1 is rdsel=1 & rd_b1 { export rd_b1; }
D1: rd_b2 is rdsel=2 & rd_b2 { export rd_b2; }
D1: rd_b3 is rdsel=3 & rd_b3 { export rd_b3; }
D2: rd_w0 is rdsel=4 & rd_w0 { export rd_w0; }
D2: rd_w1 is rdsel=5 & rd_w1 { export rd_w1; }
D2: rd_w2 is rdsel=6 & rd_w2 { export rd_w2; }
D4: rd_d is rdsel=7 & rd_d { export rd_d; }
S1: rs1_b0 is rs1sel=0 & rs1_b0 { local t:4 = zext(rs1_b0); export t; }
S1: rs1_b1 is rs1sel=1 & rs1_b1 { local t:4 = zext(rs1_b1); export t; }
S1: rs1_b2 is rs1sel=2 & rs1_b2 { local t:4 = zext(rs1_b2); export t; }
S1: rs1_b3 is rs1sel=3 & rs1_b3 { local t:4 = zext(rs1_b3); export t; }
S1: rs1_w0 is rs1sel=4 & rs1_w0 { local t:4 = zext(rs1_w0); export t; }
S1: rs1_w1 is rs1sel=5 & rs1_w1 { local t:4 = zext(rs1_w1); export t; }
S1: rs1_w2 is rs1sel=6 & rs1_w2 { local t:4 = zext(rs1_w2); export t; }
S1: rs1_d is rs1sel=7 & rs1_d { export rs1_d; }
S2: rs2_b0 is rs2sel=0 & rs2_b0 { local t:4 = zext(rs2_b0); export t; }
S2: rs2_b1 is rs2sel=1 & rs2_b1 { local t:4 = zext(rs2_b1); export t; }
S2: rs2_b2 is rs2sel=2 & rs2_b2 { local t:4 = zext(rs2_b2); export t; }
S2: rs2_b3 is rs2sel=3 & rs2_b3 { local t:4 = zext(rs2_b3); export t; }
S2: rs2_w0 is rs2sel=4 & rs2_w0 { local t:4 = zext(rs2_w0); export t; }
S2: rs2_w1 is rs2sel=5 & rs2_w1 { local t:4 = zext(rs2_w1); export t; }
S2: rs2_w2 is rs2sel=6 & rs2_w2 { local t:4 = zext(rs2_w2); export t; }
S2: rs2_d is rs2sel=7 & rs2_d { export rs2_d; }
N1: rs1_b0 is rs1sel=0 & rs1_b0 { export rs1_b0; }
N1: rs1_b1 is rs1sel=1 & rs1_b1 { export rs1_b1; }
N1: rs1_b2 is rs1sel=2 & rs1_b2 { export rs1_b2; }
N1: rs1_b3 is rs1sel=3 & rs1_b3 { export rs1_b3; }
N2: rs1_w0 is rs1sel=4 & rs1_w0 { export rs1_w0; }
N2: rs1_w1 is rs1sel=5 & rs1_w1 { export rs1_w1; }
N2: rs1_w2 is rs1sel=6 & rs1_w2 { export rs1_w2; }
N4: rs1_d is rs1sel=7 & rs1_d { export rs1_d; }

OP2: S2    is io=0 & S2    { export S2; }
OP2: imm8  is io=1 & imm8  { export *[const]:4 imm8; }

# full 32-bit rs1 (LBBO/SBBO base register)
RB: rs1_d is rs1_d { export rs1_d; }
# byte register selected by rd + rdb (burst / XFR register-file start)

BD: rd_b0 is rdb=0 & rd_b0 { export rd_b0; }
BD: rd_b1 is rdb=1 & rd_b1 { export rd_b1; }
BD: rd_b2 is rdb=2 & rd_b2 { export rd_b2; }
BD: rd_b3 is rdb=3 & rd_b3 { export rd_b3; }

# effective data address of a burst load/store
EA: is op3=7 & RB & OP2 { local a:4 = RB + OP2; export a; }
EA: is op3=4 & cbr & OP2 { local a:4 = cbr + OP2; export a; }

# code addresses (word addressed)
BRT: dest is brhi & brlo [ dest = inst_start + (((brhi << 8) | brlo) << 2); ] { export *[code]:4 dest; }
JT:  dest is io=1 & imm16 [ dest = imm16 << 2; ] { export *[code]:4 dest; }

RF0_1: o is rd & rdb [ o = (rd << 2) + rdb + 0; ] { export *[register]:1 o; }
RF0_2: o is rd & rdb [ o = (rd << 2) + rdb + 0; ] { export *[register]:2 o; }
RF0_4: o is rd & rdb [ o = (rd << 2) + rdb + 0; ] { export *[register]:4 o; }
