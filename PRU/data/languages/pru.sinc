XOUTB: "r0.b0" is xlen=124 & rd & rdb & xwba {
  local i:1 = 0;
  <top>
  if (i >= r0.b0) goto <done>;
  local p:4 = (rd << 2) + rdb + zext(i);
  xout(xwba:1, i, *[register]:1 p);
  i = i + 1;
  goto <top>;
  <done>
}
