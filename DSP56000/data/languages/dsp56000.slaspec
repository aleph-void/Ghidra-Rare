# Motorola DSP56000 / DSP56001 (24-bit DSP56K core), with the DSP56002 additions.
#
# Written from the Motorola DSP56000 Family Manual (DSP56KFAMUM/AD, 1992 and 1995 editions):
# instruction pages of Appendix A and the encoding summary in A.10. Instruction tables are
# generated by tools/gen_dsp56000.py into dsp56000_gen.sinc; this file holds the memory model,
# registers and the shared semantic macros.
#
# Memory: P (program), X and Y (data) are separate 64K x 24-bit spaces (one 4-byte big-endian
# unit per word, high byte zero). The system stack is the 15-entry SSH:SSL hardware stack, modelled as
# the 'ss' space indexed by SP (one 32-bit SSH:SSL unit per level).

define endian=big;
define alignment=4;

# 24-bit words are held in 4-byte units (high byte zero), the layout MAME and Motorola's COFF
# tools use: the decompiler does not handle pointer arithmetic in a space whose word size is
# not a power of two (a load through an incremented pointer in a loop never finishes).
define space p        type=ram_space      size=2 wordsize=4 default;
define space x        type=ram_space      size=2 wordsize=4;
define space y        type=ram_space      size=2 wordsize=4;
define space ss       type=ram_space      size=1 wordsize=4;
define space register type=register_space size=2;

# 56-bit accumulators A = A2:A1:A0 and B = B2:B1:B0 (A10 = A1:A0)
define register offset=0x00 size=7 [ A ];
define register offset=0x00 size=1 [ A2 ];
define register offset=0x01 size=6 [ A10 ];
define register offset=0x01 size=3 [ A1 ];
define register offset=0x04 size=3 [ A0 ];
define register offset=0x08 size=7 [ B ];
define register offset=0x08 size=1 [ B2 ];
define register offset=0x09 size=6 [ B10 ];
define register offset=0x09 size=3 [ B1 ];
define register offset=0x0c size=3 [ B0 ];
# 48-bit input registers X = X1:X0, Y = Y1:Y0
define register offset=0x10 size=6 [ X ];
define register offset=0x10 size=3 [ X1 X0 ];
define register offset=0x18 size=6 [ Y ];
define register offset=0x18 size=3 [ Y1 Y0 ];
# address generation unit
define register offset=0x20 size=2 [ R0 R1 R2 R3 R4 R5 R6 R7 ];
define register offset=0x30 size=2 [ N0 N1 N2 N3 N4 N5 N6 N7 ];
define register offset=0x40 size=2 [ M0 M1 M2 M3 M4 M5 M6 M7 ];
# program control unit. SR = MR:CCR; the CCR bits are kept as separate flag registers and
# SR/CCR reads and writes rebuild or reload them (getSR/setSR).
define register offset=0x50 size=2 [ PC LA LC ];
define register offset=0x56 size=1 [ SP MR ];
define register offset=0x58 size=3 [ OMR ];
define register offset=0x60 size=1 [ C V Z N U E L S ];
# scratch registers that carry a parallel move's addresses and data between the read phase
# (before the data ALU operation) and the write phase (after it); and REP's saved LC
define register offset=0x70 size=2 [ EAX EAY LCSV ];
define register offset=0x78 size=3 [ MVX ];
define register offset=0x7c size=3 [ MVY ];

# Disassembly context, set by DO for the end of its loop (REP repeats its delay-slot
# instruction and needs no context):
#   lend   - this instruction may be the last of a DO loop whose LA is laddr, body at lstart
define register offset=0x100 size=8 [ contextreg ];
define context contextreg
	lend=(1,1) noflow
	laddr=(2,17) noflow
	lstart=(18,33) noflow
;

define token ins(32)
	w24=(0,23)
	hb=(16,23)
	b23=(23,23) b22=(22,22) b21=(21,21) b20=(20,20) b19=(19,19) b18=(18,18) b17=(17,17) b16=(16,16)
	b15=(15,15) b14=(14,14) b13=(13,13) b12=(12,12) b11=(11,11) b10=(10,10) b9=(9,9) b8=(8,8)
	b7=(7,7) b6=(6,6) b5=(5,5) b4=(4,4) b3=(3,3) b2=(2,2) b1=(1,1) b0=(0,0)
	f23_22=(22,23) f23_21=(21,23) f23_20=(20,23) f23_19=(19,23) f23_18=(18,23) f23_17=(17,23)
	f21_20=(20,21) f19_18=(18,19) f18_16=(16,18) f17_16=(16,17) f20_16=(16,20) f17_13=(13,17)
	f15_14=(14,15) f15_13=(13,15) f15_12=(12,15) f15_8=(8,15) f14_13=(13,14) f13_8=(8,13)
	f13_11=(11,13) f12_11=(11,12) f12_8=(8,12) f11_8=(8,11) f11_0=(0,11) f10_8=(8,10)
	f7_0=(0,7) f7_6=(6,7) f7_5=(5,7) f7_4=(4,7) f6_4=(4,6) f5_4=(4,5) f5_0=(0,5) f4_0=(0,4)
	f3_0=(0,3) f2_0=(0,2) f1_0=(0,1)
	f23_4=(4,23) f3_1=(1,3) f7_2=(2,7) f15_11=(11,15) f6_5=(5,6)
	imm8=(8,15) bnum=(0,4) dec bnumc=(0,4)
	nsh=(8,12) dec
	# data ALU operand fields
	aD=(3,3) aDn=(3,3) aQ1=(4,6) aQ2=(4,6) aJ24=(4,5) aJxy=(4,4)
	# register fields used with attach
	xyee=(18,19) xyff=(16,17) c1ff=(18,19) c1d=(17,17) c1f=(16,16) c1yd=(19,19) c1ye=(18,18)
	c1yff=(16,17) c2d=(16,16) c2e=(16,16) divJ=(4,5) macQ=(4,5) tJ=(4,6) dD=(3,3) d0=(0,0)
	rn8=(8,10) nn8=(8,10) mn8=(8,10) rn0=(0,2)
;

define token ext(32)
	e24=(0,23)
	e16=(0,15)
;

attach variables [ aD dD d0 ] [ A B ];
attach variables [ aDn ] [ B A ];
attach variables [ aQ1 ] [ X0 Y0 X1 Y1 X0 Y0 X1 Y1 ];
attach variables [ aQ2 ] [ X0 Y0 X0 Y0 Y1 X0 Y0 X1 ];
attach variables [ aJ24 divJ ] [ X0 Y0 X1 Y1 ];
attach variables [ aJxy ] [ X Y ];
attach variables [ macQ ] [ Y1 X0 Y0 X1 ];
attach variables [ c1d c1yd c2d c2e ] [ A B ];
attach variables [ c1f ] [ Y0 Y1 ];
attach variables [ c1ye ] [ X0 X1 ];
attach variables [ rn8 rn0 ] [ R0 R1 R2 R3 R4 R5 R6 R7 ];
attach variables [ nn8 ] [ N0 N1 N2 N3 N4 N5 N6 N7 ];
attach variables [ mn8 ] [ M0 M1 M2 M3 M4 M5 M6 M7 ];

define pcodeop illegal;
define pcodeop softwareInterrupt;
define pcodeop resetPeripherals;
define pcodeop waitForInterrupt;
define pcodeop stopProcessing;
define pcodeop debugMode;

################################################################ status register

macro getCCR(out) {
	out = (zext(S) << 7) | (zext(L) << 6) | (zext(E) << 5) | (zext(U) << 4) | (zext(N) << 3)
		| (zext(Z) << 2) | (zext(V) << 1) | zext(C);
}

macro setCCR(v) {
	C = (v & 1) != 0;
	V = (v & 2) != 0;
	Z = (v & 4) != 0;
	N = (v & 8) != 0;
	U = (v & 0x10) != 0;
	E = (v & 0x20) != 0;
	L = (v & 0x40) != 0;
	S = (v & 0x80) != 0;
}

macro getSR(out) {
	local ccr:1;
	getCCR(ccr);
	out = (zext(MR) << 8) | zext(ccr);
}

macro setSR(v) {
	MR = v(1);
	local ccr:1 = v:1;
	setCCR(ccr);
}

################################################################ system stack

macro sspush(hi, lo) {
	SP = SP + 1;
	*[ss]:4 SP = (zext(hi) << 16) | zext(lo);
}

################################################################ address generation unit
# new = Rn + off (off = +1, -1, +Nn or -Nn; neg = 1 for the minus forms, then mag = -off),
# under the modifier Mn (Family Manual 4.4.2, Table 4-2):
#   0FFFFh           linear
#   0                reverse carry (bit-reversed addition)
#   0001h-7FFFh      modulo Mn+1 inside the 2^k block that holds Rn; an offset that is a
#                    multiple of the block size moves to the same place in another block
#   8000h|(2^k-1)    multiple wrap-around modulo 2^k (DSP56002): the low k bits wrap
#   other 8xxxh      reserved, treated as linear
# |off| greater than the modulus, other than a block-size multiple, is unpredictable on the
# chip; the p-code wraps once. The decompiler assumes linear addressing at function entry
# (Mn = 0FFFFh, see the cspec), which folds the other forms away.

macro bitrev16(v, out) {
	local t:2 = v;
	t = ((t >> 1) & 0x5555) | ((t & 0x5555) << 1);
	t = ((t >> 2) & 0x3333) | ((t & 0x3333) << 2);
	t = ((t >> 4) & 0x0f0f) | ((t & 0x0f0f) << 4);
	out = (t >> 8) | (t << 8);
}

macro aguAdd(r, off, neg, m, out) {
	local lin:2 = r + off;
	# modulo m+1: the buffer base clears the low bits up to the smallest 2^k - 1 >= m
	local mk:2 = m | (m >> 1);
	mk = mk | (mk >> 2);
	mk = mk | (mk >> 4);
	mk = mk | (mk >> 8);
	local base:2 = r & ~mk;
	local rel:4 = zext(r - base) + sext(off);
	local modlen:4 = zext(m) + 1;
	rel = rel - modlen * zext(rel s> zext(m)) + modlen * zext(rel s< 0);
	local blockjump:1 = (off & mk) == 0;
	local md:2 = (base + rel:2) * zext(!blockjump) + lin * zext(blockjump);
	# multiple wrap-around: modulo 2^k with k from Mn = 8000h | (2^k - 1)
	local wm:2 = m & 0x7fff;
	local mw:2 = (r & ~wm) | (lin & wm);
	# reverse carry: add (or subtract) the bit-reversed magnitude to the bit-reversed address
	local rr:2;
	bitrev16(r, rr);
	local mag:2 = off * zext(neg == 0) + (-off) * zext(neg != 0);
	local rm:2;
	bitrev16(mag, rm);
	local rs:2 = rr + rm * zext(neg == 0) - rm * zext(neg != 0);
	local rv:2;
	bitrev16(rs, rv);
	local isRev:1 = (m == 0);
	local isMod:1 = (m != 0) && (m s> 0);
	local isMw:1 = (m s< 0) && (m != 0xffff) && (wm != 0) && ((wm & (wm + 1)) == 0);
	local isLin:1 = !isRev && !isMod && !isMw;
	out = lin * zext(isLin) + rv * zext(isRev) + md * zext(isMod) + mw * zext(isMw);
}

################################################################ data ALU helpers

# scaling mode adjustment of bit positions: +1 scale down (S1:S0 = 01), -1 scale up (10)
macro scaleAdj(adj) {
	local sm:1 = (MR >> 2) & 3;
	adj = zext(sm == 1) - zext(sm == 2);
}

# E, U, N, Z for a 56-bit accumulator result
macro ccEUNZ(r) {
	local adj:1;
	scaleAdj(adj);
	local sv:8 = sext(r);
	local hi:8 = sv s>> (47 + adj);
	E = (hi != 0) && (hi != -1);
	U = ((sv >> (47 + adj)) & 1) == ((sv >> (46 + adj)) & 1);
	N = sv s< 0;
	Z = r == 0;
}

# logical-unit results on bits 47..24: N from bit 47, Z from bits 47..24, V cleared
macro ccLogic(r1) {
	N = (r1 & 0x800000) != 0;
	Z = r1 == 0;
	V = 0;
}

# data shifter/limiter: an accumulator moved onto a 24-bit data bus (scaled, saturated);
# sets the sticky L when limiting and S per the scaling-bit equations
macro busAcc(acc, out) {
	local adj:1;
	scaleAdj(adj);
	local sv:8 = sext(acc);
	local hi:8 = sv s>> (47 + adj);
	local ok:1 = (hi == 0) || (hi == -1);
	local sh:8 = sv s>> (24 + adj);
	local sat:3 = 0x7fffff + zext(sv s< 0);
	out = sh:3 * zext(ok) + sat * zext(!ok);
	L = L || !ok;
	S = S || (((sv >> (46 + adj)) & 1) != ((sv >> (45 + adj)) & 1));
}

# the same for a 48-bit long move (L:A or L:B)
macro busAcc48(acc, out) {
	local adj:1;
	scaleAdj(adj);
	local sv:8 = sext(acc);
	local hi:8 = sv s>> (47 + adj);
	local ok:1 = (hi == 0) || (hi == -1);
	# adj is -1 (0xff) when scaling up; shift by adj + 1 so the count stays in 0..2
	local sh:8 = (sv << 1) s>> (adj + 1);
	local sat:6 = 0x7fffffffffff + zext(sv s< 0);
	out = sh:6 * zext(ok) + sat * zext(!ok);
	L = L || !ok;
	S = S || (((sv >> (46 + adj)) & 1) != ((sv >> (45 + adj)) & 1));
}

# convergent rounding of a 56-bit value at the scaling-dependent position
macro roundAcc(v, out) {
	local adj:1;
	scaleAdj(adj);
	local pos:1 = 23 + adj;
	local one:7 = 1;
	local rc:7 = one << pos;
	local low:7 = (rc << 1) - 1;
	local t:7 = v + rc;
	local half:1 = (v & low) == rc;
	t = t & ~low;
	t = t & ~((rc << 1) * zext(half));
	out = t;
}

# sum with flags: out = d + s (+ cin), C/V standard, L latches V
macro addFlags(d, s, cin, out) {
	local t:7 = d + s;
	out = t + zext(cin);
	C = carry(d, s) || carry(t, zext(cin));
	V = scarry(d, s) || scarry(t, zext(cin));
	L = L || V;
}

macro subFlags(d, s, bin, out) {
	local t:7 = d - s;
	out = t - zext(bin);
	C = (d < s) || (t < zext(bin));
	V = sborrow(d, s) || sborrow(t, zext(bin));
	L = L || V;
}

# fractional multiply: 24 x 24 signed, shifted left one bit, as a 56-bit value
macro fmul(s1, s2, out) {
	local prd:7 = sext(s1) * sext(s2);
	out = prd << 1;
}

# limiting of a 24-bit write path into an accumulator: v (24 bits) -> acc = sext(v) << 24
macro accWrite24(acc, v) {
	local t:7 = sext(v);
	acc = t << 24;
}

@include "dsp56000_gen.sinc"
