# Motorola DSP56156 (DSP561xx, the 16-bit DSP56100 family core).
#
# Written from the Motorola DSP56100 Family Manual (DSP56100FM/AD, 1994: Appendix A instruction
# pages, condition codes, saturation and rounding modes) and the DSP56156 User's Manual
# (DSP56156UM/AD: memory map, interrupt vectors, peripherals). The instruction tables are
# generated by tools/gen_dsp56156.py into dsp56156_gen.sinc; this file holds the memory model,
# registers and the shared semantic macros.
#
# Memory: P (program) and X (data) are separate 64K x 16-bit spaces (wordsize 2, big-endian
# bytes inside a word in raw images). The system stack is the 15-entry SSH:SSL hardware stack,
# modelled as the 'ss' space indexed by SP (one 32-bit SSH:SSL unit per level).

define endian=big;
define alignment=2;

define space p        type=ram_space      size=2 wordsize=2 default;
define space x        type=ram_space      size=2 wordsize=2;
define space ss       type=ram_space      size=1 wordsize=4;
define space register type=register_space size=2;

# 40-bit accumulators A = A2:A1:A0 (8:16:16) and B; A10 = A1:A0
define register offset=0x00 size=5 [ A ];
define register offset=0x00 size=1 [ A2 ];
define register offset=0x01 size=4 [ A10 ];
define register offset=0x01 size=2 [ A1 ];
define register offset=0x03 size=2 [ A0 ];
define register offset=0x08 size=5 [ B ];
define register offset=0x08 size=1 [ B2 ];
define register offset=0x09 size=4 [ B10 ];
define register offset=0x09 size=2 [ B1 ];
define register offset=0x0b size=2 [ B0 ];
# 32-bit input registers X = X1:X0, Y = Y1:Y0
define register offset=0x10 size=4 [ X Y ];
define register offset=0x10 size=2 [ X1 X0 Y1 Y0 ];
# address generation unit
define register offset=0x20 size=2 [ R0 R1 R2 R3 N0 N1 N2 N3 M0 M1 M2 M3 ];
# program control unit. SR = MR:CCR with the CCR bits kept as separate flag registers.
define register offset=0x40 size=2 [ PC LA LC OMR ];
define register offset=0x48 size=1 [ SP MR ];
define register offset=0x50 size=1 [ C V Z N U E L S ];
# scratch registers carrying a parallel move between its read phase (before the data ALU
# operation) and its write phase (after it); REP's saved LC; the last AGU update result and
# modulo-wrap flag (read by CHKAAU)
define register offset=0x60 size=2 [ EAX EAY LCSV AGUR ];
define register offset=0x68 size=1 [ AGUW ];
define register offset=0x70 size=8 [ MVX MVY ];

define register offset=0x100 size=8 [ contextreg ];
# (REP and REPcc repeat their delay-slot instruction and need no context)
# lend: this instruction may be the last of a DO loop whose LA is laddr, body at lstart
define context contextreg
	lend=(1,1) noflow
	laddr=(2,17) noflow
	lstart=(18,33) noflow
;

define pcodeop illegal;
define pcodeop softwareInterrupt;
define pcodeop resetPeripherals;
define pcodeop waitForInterrupt;
define pcodeop stopProcessing;
define pcodeop debugMode;

################################################################ status register

macro getCCR(out) {
	out = (zext(S) << 7) | (zext(L) << 6) | (zext(E) << 5) | (zext(U) << 4) | (zext(N) << 3)
		| (zext(Z) << 2) | (zext(V) << 1) | zext(C);
}

macro setCCR(v) {
	C = (v & 1) != 0;
	V = (v & 2) != 0;
	Z = (v & 4) != 0;
	N = (v & 8) != 0;
	U = (v & 0x10) != 0;
	E = (v & 0x20) != 0;
	L = (v & 0x40) != 0;
	S = (v & 0x80) != 0;
}

macro getSR(out) {
	local ccr:1;
	getCCR(ccr);
	out = (zext(MR) << 8) | zext(ccr);
}

macro setSR(v) {
	MR = v(1);
	local ccr:1 = v:1;
	setCCR(ccr);
}

macro sspush(hi, lo) {
	SP = SP + 1;
	*[ss]:4 SP = (zext(hi) << 16) | zext(lo);
}

################################################################ address generation unit
# new = Rn + off under Mn: 0FFFFh linear, 0 reverse carry (bit-reversed add), 1-7FFFh modulo
# Mn+1 (one wrap), 8000h-0FFFEh reserved (linear). The result and whether a modulo wrap
# happened are kept for CHKAAU. The decompiler assumes linear addressing at function entry.

macro bitrev16(v, out) {
	local t:2 = v;
	t = ((t >> 1) & 0x5555) | ((t & 0x5555) << 1);
	t = ((t >> 2) & 0x3333) | ((t & 0x3333) << 2);
	t = ((t >> 4) & 0x0f0f) | ((t & 0x0f0f) << 4);
	out = (t >> 8) | (t << 8);
}

macro aguAdd(r, off, neg, m, out) {
	local lin:2 = r + off;
	local mk:2 = m | (m >> 1);
	mk = mk | (mk >> 2);
	mk = mk | (mk >> 4);
	mk = mk | (mk >> 8);
	local base:2 = r & ~mk;
	local rel0:4 = zext(r - base) + sext(off);
	local modlen:4 = zext(m) + 1;
	local hiw:1 = rel0 s> zext(m);
	local low:1 = rel0 s< 0;
	local rel:4 = rel0 - modlen * zext(hiw) + modlen * zext(low);
	# an offset that is a multiple of the block size 2^k moves to the same place in another
	# block (DSP56100 Family Manual 4.11)
	local blockjump:1 = (off & mk) == 0;
	local md:2 = (base + rel:2) * zext(!blockjump) + lin * zext(blockjump);
	local rr:2;
	bitrev16(r, rr);
	local mag:2 = off * zext(neg == 0) + (-off) * zext(neg != 0);
	local rm:2;
	bitrev16(mag, rm);
	local rs:2 = rr + rm * zext(neg == 0) - rm * zext(neg != 0);
	local rv:2;
	bitrev16(rs, rv);
	local isLin:1 = (m s< 0);
	local isRev:1 = (m == 0);
	local isMod:1 = !isLin && !isRev;
	local res:2 = lin * zext(isLin) + rv * zext(isRev) + md * zext(isMod);
	AGUW = isMod && !blockjump && (hiw || low);
	AGUR = res;
	out = res;
}

################################################################ data ALU helpers

macro scaleAdj(adj) {
	local sm:1 = (MR >> 2) & 3;
	adj = zext(sm == 1) - zext(sm == 2);
}

# E, U, N, Z for a 40-bit accumulator result (integer portion bits 39..31 with no scaling)
macro ccEUNZ(r) {
	local adj:1;
	scaleAdj(adj);
	local sv:8 = sext(r);
	local hi:8 = sv s>> (31 + adj);
	E = (hi != 0) && (hi != -1);
	U = ((sv >> (31 + adj)) & 1) == ((sv >> (30 + adj)) & 1);
	N = sv s< 0;
	Z = r == 0;
}

# logical-unit results on bits 31..16: N from bit 31, Z from bits 31..16, V cleared
macro ccLogic(r1) {
	N = (r1 & 0x8000) != 0;
	Z = r1 == 0;
	V = 0;
}

# OMR.SA saturation of a 40-bit MAC/ALU result on 32 bits (Table 5-2): checks bits 39, 32, 31
macro satAcc(r) {
	local sa:1 = (OMR & 0x10) != 0;
	local b39:1 = (r & 0x8000000000) != 0;
	local b32:1 = (r & 0x0100000000) != 0;
	local b31:1 = (r & 0x0080000000) != 0;
	local hit:1 = sa && !((b39 == b32) && (b32 == b31));
	local satv:5 = 0x007fffffff * zext(!b39) + 0xff80000000 * zext(b39);
	r = r * zext(!hit) + satv * zext(hit);
	V = V || hit;
	L = L || hit;
}

# data shifter/limiter: accumulator onto the 16-bit bus (scaled, limited), L and S
macro busAcc(acc, out) {
	local adj:1;
	scaleAdj(adj);
	local sv:8 = sext(acc);
	local hi:8 = sv s>> (31 + adj);
	local ok:1 = (hi == 0) || (hi == -1);
	local sh:8 = sv s>> (16 + adj);
	local satv:2 = 0x7fff + zext(sv s< 0);
	out = sh:2 * zext(ok) + satv * zext(!ok);
	L = L || !ok;
	S = S || (((sv >> (30 + adj)) & 1) != ((sv >> (29 + adj)) & 1));
}

# rounding at the scaling-dependent position: convergent (OMR.R = 0) or two's complement
macro roundAcc(v, out) {
	local adj:1;
	scaleAdj(adj);
	local pos:1 = 15 + adj;
	local one:5 = 1;
	local rc:5 = one << pos;
	local low:5 = (rc << 1) - 1;
	local t:5 = v + rc;
	local conv:1 = (OMR & 0x20) == 0;
	local half:1 = conv && ((v & low) == rc);
	t = t & ~low;
	t = t & ~((rc << 1) * zext(half));
	out = t;
}

macro addFlags(d, s, cin, out) {
	local t:5 = d + s;
	out = t + zext(cin);
	C = carry(d, s) || carry(t, zext(cin));
	V = scarry(d, s) || scarry(t, zext(cin));
	L = L || V;
}

macro subFlags(d, s, bin, out) {
	local t:5 = d - s;
	out = t - zext(bin);
	C = (d < s) || (t < zext(bin));
	V = sborrow(d, s) || sborrow(t, zext(bin));
	L = L || V;
}

# fractional multiply: 16 x 16 signed, shifted left one bit, as a 40-bit value
macro fmul(s1, s2, out) {
	local prd:5 = sext(s1) * sext(s2);
	out = prd << 1;
}

macro accWrite16(acc, v) {
	local t:5 = sext(v);
	acc = t << 16;
}

macro abs40(v, out) {
	local m:5 = zext(v s< 0);
	out = (v ^ (-m)) + m;
}

macro setMid(acc, m) {
	acc = (acc & ~(0xffff:5 << 16)) | (zext(m) << 16);
}

@include "dsp56156_gen.sinc"
