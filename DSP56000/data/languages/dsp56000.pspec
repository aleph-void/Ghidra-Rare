<?xml version="1.0" encoding="UTF-8"?>

<!-- Motorola DSP56000/DSP56001. Interrupt vectors (two words each, a "fast interrupt" pair of
     instructions or a JSR) per the DSP56000/DSP56001 User's Manual Table 6-1; on-chip
     peripheral registers in X:FFC0-FFFF per Motorola's IOEQU.ASM equates. -->
<processor_spec>
  <programcounter register="PC"/>
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="x" first="0xffc0" last="0xffff"/>
  </volatile>
  <default_symbols>
    <symbol name="RESET" address="p:0000" entry="true"/>
    <symbol name="STACK_ERROR" address="p:0002" entry="true"/>
    <symbol name="TRACE" address="p:0004" entry="true"/>
    <symbol name="SWI" address="p:0006" entry="true"/>
    <symbol name="IRQA" address="p:0008" entry="true"/>
    <symbol name="IRQB" address="p:000a" entry="true"/>
    <symbol name="SSI_RX" address="p:000c" entry="true"/>
    <symbol name="SSI_RX_EXC" address="p:000e" entry="true"/>
    <symbol name="SSI_TX" address="p:0010" entry="true"/>
    <symbol name="SSI_TX_EXC" address="p:0012" entry="true"/>
    <symbol name="SCI_RX" address="p:0014" entry="true"/>
    <symbol name="SCI_RX_EXC" address="p:0016" entry="true"/>
    <symbol name="SCI_TX" address="p:0018" entry="true"/>
    <symbol name="SCI_IDLE" address="p:001a" entry="true"/>
    <symbol name="SCI_TIMER" address="p:001c" entry="true"/>
    <symbol name="NMI" address="p:001e" entry="true"/>
    <symbol name="HOST_RX" address="p:0020" entry="true"/>
    <symbol name="HOST_TX" address="p:0022" entry="true"/>
    <symbol name="HOST_COMMAND" address="p:0024" entry="true"/>
    <symbol name="ILLEGAL" address="p:003e" entry="true"/>
    <symbol name="PBC" address="x:ffe0"/>
    <symbol name="PCC" address="x:ffe1"/>
    <symbol name="PBDDR" address="x:ffe2"/>
    <symbol name="PCDDR" address="x:ffe3"/>
    <symbol name="PBD" address="x:ffe4"/>
    <symbol name="PCD" address="x:ffe5"/>
    <symbol name="HCR" address="x:ffe8"/>
    <symbol name="HSR" address="x:ffe9"/>
    <symbol name="HRX_HTX" address="x:ffeb"/>
    <symbol name="CRA" address="x:ffec"/>
    <symbol name="CRB" address="x:ffed"/>
    <symbol name="SSISR" address="x:ffee"/>
    <symbol name="SSI_RX_TX" address="x:ffef"/>
    <symbol name="SCR" address="x:fff0"/>
    <symbol name="SSR" address="x:fff1"/>
    <symbol name="SCCR" address="x:fff2"/>
    <symbol name="STXA" address="x:fff3"/>
    <symbol name="SRX_STX_L" address="x:fff4"/>
    <symbol name="SRX_STX_M" address="x:fff5"/>
    <symbol name="SRX_STX_H" address="x:fff6"/>
    <symbol name="BCR" address="x:fffe"/>
    <symbol name="IPR" address="x:ffff"/>
  </default_symbols>
  <default_memory_blocks>
    <memory_block name="X" start_address="x:0000" length="0x10000" initialized="false"/>
    <memory_block name="Y" start_address="y:0000" length="0x10000" initialized="false"/>
    <memory_block name="SS" start_address="ss:00" length="0x40" initialized="false"/>
  </default_memory_blocks>
</processor_spec>
