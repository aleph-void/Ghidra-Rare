# DO loop-end p-code appended to every instruction
tail: is lend=0 { }
lstartAddr: lstart is lstart { export *[p]:4 lstart; }
tail: is lend=1 & laddr & lstartAddr { local here:2 = inst_next / 4; if (here != laddr + 1) goto <done>; if ((MR & 0x80) == 0) goto <done>; LC = LC - 1; if (LC == 0) goto <exit>; goto lstartAddr; <exit> local e:4 = *[ss]:4 SP; SP = SP - 1; local sr:2 = e:2; setSR(sr); e = *[ss]:4 SP; SP = SP - 1; LA = e(2); LC = e:2; <done> }


