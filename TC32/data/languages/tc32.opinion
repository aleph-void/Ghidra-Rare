<opinions>
  <!-- tc32-elf (Telink toolchain, "elf32-littletc32"): e_machine 0x8800 ("Telink RISC 32"
       in tc32-elf-readelf), e_flags 0. Ghidra matches the signed
       16-bit value, -30720. -->
  <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
    <constraint primary="-30720" processor="TC32" endian="little" size="32" variant="default"/>
  </constraint>
</opinions>
