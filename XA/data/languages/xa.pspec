  </default_symbols>
  <default_memory_blocks>
    <memory_block name="SFR" start_address="sfr:0400" length="0x400" initialized="false"/>
    <memory_block name="DATA" start_address="data:000000" length="0x10000" initialized="false"/>
  </default_memory_blocks>
</processor_spec>
