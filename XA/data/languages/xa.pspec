    <symbol name="P0" address="sfr:430"/>
    <symbol name="P1" address="sfr:431"/>
    <symbol name="P2" address="sfr:432"/>
    <symbol name="P3" address="sfr:433"/>
    <symbol name="TL0" address="sfr:450"/>
