<?xml version="1.0" encoding="UTF-8"?>

<!-- Philips XA: SFR names from the XA-G3 data sheet (1997 data handbook IC25); other derivatives
     move peripheral SFRs. The vector table (user guide 4.8.2) holds 4-byte entries, PSW word then
     handler address word: exceptions 00h-3Fh, traps 40h-7Fh, events 80h-FFh, software interrupts
     100h-11Bh. XAVectorAnalyzer follows the entries to the handlers. -->
<processor_spec>
  <programcounter register="PC"/>
  <segmentop space="data" userop="segment" farpointer="yes">
    <pcode>
      <input name="base" size="1"/>
      <input name="inner" size="2"/>
      <output name="res" size="3"/>
      <body><![CDATA[
        res = (zext(base) << 16) + zext(inner);
      ]]></body>
    </pcode>
    <constresolve>
      <register name="DS"/>
    </constresolve>
  </segmentop>
  <context_data>
    <context_set space="code">
      <set name="dsk" val="1" description="1 when DS (direct addressing segment) is known"/>
      <set name="dsv" val="0" description="tracked DS value (resets to 0)"/>
    </context_set>
  </context_data>
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="sfr" first="0x404" last="0x43f"/>
    <range space="sfr" first="0x444" last="0x7ff"/>
  </volatile>
  <default_symbols>
    <symbol name="PCON" address="sfr:404"/>
    <symbol name="TCON" address="sfr:410"/>
    <symbol name="TSTAT" address="sfr:411"/>
    <symbol name="T2CON" address="sfr:418"/>
    <symbol name="T2MOD" address="sfr:419"/>
    <symbol name="WDCON" address="sfr:41F"/>
    <symbol name="S0CON" address="sfr:420"/>
    <symbol name="S0STAT" address="sfr:421"/>
    <symbol name="S1CON" address="sfr:424"/>
    <symbol name="S1STAT" address="sfr:425"/>
