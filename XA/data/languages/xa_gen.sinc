:MOV.b dir1_L, ind1_pd is op=160 ; (b7=1 & b3=0 & ind1_pd) ... & dir1_L & dpost1_L { local v:1 = ind1_pd; dir1_L = v; nz(v); build dpost1_L; }
:MOV.b dir1_H, dir1_S is op=151 ; ((b7=0 & b3=0) ... & dir1_H & dpost1_H) ... & dir1_S { local v:1 = dir1_S; dir1_H = v; nz(v); build dpost1_H; }
:MOV.b inc1_pd, inc1_ps is op=144 ; b7=0 & b3=0 & pd & ps & inc1_pd & inc1_ps { local v:1 = inc1_ps; inc1_pd = v; nz(v); pd = pd + 1; ps = ps + 1; }
:MOVC.b rdb, "["^ps^"+]" is op=128 ; rdb & b3=0 & ps & cseg_ps { local a:3 = (zext(cseg_ps) << 16) | zext(ps); local v:1 = *[code]:1 a; rdb = v; nz(v); ps = ps + 1; }
:MOVX.b rdb, "["^ps^"]" is op=167 ; rdb & b3=0 & ps { local a:3 = segment(0:1, ps); local v:1 = *[data]:1 a; rdb = v; nz(v); }
:MOVX.b "["^ps^"]", rdb is op=167 ; rdb & b3=1 & ps { local a:3 = segment(0:1, ps); local v:1 = rdb; *[data]:1 a = v; nz(v); }
:XCH.w rdw, rsw is op=104 ; rdw & rsw { local v:2 = rdw; rdw = rsw; rsw = v; }
:XCH.w rdw, ind2_ps is op=88 ; rdw & b3=0 & ind2_ps { local v:2 = rdw; rdw = ind2_ps; ind2_ps = v; }
:XCH.w rdw, dir2_L is op=168 ; (rdw & b3=1) ... & dir2_L & dpost2_L { local v:2 = rdw; rdw = dir2_L; dir2_L = v; build dpost2_L; }
:MOV.w ind2_pd, dir2_L is op=168 ; (b7=0 & b3=0 & ind2_pd) ... & dir2_L { local v:2 = dir2_L; ind2_pd = v; nz(v); }
:MOV.w dir2_L, ind2_pd is op=168 ; (b7=1 & b3=0 & ind2_pd) ... & dir2_L & dpost2_L { local v:2 = ind2_pd; dir2_L = v; nz(v); build dpost2_L; }
:MOV.w dir2_H, dir2_S is op=159 ; ((b7=0 & b3=0) ... & dir2_H & dpost2_H) ... & dir2_S { local v:2 = dir2_S; dir2_H = v; nz(v); build dpost2_H; }
:MOV.w inc2_pd, inc2_ps is op=152 ; b7=0 & b3=0 & pd & ps & inc2_pd & inc2_ps { local v:2 = inc2_ps; inc2_pd = v; nz(v); pd = pd + 2; ps = ps + 2; }
:MOVC.w rdw, "["^ps^"+]" is op=136 ; rdw & b3=0 & ps & cseg_ps { local a:3 = (zext(cseg_ps) << 16) | zext(ps); local v:2 = *[code]:2 a; rdw = v; nz(v); ps = ps + 2; }
:MOVX.w rdw, "["^ps^"]" is op=175 ; rdw & b3=0 & ps { local a:3 = segment(0:1, ps); local v:2 = *[data]:2 a; rdw = v; nz(v); }
:MOVX.w "["^ps^"]", rdw is op=175 ; rdw & b3=1 & ps { local a:3 = segment(0:1, ps); local v:2 = rdw; *[data]:2 a = v; nz(v); }
:LEA pd, ps^o8 is op=0x40 ; b7=0 & b3=0 & pd & ps ; o8 & xa8s { pd = ps + xa8s; }
:LEA pd, ps^o16 is op=0x48 ; b7=0 & b3=0 & pd & ps ; o16 & xa16 { pd = ps + xa16; }
:MOV rdw, "USP" is op=0x90 ; rdw & lo4=0xf { rdw = USP; nz(rdw); }
:MOV "USP", rdw is op=0x98 ; rdw & lo4=0xf { USP = rdw; nz(rdw); }
:MOVC "A", "[A+DPTR]" is op=0x90 ; b2=0x4e { local a:3 = (inst_next & 0xff0000) | zext(zext(R4L) + R6); R4L = *[code]:1 a; nz(R4L); }
:MOVC "A", "[A+PC]" is op=0x90 ; b2=0x4c { local pc:3 = inst_next; local a:3 = (inst_next & 0xff0000) | zext(zext(R4L) + pc:2); R4L = *[code]:1 a; nz(R4L); }

# ---------------------------------------------------------------- DA, SEXT, CPL, NEG
:DA rdb is op=0x90 ; rdb & lo4=8 {
	local v:1 = rdb;
	local lo:1 = ((v & 0xf) > 9) || (AC != 0);
	local t:2 = zext(v) + zext(lo * 6);
	local c:1 = (C != 0) || (t > 0xff);
	v = t:1;
	local hi:1 = ((v >> 4) > 9) || c;
	t = zext(v) + zext(hi * 0x60);
	C = c || (t > 0xff);
	v = t:1;
	rdb = v;
	nz(v);
}
:SEXT.b rdb is op=144 ; rdb & lo4=9 { rdb = 0 - N; }
:CPL.b rdb is op=144 ; rdb & lo4=0xa { rdb = ~rdb; nz(rdb); }
:NEG.b rdb is op=144 ; rdb & lo4=0xb { local a:1 = rdb; V = a == 0x80; rdb = -a; nz(rdb); }
:SEXT.w rdw is op=152 ; rdw & lo4=9 { rdw = 0 - zext(N); }
:CPL.w rdw is op=152 ; rdw & lo4=0xa { rdw = ~rdw; nz(rdw); }
:NEG.w rdw is op=152 ; rdw & lo4=0xb { local a:2 = rdw; V = a == 0x8000; rdw = -a; nz(rdw); }

# ---------------------------------------------------------------- shifts, rotates, NORM
:LSR.b rdb, rsb is op=192 ; rdb & rsb { local x:1 = rdb; local n:1 = (rsb & 31); if (n == 0) goto <z>; local cb:1 = x >> (n - 1); C = cb:1 & 1; x = x >> n; rdb = x; <z> nz(x); }
:LSR.b rdb, "#"^imm4 is op=208 ; rdb & imm4 { local x:1 = rdb; local n:1 = imm4; if (n == 0) goto <z>; local cb:1 = x >> (n - 1); C = cb:1 & 1; x = x >> n; rdb = x; <z> nz(x); }
:ASL.b rdb, rsb is op=193 ; rdb & rsb { local x:1 = rdb; local n:1 = (rsb & 31); V = 0; if (n == 0) goto <z>; local cb:1 = (x << (n - 1)) >> 7; C = cb:1; V = ((x << n) s>> n) != x; x = x << n; rdb = x; <z> nz(x); }
:ASL.b rdb, "#"^imm4 is op=209 ; rdb & imm4 { local x:1 = rdb; local n:1 = imm4; V = 0; if (n == 0) goto <z>; local cb:1 = (x << (n - 1)) >> 7; C = cb:1; V = ((x << n) s>> n) != x; x = x << n; rdb = x; <z> nz(x); }
:ASR.b rdb, rsb is op=194 ; rdb & rsb { local x:1 = rdb; local n:1 = (rsb & 31); if (n == 0) goto <z>; local cb:1 = x s>> (n - 1); C = cb:1 & 1; x = x s>> n; rdb = x; <z> nz(x); }
:ASR.b rdb, "#"^imm4 is op=210 ; rdb & imm4 { local x:1 = rdb; local n:1 = imm4; if (n == 0) goto <z>; local cb:1 = x s>> (n - 1); C = cb:1 & 1; x = x s>> n; rdb = x; <z> nz(x); }
:NORM.b rdb, rsb is op=195 ; rdb & rsb { local x:1 = rdb; local n:1 = 0; if (x == 0) goto <z>; n = lzcount(x); x = x << n; <z> rdb = x; rsb = n:1; nz(x); }
:LSR.w rdw, rsb is op=200 ; rdw & rsb { local x:2 = rdw; local n:2 = zext((rsb & 31)); if (n == 0) goto <z>; local cb:2 = x >> (n - 1); C = cb:1 & 1; x = x >> n; rdw = x; <z> nz(x); }
:LSR.w rdw, "#"^imm4 is op=216 ; rdw & imm4 { local x:2 = rdw; local n:2 = imm4; if (n == 0) goto <z>; local cb:2 = x >> (n - 1); C = cb:1 & 1; x = x >> n; rdw = x; <z> nz(x); }
:ASL.w rdw, rsb is op=201 ; rdw & rsb { local x:2 = rdw; local n:2 = zext((rsb & 31)); V = 0; if (n == 0) goto <z>; local cb:2 = (x << (n - 1)) >> 15; C = cb:1; V = ((x << n) s>> n) != x; x = x << n; rdw = x; <z> nz(x); }
:ASL.w rdw, "#"^imm4 is op=217 ; rdw & imm4 { local x:2 = rdw; local n:2 = imm4; V = 0; if (n == 0) goto <z>; local cb:2 = (x << (n - 1)) >> 15; C = cb:1; V = ((x << n) s>> n) != x; x = x << n; rdw = x; <z> nz(x); }
:ASR.w rdw, rsb is op=202 ; rdw & rsb { local x:2 = rdw; local n:2 = zext((rsb & 31)); if (n == 0) goto <z>; local cb:2 = x s>> (n - 1); C = cb:1 & 1; x = x s>> n; rdw = x; <z> nz(x); }
:ASR.w rdw, "#"^imm4 is op=218 ; rdw & imm4 { local x:2 = rdw; local n:2 = imm4; if (n == 0) goto <z>; local cb:2 = x s>> (n - 1); C = cb:1 & 1; x = x s>> n; rdw = x; <z> nz(x); }
:NORM.w rdw, rsb is op=203 ; rdw & rsb { local x:2 = rdw; local n:2 = 0; if (x == 0) goto <z>; n = lzcount(x); x = x << n; <z> rdw = x; rsb = n:1; nz(x); }
:LSR.d rddn, rsb is op=204 ; rdd & rddn & rsb { local x:4 = rdd; local n:4 = zext((rsb & 31)); if (n == 0) goto <z>; local cb:4 = x >> (n - 1); C = cb:1 & 1; x = x >> n; rdd = x; <z> nz(x); }
:LSR.d pddn, "#"^imm5 is op=220 ; pdd & pddn & imm5 { local x:4 = pdd; local n:4 = imm5; if (n == 0) goto <z>; local cb:4 = x >> (n - 1); C = cb:1 & 1; x = x >> n; pdd = x; <z> nz(x); }
:ASL.d rddn, rsb is op=205 ; rdd & rddn & rsb { local x:4 = rdd; local n:4 = zext((rsb & 31)); V = 0; if (n == 0) goto <z>; local cb:4 = (x << (n - 1)) >> 31; C = cb:1; V = ((x << n) s>> n) != x; x = x << n; rdd = x; <z> nz(x); }
:ASL.d pddn, "#"^imm5 is op=221 ; pdd & pddn & imm5 { local x:4 = pdd; local n:4 = imm5; V = 0; if (n == 0) goto <z>; local cb:4 = (x << (n - 1)) >> 31; C = cb:1; V = ((x << n) s>> n) != x; x = x << n; pdd = x; <z> nz(x); }
:ASR.d rddn, rsb is op=206 ; rdd & rddn & rsb { local x:4 = rdd; local n:4 = zext((rsb & 31)); if (n == 0) goto <z>; local cb:4 = x s>> (n - 1); C = cb:1 & 1; x = x s>> n; rdd = x; <z> nz(x); }
:ASR.d pddn, "#"^imm5 is op=222 ; pdd & pddn & imm5 { local x:4 = pdd; local n:4 = imm5; if (n == 0) goto <z>; local cb:4 = x s>> (n - 1); C = cb:1 & 1; x = x s>> n; pdd = x; <z> nz(x); }
:NORM.d rddn, rsb is op=207 ; rdd & rddn & rsb { local x:4 = rdd; local n:4 = 0; if (x == 0) goto <z>; n = lzcount(x); x = x << n; <z> rdd = x; rsb = n:1; nz(x); }
:RR.b rdb, "#"^imm4 is op=176 ; rdb & imm4 { local x:1 = rdb; local n:1 = imm4 % 8; x = (x >> n) | (x << (8 - n)); rdb = x; nz(x); }
:RL.b rdb, "#"^imm4 is op=211 ; rdb & imm4 { local x:1 = rdb; local n:1 = imm4 % 8; x = (x << n) | (x >> (8 - n)); rdb = x; nz(x); }
:RRC.b rdb, "#"^imm4 is op=183 ; rdb & imm4 { local v:4 = (zext(C) << 8) | zext(rdb); local n:4 = imm4 % 9; v = ((v >> n) | (v << (9 - n))) & 0x1ff; rdb = v:1; local cy:4 = v >> 8; C = cy:1; nz(rdb); }
:RLC.b rdb, "#"^imm4 is op=215 ; rdb & imm4 { local v:4 = (zext(C) << 8) | zext(rdb); local n:4 = imm4 % 9; v = ((v << n) | (v >> (9 - n))) & 0x1ff; rdb = v:1; local cy:4 = v >> 8; C = cy:1; nz(rdb); }
:RR.w rdw, "#"^imm4 is op=184 ; rdw & imm4 { local x:2 = rdw; local n:2 = imm4 % 16; x = (x >> n) | (x << (16 - n)); rdw = x; nz(x); }
:RL.w rdw, "#"^imm4 is op=219 ; rdw & imm4 { local x:2 = rdw; local n:2 = imm4 % 16; x = (x << n) | (x >> (16 - n)); rdw = x; nz(x); }
:RRC.w rdw, "#"^imm4 is op=191 ; rdw & imm4 { local v:4 = (zext(C) << 16) | zext(rdw); local n:4 = imm4 % 17; v = ((v >> n) | (v << (17 - n))) & 0x1ffff; rdw = v:2; local cy:4 = v >> 16; C = cy:1; nz(rdw); }
:RLC.w rdw, "#"^imm4 is op=223 ; rdw & imm4 { local v:4 = (zext(C) << 16) | zext(rdw); local n:4 = imm4 % 17; v = ((v << n) | (v >> (17 - n))) & 0x1ffff; rdw = v:2; local cy:4 = v >> 16; C = cy:1; nz(rdw); }

# ---------------------------------------------------------------- multiply and divide
:MULU.b rdb, rsb is op=0xe0 ; rdb & rdb1 & rsb { local s:1 = rsb; local p:2 = zext(rdb) * zext(s); rdb = p:1; rdb1 = p(1); C = 0; V = p > 0xff; nz(p); }
:MULU.w rdw, rsw is op=0xe4 ; rdw & rdw1 & rsw { local s:2 = rsw; local p:4 = zext(rdw) * zext(s); rdw = p:2; rdw1 = p(2); C = 0; V = p > 0xffff; nz(p); }
:MUL.w rdw, rsw is op=0xe6 ; rdw & rdw1 & rsw { local s:2 = rsw; local p:4 = sext(rdw) * sext(s); rdw = p:2; rdw1 = p(2); C = 0; V = sext(p:2) != p; nz(p); }
:DIVU.b rdb, rsb is op=0xe1 ; rdb & rdb1 & rsb { local dv:1 = rsb; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local q:1 = rdb / dv; local r:1 = rdb % dv; rdb = q; rdb1 = r; C = 0; V = 0; nz(q); }
:DIVU.w rdw, rsb is op=0xe5 ; rdw & rsb { local dv:1 = rsb; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local x:2 = rdw; local d2:2 = zext(dv); local q:2 = x / d2; local r:2 = x % d2; rdw = (r << 8) | (q & 0xff); C = 0; V = q > 0xff; local q1:1 = q:1; nz(q1); }
:DIV.w rdw, rsb is op=0xe7 ; rdw & rsb { local dv:1 = rsb; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local x:2 = rdw; local d2:2 = sext(dv); local q:2 = x s/ d2; local r:2 = x s% d2; rdw = (r << 8) | (q & 0xff); C = 0; local q1:1 = q:1; V = sext(q1) != q; nz(q1); }
:DIVU.d pddn, rsw is op=0xed ; pdd & pddn & b4=0 & rsw { local dv:2 = rsw; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local x:4 = pdd; local d4:4 = zext(dv); local q:4 = x / d4; local r:4 = x % d4; pdd = (r << 16) | (q & 0xffff); C = 0; V = q > 0xffff; local q2:2 = q:2; nz(q2); }
:DIV.d pddn, rsw is op=0xef ; pdd & pddn & b4=0 & rsw { local dv:2 = rsw; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local x:4 = pdd; local d4:4 = sext(dv); local q:4 = x s/ d4; local r:4 = x s% d4; pdd = (r << 16) | (q & 0xffff); C = 0; local q2:2 = q:2; V = sext(q2) != q; nz(q2); }
:MULU.b rdb, "#"^xa8 is op=0xe8 ; rdb & rdb1 & lo4=0 ; xa8 { local s:1 = xa8; local p:2 = zext(rdb) * zext(s); rdb = p:1; rdb1 = p(1); C = 0; V = p > 0xff; nz(p); }
:DIVU.b rdb, "#"^xa8 is op=0xe8 ; rdb & rdb1 & lo4=1 ; xa8 { local dv:1 = xa8; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local q:1 = rdb / dv; local r:1 = rdb % dv; rdb = q; rdb1 = r; C = 0; V = 0; nz(q); }
:DIVU.w rdw, "#"^xa8 is op=0xe8 ; rdw & lo4=3 ; xa8 { local dv:1 = xa8; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local x:2 = rdw; local d2:2 = zext(dv); local q:2 = x / d2; local r:2 = x % d2; rdw = (r << 8) | (q & 0xff); C = 0; V = q > 0xff; local q1:1 = q:1; nz(q1); }
:DIV.w rdw, "#"^xa8 is op=0xe8 ; rdw & lo4=0xb ; xa8 { local dv:1 = xa8; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local x:2 = rdw; local d2:2 = sext(dv); local q:2 = x s/ d2; local r:2 = x s% d2; rdw = (r << 8) | (q & 0xff); C = 0; local q1:1 = q:1; V = sext(q1) != q; nz(q1); }
:MULU.w rdw, "#"^xa16 is op=0xe9 ; rdw & rdw1 & lo4=0 ; xa16 { local s:2 = xa16; local p:4 = zext(rdw) * zext(s); rdw = p:2; rdw1 = p(2); C = 0; V = p > 0xffff; nz(p); }
:MUL.w rdw, "#"^xa16 is op=0xe9 ; rdw & rdw1 & lo4=8 ; xa16 { local s:2 = xa16; local p:4 = sext(rdw) * sext(s); rdw = p:2; rdw1 = p(2); C = 0; V = sext(p:2) != p; nz(p); }
:DIVU.d pddn, "#"^xa16 is op=0xe9 ; pdd & pddn & b4=0 & lo4=1 ; xa16 { local dv:2 = xa16; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local x:4 = pdd; local d4:4 = zext(dv); local q:4 = x / d4; local r:4 = x % d4; pdd = (r << 16) | (q & 0xffff); C = 0; V = q > 0xffff; local q2:2 = q:2; nz(q2); }
:DIV.d pddn, "#"^xa16 is op=0xe9 ; pdd & pddn & b4=0 & lo4=9 ; xa16 { local dv:2 = xa16; if (dv != 0) goto <ok>; C = 0; V = 1; divide_by_zero(); goto inst_next; <ok> local x:4 = pdd; local d4:4 = sext(dv); local q:4 = x s/ d4; local r:4 = x s% d4; pdd = (r << 16) | (q & 0xffff); C = 0; local q2:2 = q:2; V = sext(q2) != q; nz(q2); }

# ---------------------------------------------------------------- CJNE, DJNZ
:CJNE.b rdb, dir1_L, rel8b is op=226 ; (rdb & b3=0) ... & dir1_L ; rel8b { local x:1 = rdb; local y:1 = dir1_L; local r:1 = x - y; C = x < y; nz(r); if (r != 0) goto rel8b; }
:DJNZ.b dir1_L, rel8b is op=226 ; (hi4=0 & b3=1) ... & dir1_L & dpost1_L ; rel8b { local r:1 = dir1_L - 1; dir1_L = r; nz(r); build dpost1_L; if (r != 0) goto rel8b; }
:CJNE.b rdb, "#"^xb8, rel8a is op=0xe3 ; rdb & lo4=0 ; rel8a & xa8 ; xb8 { local x:1 = rdb; local y:1 = xb8; local r:1 = x - y; C = x < y; nz(r); if (r != 0) goto rel8a; }
:CJNE.b ind1_pd, "#"^xb8, rel8a is op=0xe3 ; b7=0 & ind1_pd & lo4=8 ; rel8a & xa8 ; xb8 { local x:1 = ind1_pd; local y:1 = xb8; local r:1 = x - y; C = x < y; nz(r); if (r != 0) goto rel8a; }
:DJNZ.b rdb, rel8a is op=135 ; rdb & lo4=8 ; rel8a & xa8 { local r:1 = rdb - 1; rdb = r; nz(r); if (r != 0) goto rel8a; }
:CJNE.w rdw, dir2_L, rel8b is op=234 ; (rdw & b3=0) ... & dir2_L ; rel8b { local x:2 = rdw; local y:2 = dir2_L; local r:2 = x - y; C = x < y; nz(r); if (r != 0) goto rel8b; }
:DJNZ.w dir2_L, rel8b is op=234 ; (hi4=0 & b3=1) ... & dir2_L & dpost2_L ; rel8b { local r:2 = dir2_L - 1; dir2_L = r; nz(r); build dpost2_L; if (r != 0) goto rel8b; }
:CJNE.w rdw, "#"^xa16, rel8a is op=0xeb ; rdw & lo4=0 ; rel8a & xa8 ; xa16 { local x:2 = rdw; local y:2 = xa16; local r:2 = x - y; C = x < y; nz(r); if (r != 0) goto rel8a; }
:CJNE.w ind2_pd, "#"^xa16, rel8a is op=0xeb ; b7=0 & ind2_pd & lo4=8 ; rel8a & xa8 ; xa16 { local x:2 = ind2_pd; local y:2 = xa16; local r:2 = x - y; C = x < y; nz(r); if (r != 0) goto rel8a; }
:DJNZ.w rdw, rel8a is op=143 ; rdw & lo4=8 ; rel8a & xa8 { local r:2 = rdw - 1; rdw = r; nz(r); if (r != 0) goto rel8a; }

# ---------------------------------------------------------------- PUSH / POP
:POPU.b dir1_L is op=135 ; (hi4=0 & b3=0) ... & dir1_L & dpost1_L { local ua:3 = segment(DS, USP); dir1_L = *[data]:1 ua; USP = USP + 2; build dpost1_L; }
:POP.b dir1_L is op=135 ; (hi4=1 & b3=0) ... & dir1_L & dpost1_L { local sa:3 = segment(0:1, R7); dir1_L = *[data]:1 sa; R7 = R7 + 2; build dpost1_L; }
