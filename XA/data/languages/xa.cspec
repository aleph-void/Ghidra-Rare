<?xml version="1.0" encoding="UTF-8"?>

<!-- Philips XA, native mode: CALL/FCALL push a 4-byte return frame (PC[15:0], then PC[23:16] in a word).
     There is no standard XA C ABI among free toolchains; the default model is assembly code:
     arguments may arrive in R0-R6, R7 is the stack pointer. The decompiler assumes DS = ES = 0
     and SSEL = 0 (all pointers in segment 0, the reset state) at function entry. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="2"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="2"/>
    <pointer_size value="2"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="4"/>
    <long_double_size value="4"/>
  </data_organization>
  <global>
    <range space="code"/>
    <range space="data"/>
    <range space="sfr"/>
  </global>
  <stackpointer register="R7" space="data" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="4"/>
  </returnaddress>
  <context_data>
    <tracked_set space="code">
      <set name="DS" val="0"/>
      <set name="ES" val="0"/>
      <set name="SSEL" val="0"/>
    </tracked_set>
  </context_data>
  <default_proto>
    <prototype name="__asm" extrapop="4" stackshift="4">
      <input>
        <pentry minsize="1" maxsize="2"><register name="R0"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R1"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R2"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R3"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R4"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R5"/></pentry>
        <pentry minsize="1" maxsize="2"><register name="R6"/></pentry>
      </input>
      <output>
      </output>
      <unaffected>
        <register name="R7"/>
        <register name="DS"/>
        <register name="ES"/>
        <register name="SSEL"/>
      </unaffected>
      <killedbycall>
        <register name="C"/>
        <register name="AC"/>
        <register name="V"/>
        <register name="N"/>
        <register name="Z"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
