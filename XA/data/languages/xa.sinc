# Philips/NXP XA ("eXtended Architecture", 51XA) CPU core.
#
# Written from the Philips "XA User Guide" (1998, chapters 2-6 and 9) and the XA-G3 data sheet
# SFR table in the 1997 "16-bit 80C51XA Microcontrollers" data handbook (IC25). The regular
# instruction groups and the direct-address operand tables are generated by tools/gen_xa.py
# into xa_gen.sinc; this file holds the spaces, registers, tokens, operand helpers and the
# control-flow, bit, stack and system instructions.
#
# Address spaces
#   code  16 MB program memory (instruction fetch, MOVC)
#   data  16 MB data memory: 256 segments of 64 KB, addressed as segment:offset
#   sfr   the 1 KB SFR space (addresses 400h-7FFh as encoded in instructions)
#
# Registers R0-R7 (R7 is the stack pointer), their byte halves RnL/RnH, the flags, the core
# SFRs PSWL/PSWH/PSW51/SSEL (400h-403h) and SCR/DS/ES/CS (440h-443h) live in the register
# space; direct SFR operands that name them are routed to those registers (xa_gen.sinc).
# The PSW flags C, AC, V, N and Z are separate registers; PSWL is rebuilt from them when an
# instruction reads PSWL and they are reloaded from it after a write (explicit PSW writes take
# precedence over flag updates, user guide 4.2.3).
#
# Data addresses are formed with the segment(base, offset) operation (the pspec declares it as the
# segment op, base:offset = base << 16 | offset), the way Ghidra models x86 real mode and the
# HCS12X, so the decompiler recognises stack and pointer accesses. Emulating XA code therefore
# needs a "segment" user-op callback (test/XAEmuTest.java registers one).
#
# Segments: indirect operands [Rn] use DS or ES as selected by SSEL bit n (CS or PC[23:16] for
# MOVC and JMP [[Rn+]]); R7-relative and stack accesses use segment 0 (system mode). Direct
# operands (000h-3FFh) use DS: the context register tracks a DS value that is known from
# a constant write (default 0); after any other write to DS the address is computed at run time.
#
# Not modelled: register banks (PSW.RS1/RS0 select which R0-R3 are visible; the module has one
# R0-R3), user-mode stacks (R7 is treated as the system stack pointer, USP is a register),
# 80C51 compatibility mode (SCR.CM), forced word alignment of odd word addresses, interrupts.

define endian=little;
define alignment=1;

define space code     type=ram_space      size=3  default;
define space data     type=ram_space      size=3;
define space sfr      type=ram_space      size=2;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ R0 R1 R2 R3 R4 R5 R6 R7 ];
define register offset=0x00 size=1 [ R0L R0H R1L R1H R2L R2H R3L R3H R4L R4H R5L R5H R6L R6H R7L R7H ];
define register offset=0x00 size=4 [ R1R0 R3R2 R5R4 R7R6 ];
define register offset=0x20 size=1 [ C AC V N Z ];
# core SFRs 400h-403h and 440h-443h, in SFR address order
define register offset=0x28 size=1 [ PSWL PSWH PSW51 SSEL ];
define register offset=0x28 size=2 [ PSW PSW51_SSEL ];
define register offset=0x2c size=1 [ SCR DS ES CS ];
define register offset=0x2c size=2 [ SCR_DS ES_CS ];
define register offset=0x30 size=2 [ USP ];
define register offset=0x34 size=3 [ PC ];
define register offset=0x40 size=4 [ contextreg ];

define context contextreg
	dsv = (0,7)     # DS value assumed for direct addresses (when dsk = 1)
	dsk = (8,8)     # 1: DS is known (set by MOV/MOVS DS,#imm, default 0 at reset)
;

# first byte
define token b1tok (8)
	op   = (0,7)
	opn  = (4,7)
	sz   = (3,3)
	mode = (0,2)
	hl   = (6,6)
	pp   = (4,5)
	ssz  = (2,3)
	sop  = (0,1)
;
# second byte
define token b2tok (8)
	b2   = (0,7)
	b2s  = (0,7) signed
	hi4  = (4,7)
	lo4  = (0,3)
	b7   = (7,7)
	hi3  = (4,6)
	b3   = (3,3)
	b4   = (4,4)
	lo3  = (0,2)
	lo2  = (0,1)
	b32  = (2,3)
	rdw  = (4,7)
	rdb  = (4,7)
	rdw1 = (4,7)
	rdb1 = (4,7)
	rdd  = (4,7)
	rddn = (4,7)
	rsw  = (0,3)
	rsb  = (0,3)
	pd   = (4,6)
	ps   = (0,2)
	pdi  = (4,6)
	psi  = (0,2)
	pdd  = (5,7)
	pddn = (5,7)
	imm4 = (0,3)
	simm4 = (0,3) signed
	imm5 = (0,4)
	rlist = (0,7)
;
define token w23tok (16) endian=big
	r16 = (0,15) signed
;
define token x8atok (8)
	xa8  = (0,7)
	xa8s = (0,7) signed
	xa8hi = (7,7)
	xa8reg = (3,6)
	xa8bit = (0,2)
	xa8bitd = (0,2)
	xa8byte = (3,7)
;
define token x8btok (8)
	xb8  = (0,7)
	xb8s = (0,7) signed
;
define token x8ctok (8)
	xc8  = (0,7)
;
define token x16atok (16) endian=big
	xa16  = (0,15)
	xa16s = (0,15) signed
	xa16hi = (15,15)
;
define token x16btok (16) endian=big
	xb16  = (0,15)
;

# R8-R15 are reserved in the baseline XA core (user guide 3.2.1): encodings naming them fail.
attach variables [ rdw rsw ] [ R0 R1 R2 R3 R4 R5 R6 R7 _ _ _ _ _ _ _ _ ];
attach variables [ rdw1 ] [ R1 R2 R3 R4 R5 R6 R7 _ _ _ _ _ _ _ _ _ ];
attach variables [ rdb rsb xa8reg ] [ R0L R0H R1L R1H R2L R2H R3L R3H R4L R4H R5L R5H R6L R6H R7L R7H ];
attach variables [ rdb1 ] [ R0H R1L R1H R2L R2H R3L R3H R4L R4H R5L R5H R6L R6H R7L R7H _ ];
attach variables [ pd ps ] [ R0 R1 R2 R3 R4 R5 R6 R7 ];
attach variables [ rdd ] [ R1R0 _ R3R2 _ R5R4 _ R7R6 _ _ _ _ _ _ _ _ _ ];
attach names [ rddn ] [ "R0" "R1" "R2" "R3" "R4" "R5" "R6" "R7" "R8" "R9" "R10" "R11" "R12" "R13" "R14" "R15" ];
attach variables [ pdd ] [ R1R0 R3R2 R5R4 R7R6 _ _ _ _ ];
attach names [ xa8bitd ] [ "0" "1" "2" "3" "4" "5" "6" "7" ];
attach names [ pddn ] [ "R0" "R2" "R4" "R6" "R8" "R10" "R12" "R14" ];

# segment(base, offset): the 24-bit data address base:offset (declared as the segment operation
# in xa.pspec, so the decompiler sees stack and DS-relative pointers through it)
define pcodeop segment;
define pcodeop breakpoint;
define pcodeop software_reset;
define pcodeop divide_by_zero;
define pcodeop user_mode_reti;

# ---------------------------------------------------------------------------- flag helpers

macro packflags() {
	PSWL = (C << 7) | (AC << 6) | (PSWL & 0x38) | (V << 2) | (N << 1) | Z;
}

macro unpackflags() {
	C = (PSWL >> 7) & 1;
	AC = (PSWL >> 6) & 1;
	V = (PSWL >> 2) & 1;
	N = (PSWL >> 1) & 1;
	Z = PSWL & 1;
}

macro nz(r) {
	N = r s< 0;
	Z = r == 0;
}

macro addflags(a, b, r) {
	C = carry(a, b);
	V = scarry(a, b);
	AC = ((a & 0xf) + (b & 0xf)) > 0xf;
	nz(r);
}

macro addcflags(a, b, cin, r) {
	C = carry(a, b) || carry(a + b, cin);
	V = ((a ^ r) & (b ^ r)) s< 0;
	AC = ((a & 0xf) + (b & 0xf) + cin) > 0xf;
	nz(r);
}

macro subflags(a, b, r) {
	C = a < b;
	V = sborrow(a, b);
	AC = (a & 0xf) < (b & 0xf);
	nz(r);
}

macro subbflags(a, b, cin, r) {
	C = (a < b) || ((a - b) < cin);
	V = ((a ^ b) & (a ^ r)) s< 0;
	AC = (a & 0xf) < ((b & 0xf) + cin);
	nz(r);
}

# ---------------------------------------------------------------------------- stack helpers
# R7 is the (system) stack pointer, in data segment 0. The user stack (PUSHU/POPU) is USP in
# the DS segment.

macro push16(v) {
	R7 = R7 - 2;
	local sa:3 = segment(0:1, R7);
	*[data]:2 sa = v;
}

macro pop16(v) {
	local sa:3 = segment(0:1, R7);
	v = *[data]:2 sa;
	R7 = R7 + 2;
}

macro upush16(v) {
	USP = USP - 2;
	local a:3 = segment(DS, USP);
	*[data]:2 a = v;
}

macro upop16(v) {
	local a:3 = segment(DS, USP);
	v = *[data]:2 a;
	USP = USP + 2;
}

# Return addresses: native mode pushes the low 16 bits of the PC, then a word holding PC[23:16];
# page 0 mode pushes 16 bits only (user guide 4.3, 4.8.2).
@ifdef PAGE0
macro pushpc(a) {
	R7 = R7 - 2;
	local pa:3 = segment(0:1, R7);
	local lo:2 = a:2;
	*[data]:2 pa = lo;
}
macro poppc(a) {
	local pa:3 = segment(0:1, R7);
	local lo:2 = *[data]:2 pa;
	R7 = R7 + 2;
	a = zext(lo);
}
@else
macro pushpc(a) {
	R7 = R7 - 4;
	local pa:3 = segment(0:1, R7);
	local sp2:2 = R7 + 2;
	local pb:3 = segment(0:1, sp2);
	local lo:2 = a:2;
	*[data]:2 pb = lo;
	local hb:1 = a(2);
	local hi:2 = zext(hb);
	*[data]:2 pa = hi;
}
macro poppc(a) {
	local pa:3 = segment(0:1, R7);
	local sp2:2 = R7 + 2;
	local pb:3 = segment(0:1, sp2);
	local hi:2 = *[data]:2 pa;
	local lo:2 = *[data]:2 pb;
	R7 = R7 + 4;
	a = (zext(hi:1) << 16) | zext(lo);
}
@endif

# ---------------------------------------------------------------------------- operands

# segment byte for an indirect data operand through pointer register n (SSEL bit n: 0 = DS,
# 1 = ES; R7 always addresses segment 0 in system mode)
dseg_pd: is pdi=7 { local s:1 = 0; export s; }
dseg_pd: is pdi { local b:1 = (SSEL >> pdi) & 1; local s:1 = (DS & (b - 1)) | (ES & (0 - b)); export s; }
dseg_ps: is psi=7 { local s:1 = 0; export s; }
dseg_ps: is psi { local b:1 = (SSEL >> psi) & 1; local s:1 = (DS & (b - 1)) | (ES & (0 - b)); export s; }

# segment byte for a code operand through pointer register n (SSEL bit n: 0 = PC[23:16], 1 = CS)
cseg_ps: is psi { local b:1 = (SSEL >> psi) & 1; local nx:3 = inst_next; local p:1 = nx(2); local s:1 = (p & (b - 1)) | (CS & (0 - b)); export s; }

# relative targets: (address of next instruction with bit 0 cleared) + 2 * displacement
rel8:  t is b2s  [ t = (((inst_next >> 1) << 1) + b2s * 2) & 0xffffff; ]  { export *:1 t; }
rel8a: t is xa8s [ t = (((inst_next >> 1) << 1) + xa8s * 2) & 0xffffff; ] { export *:1 t; }
rel8b: t is xb8s [ t = (((inst_next >> 1) << 1) + xb8s * 2) & 0xffffff; ] { export *:1 t; }
rel16: t is r16 [ t = (((inst_next >> 1) << 1) + r16 * 2) & 0xffffff; ] { export *:1 t; }
@ifdef PAGE0
addr24: t is xa8 ; xb8 ; xc8 [ t = ((xa8 << 8) | xb8) & 0xfffe; ] { export *:1 t; }
@else
addr24: t is xa8 ; xb8 ; xc8 [ t = ((xc8 << 16) | (xa8 << 8) | xb8) & 0xfffffe; ] { export *:1 t; }
@endif

# ---------------------------------------------------------------------------- bit operands
# 10-bit bit address (user guide 6.2.7, figure 3.15) in byte 2 bits 1-0 and byte 3:
#   000h-0FFh register file (R8-R15 bits 080h-0FFh are reserved), 100h-1FFh data memory
#   20h-3Fh in the DS segment, 200h-3FFh SFRs 400h-43Fh. The PSWL flag bits are the flag
#   registers. bitloc exports the byte, bitnum the bit within it.

bitloc: xa8reg^"."^xa8bitd is lo2=0 ; xa8hi=0 & xa8reg & xa8bitd { export xa8reg; }
bitloc: a^"."^xa8bitd is lo2=1 ; xa8byte & xa8bitd & dsk=1 & dsv [ a = 0x20 + xa8byte; ] { local p:3 = (dsv << 16) | a; export *[data]:1 p; }
bitloc: a^"."^xa8bitd is lo2=1 ; xa8byte & xa8bitd & dsk=0 [ a = 0x20 + xa8byte; ] { local p:3 = segment(DS, a:2); export *[data]:1 p; }
bitloc: a^"."^xa8bitd is (lo2=2 | lo2=3) & lo2 ; xa8byte & xa8bitd [ a = 0x400 + ((lo2 & 1) << 5) + xa8byte; ] { export *[sfr]:1 a; }
bitloc: "Z"  is lo2=2 ; xa8=0x00 { export Z; }
bitloc: "N"  is lo2=2 ; xa8=0x01 { export N; }
bitloc: "V"  is lo2=2 ; xa8=0x02 { export V; }
bitloc: "PSWL."^xa8bitd is lo2=2 ; (xa8=0x03 | xa8=0x04 | xa8=0x05) & xa8bitd { export PSWL; }
bitloc: "AC" is lo2=2 ; xa8=0x06 { export AC; }
bitloc: "C"  is lo2=2 ; xa8=0x07 { export C; }
bitloc: "PSWH."^xa8bitd  is lo2=2 ; xa8byte=1 & xa8bitd { export PSWH; }
bitloc: "PSW51."^xa8bitd is lo2=2 ; xa8byte=2 & xa8bitd { export PSW51; }
bitloc: "SSEL."^xa8bitd  is lo2=2 ; xa8byte=3 & xa8bitd { export SSEL; }

bitnum: is lo2=2 ; (xa8=0x00 | xa8=0x01 | xa8=0x02 | xa8=0x06 | xa8=0x07) { export 0:1; }
bitnum: is lo2 ; xa8bit { export *[const]:1 xa8bit; }

macro getbit(loc, n, v) {
	v = (loc >> n) & 1;
}

macro putbit(loc, n, v) {
	loc = (loc & ~(1 << n)) | ((v & 1) << n);
}

# bit instructions: 08h, byte 2 = oooo 00bb, byte 3 = low bits of the bit address
:CLR bitloc is op=0x08 ; (hi4=0 & b32=0) ... & bitloc & bitnum { putbit(bitloc, bitnum, 0:1); }
:SETB bitloc is op=0x08 ; (hi4=1 & b32=0) ... & bitloc & bitnum { putbit(bitloc, bitnum, 1:1); }
:MOV "C", bitloc is op=0x08 ; (hi4=2 & b32=0) ... & bitloc & bitnum { local v:1 = 0; getbit(bitloc, bitnum, v); C = v; }
:MOV bitloc, "C" is op=0x08 ; (hi4=3 & b32=0) ... & bitloc & bitnum { putbit(bitloc, bitnum, C); }
:ANL "C", bitloc is op=0x08 ; (hi4=4 & b32=0) ... & bitloc & bitnum { local v:1 = 0; getbit(bitloc, bitnum, v); C = C & v; }
:ANL "C", "/"^bitloc is op=0x08 ; (hi4=5 & b32=0) ... & bitloc & bitnum { local v:1 = 0; getbit(bitloc, bitnum, v); C = C & (v ^ 1); }
:ORL "C", bitloc is op=0x08 ; (hi4=6 & b32=0) ... & bitloc & bitnum { local v:1 = 0; getbit(bitloc, bitnum, v); C = C | v; }
:ORL "C", "/"^bitloc is op=0x08 ; (hi4=7 & b32=0) ... & bitloc & bitnum { local v:1 = 0; getbit(bitloc, bitnum, v); C = C | (v ^ 1); }

# JB/JNB/JBC: 97h, byte 2 = 1oo0 00bb, byte 3 = bit address, byte 4 = rel8
:JB bitloc, rel8b is op=0x97 ; (b7=1 & hi3=0 & b32=0) ... & bitloc & bitnum ; rel8b {
	local v:1 = 0;
	getbit(bitloc, bitnum, v);
	if (v != 0) goto rel8b;
}
:JNB bitloc, rel8b is op=0x97 ; (b7=1 & hi3=2 & b32=0) ... & bitloc & bitnum ; rel8b {
	local v:1 = 0;
	getbit(bitloc, bitnum, v);
	if (v == 0) goto rel8b;
}
:JBC bitloc, rel8b is op=0x97 ; (b7=1 & hi3=4 & b32=0) ... & bitloc & bitnum ; rel8b {
	local v:1 = 0;
	getbit(bitloc, bitnum, v);
	if (v == 0) goto inst_next;
	putbit(bitloc, bitnum, 0:1);
	goto rel8b;
}

# ---------------------------------------------------------------------------- branches

cc: "CC" is op=0xf0 { local t:1 = (C == 0); export t; }
cc: "CS" is op=0xf1 { local t:1 = (C != 0); export t; }
cc: "NE" is op=0xf2 { local t:1 = (Z == 0); export t; }
cc: "EQ" is op=0xf3 { local t:1 = (Z != 0); export t; }
cc: "NV" is op=0xf4 { local t:1 = (V == 0); export t; }
cc: "OV" is op=0xf5 { local t:1 = (V != 0); export t; }
cc: "PL" is op=0xf6 { local t:1 = (N == 0); export t; }
cc: "MI" is op=0xf7 { local t:1 = (N != 0); export t; }
cc: "G"  is op=0xf8 { local t:1 = ((Z | C) == 0); export t; }
cc: "L"  is op=0xf9 { local t:1 = ((Z | C) != 0); export t; }
cc: "GE" is op=0xfa { local t:1 = ((N ^ V) == 0); export t; }
cc: "LT" is op=0xfb { local t:1 = ((N ^ V) != 0); export t; }
cc: "GT" is op=0xfc { local t:1 = (((Z | N) ^ V) == 0); export t; }
cc: "LE" is op=0xfd { local t:1 = (((Z | N) ^ V) != 0); export t; }

:B^cc rel8 is cc ; rel8 { if (cc) goto rel8; }
:BR rel8 is op=0xfe ; rel8 { goto rel8; }
:BKPT is op=0xff { breakpoint(); }
:NOP is op=0x00 { }

:JZ rel8 is op=0xec ; rel8 { if (R4L == 0) goto rel8; }
:JNZ rel8 is op=0xee ; rel8 { if (R4L != 0) goto rel8; }

:JMP rel16 is op=0xd5 ; rel16 { goto rel16; }
:CALL rel16 is op=0xc5 ; rel16 {
	local ret:3 = inst_next;
	pushpc(ret);
	call rel16;
}
:FJMP addr24 is op=0xd4 ; addr24 { goto addr24; }
:FCALL addr24 is op=0xc4 ; addr24 {
	local ret:3 = inst_next;
	pushpc(ret);
	call addr24;
}

:JMP "["^ps^"]" is op=0xd6 ; hi4=7 & b3=0 & ps {
	local t:3 = (inst_next & 0xff0000) | zext(ps & 0xfffe);
	goto [t];
}
:CALL "["^ps^"]" is op=0xc6 ; hi4=0 & b3=0 & ps {
	local t:3 = (inst_next & 0xff0000) | zext(ps & 0xfffe);
	local ret:3 = inst_next;
	pushpc(ret);
	call [t];
}
:JMP "[A+DPTR]" is op=0xd6 ; b2=0x46 {
	local t:3 = (inst_next & 0xff0000) | zext((zext(R4L) + R6) & 0xfffe);
	goto [t];
}
:JMP "[["^ps^"+]]" is op=0xd6 ; hi4=6 & b3=0 & ps & cseg_ps {
	local a:3 = (zext(cseg_ps) << 16) | zext(ps);
	local v:2 = *[code]:2 a;
	ps = ps + 2;
	local t:3 = (inst_next & 0xff0000) | zext(v & 0xfffe);
	goto [t];
}

:RET is op=0xd6 ; b2=0x80 {
	local t:3 = 0;
	poppc(t);
	return [t];
}
:RETI is op=0xd6 ; b2=0x90 {
	pop16(PSW);
	unpackflags();
	local t:3 = 0;
	poppc(t);
	return [t];
}
:RESET is op=0xd6 ; b2=0x10 {
	software_reset();
	local v0:3 = 0;
	PSW = *[code]:2 v0;
	unpackflags();
	local v2:3 = 2;
	local t:3 = zext(*[code]:2 v2 & 0xfffe);
	goto [t];
}
# TRAP #n: interrupt stack frame (PC, then PSW) on the system stack, PSW and target from the
# trap vector at 40h + 4n (user guide 4.8.2)
:TRAP "#"^imm4 is op=0xd6 ; hi4=3 & imm4 {
	local ret:3 = inst_next;
	pushpc(ret);
	packflags();
	push16(PSW);
	local va:3 = 0x40 + imm4 * 4;
	PSW = *[code]:2 va;
	unpackflags();
	local vb:3 = va + 2;
	local t:3 = zext(*[code]:2 vb & 0xfffe);
	call [t];
}

@include "xa_gen.sinc"
