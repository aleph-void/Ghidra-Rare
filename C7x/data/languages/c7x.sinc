# TI C7000 (C7x) DSP -- SLEIGH core
#
# Hand-written part: address spaces, context (execute-packet state), packet/predicate plumbing,
# constant-extension and condition-extension slots, branch/call/return instructions.
# The bulk of the instruction set (c7x_gen.sinc) is generated by gen/gen.py from an encoding
# database derived black-box from TI's asm7x/dis7x (see README.md).
#
# Including slaspec must define:  SIL (silicon version: 7100/7120/7504/7524; selects the generated
# c7x_*_SIL.sinc files), VLEN (vector register size in bytes: 64 or 32), ENDIAN.

define endian=$(ENDIAN);
define alignment=4;

define space ram      type=ram_space      size=8 default;
define space register type=register_space size=4;

@if SIL == "7100"
@include "c7x_regs_7100.sinc"
@endif
@if SIL == "7120"
@include "c7x_regs_7120.sinc"
@endif
@if SIL == "7504"
@include "c7x_regs_7504.sinc"
@endif
@if SIL == "7524"
@include "c7x_regs_7524.sinc"
@endif

# Execute-packet context.  Every instruction whose p-bit is set forwards the packet state to the
# next word (globalset to inst_next); all fields are noflow so a packet boundary (p-bit clear)
# resets them to zero.
#   inpkt        : this word is not the first of its execute packet (display "||")
#   cx0/cx1      : 27-bit payloads of CSTX0/CSTX1 constant-extension slots seen so far in the packet
#   cc0v/cc1v    : a CCEXT0/CCEXT1 condition-extension slot was seen; ccXX are the per-unit CREGZ nibbles
define register offset=0xf000 size=16 contextreg;
define context contextreg
  cx0   = (0,26)   noflow
  cx0v  = (27,27)  noflow
  cx1v  = (28,28)  noflow
  inpkt = (29,29)  noflow
  cc0v  = (30,30)  noflow
  cc1v  = (31,31)  noflow
  cx1   = (32,58)  noflow
  ccL1  = (64,67)  noflow
  ccL2  = (68,71)  noflow
  ccS1  = (72,75)  noflow
  ccS2  = (76,79)  noflow
  ccD1  = (80,83)  noflow
  ccD2  = (84,87)  noflow
  ccM1  = (96,99)  noflow
  ccM2  = (100,103) noflow
  ccC   = (104,107) noflow
  ccP   = (108,111) noflow
  ccN1  = (112,115) noflow
  ccN2  = (116,119) noflow
;

@if SIL == "7100"
@include "c7x_fields_7100.sinc"
@endif
@if SIL == "7120"
@include "c7x_fields_7120.sinc"
@endif
@if SIL == "7504"
@include "c7x_fields_7504.sinc"
@endif
@if SIL == "7524"
@include "c7x_fields_7524.sinc"
@endif

# ------------------------------------------------------------------ pcodeops
define pcodeop bnl_taken;          # BNL: nested-loop controller decides
define pcodeop software_call;      # SYSCALL/SECCALL/ROOTCALL
define pcodeop secure_return;      # RETS
@if SIL == "7100"
@include "c7x_ops_7100.sinc"
@endif
@if SIL == "7120"
@include "c7x_ops_7120.sinc"
@endif
@if SIL == "7504"
@include "c7x_ops_7504.sinc"
@endif
@if SIL == "7524"
@include "c7x_ops_7524.sinc"
@endif

# ------------------------------------------------------------------ packet plumbing
PAR: "||" is inpkt=1 { }
PAR:      is inpkt=0 { }

PKT: is pbit=1 [ inpkt = 1;
                 globalset(inst_next, inpkt);
                 globalset(inst_next, cx0);  globalset(inst_next, cx0v);
                 globalset(inst_next, cx1);  globalset(inst_next, cx1v);
                 globalset(inst_next, cc0v); globalset(inst_next, cc1v);
                 globalset(inst_next, ccL1); globalset(inst_next, ccL2);
                 globalset(inst_next, ccS1); globalset(inst_next, ccS2);
                 globalset(inst_next, ccD1); globalset(inst_next, ccD2);
                 globalset(inst_next, ccM1); globalset(inst_next, ccM2);
                 globalset(inst_next, ccC);  globalset(inst_next, ccP);
                 globalset(inst_next, ccN1); globalset(inst_next, ccN2); ] { }
PKT: is pbit=0 { }


# ------------------------------------------------------------------ constant / condition extension slots
instr: "CSTX0:" b5_31 is pbit=1 & b0_4=0x17 & b5_31 [ cx0 = b5_31; cx0v = 1; ] { }
instr: "CSTX1:" b5_31 is pbit=1 & b0_4=0x1f & b5_31 [ cx1 = b5_31; cx1v = 1; ] { }
instr: "CCEXT0:" b0_31 is pbit=1 & b0_6=0x1d & b0_31 & b28_31 & b24_27 & b20_23 & b16_19 & b12_15 & b8_11
       [ ccL1 = b28_31; ccL2 = b24_27; ccS1 = b20_23; ccS2 = b16_19; ccD1 = b12_15; ccD2 = b8_11; cc0v = 1; ] { }
instr: "CCEXT1:" b0_31 is pbit=1 & b0_6=0x5d & b0_31 & b28_31 & b24_27 & b20_23 & b16_19 & b12_15 & b8_11
       [ ccM1 = b28_31; ccM2 = b24_27; ccC = b20_23; ccP = b16_19; ccN1 = b12_15; ccN2 = b8_11; cc1v = 1; ] { }

# ------------------------------------------------------------------ branches (.B unit)
# BRK format:     creg[31:28] E[27] cst19[26:8] opc[7:5] 11110   (B/BE 010, CALL/CALLE 011, BNL 001)
# BRK-NC format:  cst24[31:8] opc[7:5] 11110                     (B 100, CALL 101)
# BRO format:     creg[31:28] .. opc[13:10] 00000 11110          (RET 0011, RETS 0100)
BCOND: "[A0]"  is b28_31=0x2 { if (A0 == 0) goto inst_next; }
BCOND: "[!A0]" is b28_31=0x3 { if (A0 != 0) goto inst_next; }
BCOND: "[A1]"  is b28_31=0x4 { if (A1 == 0) goto inst_next; }
BCOND: "[!A1]" is b28_31=0x5 { if (A1 != 0) goto inst_next; }
BCOND: "[A2]"  is b28_31=0x6 { if (A2 == 0) goto inst_next; }
BCOND: "[!A2]" is b28_31=0x7 { if (A2 != 0) goto inst_next; }
BCOND: "[A3]"  is b28_31=0x8 { if (A3 == 0) goto inst_next; }
BCOND: "[!A3]" is b28_31=0x9 { if (A3 != 0) goto inst_next; }
BCOND: "[A4]"  is b28_31=0xa { if (A4 == 0) goto inst_next; }
BCOND: "[!A4]" is b28_31=0xb { if (A4 != 0) goto inst_next; }
BCOND: "[A5]"  is b28_31=0xc { if (A5 == 0) goto inst_next; }
BCOND: "[!A5]" is b28_31=0xd { if (A5 != 0) goto inst_next; }
BCOND:         is b28_31=0x0 { }

BT19: dest is s8_26 [ dest = (inst_start & 0xffffffffffffffc0) + s8_26 * 4; ] { export *:8 dest; }
BT24: dest is s8_31 [ dest = (inst_start & 0xffffffffffffffc0) + s8_31 * 4; ] { export *:8 dest; }

# E=1 (BE/CALLE): the 19-bit offset is unsigned and is extended by CSTX0 (offset = (cstx0:cst19) << 2)
BT19E: dest is b8_26 & cx0v=0 [ dest = (inst_start & 0xffffffffffffffc0) + (b8_26 << 2); ] { export *:8 dest; }
BT19E: dest is b8_26 & cx0v=1 & cx0 [ dest = (inst_start & 0xffffffffffffffc0) + ((((cx0 << 19) | b8_26) << 2) & 0xffffffff); ] { export *:8 dest; }

instr: BCOND^"B" ".B1" BT19 is pbit=0 & b0_4=0x1e & b5_7=2 & b27_27=0 & BCOND & BT19
{ build BCOND; goto BT19; }
instr: BCOND^"BE" ".B1" BT19E is pbit=0 & b0_4=0x1e & b5_7=2 & b27_27=1 & BCOND & BT19E
{ build BCOND; goto BT19E; }
instr: BCOND^"CALL" ".B1" BT19 is pbit=0 & b0_4=0x1e & b5_7=3 & b27_27=0 & BCOND & BT19
{ build BCOND; RP = inst_next; call BT19; }
instr: BCOND^"CALLE" ".B1" BT19E is pbit=0 & b0_4=0x1e & b5_7=3 & b27_27=1 & BCOND & BT19E
{ build BCOND; RP = inst_next; call BT19E; }
instr: "BNL" ".B1" BT19 is pbit=0 & b0_4=0x1e & b5_7=1 & b27_31=0 & BT19
{ c:1 = bnl_taken(); if (c) goto BT19; }
instr: "B" ".B1" BT24 is pbit=0 & b0_4=0x1e & b5_7=4 & BT24 { goto BT24; }
instr: "CALL" ".B1" BT24 is pbit=0 & b0_4=0x1e & b5_7=5 & BT24 { RP = inst_next; call BT24; }

instr: BCOND^"RET" ".B1"  is pbit=0 & b0_9=0x1e & b10_13=3 & b14_27=0 & BCOND { build BCOND; return [RP]; }
instr: BCOND^"RETS" ".B1" is pbit=0 & b0_9=0x1e & b10_13=4 & b14_27=0 & BCOND { build BCOND; secure_return(); return [RP]; }

# ------------------------------------------------------------------ hand-written groups
# Second view of the instruction word for the hand-written constructors below.
define token IW(32)
  w_pbit = (0,0)
  w_lo   = (0,13)
  w_op   = (14,19)
  w_arg  = (20,25)
  w_arg5 = (20,24)
  w_hi   = (26,31)
  w_hi2  = (25,31)
  w_rlo  = (14,17)
  w_rgrp = (18,19)
  w_rA   = (14,17)
  w_rB   = (14,17)
  w_rAL  = (14,17)
  # MVCI fields
  m_lo   = (1,13)
  m_s    = (14,17)
  m_sB   = (14,17)
  m_sAL  = (14,17)
  m_sg   = (18,19)
  m_c5a  = (20,24)
  m_c5b  = (26,30)
  m_b24  = (24,24)
  m_b25  = (25,25)
  m_b31  = (31,31)
  m_dA0  = (20,23)
  m_dAL0 = (20,23)
  m_dA1  = (26,29)
  m_dD1  = (26,29)
  m_dAM1 = (26,29)
  m_dAL1 = (26,29)
  m_dg   = (30,31)
;
attach variables [ w_rA ]  [ A0 A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15 ];
attach variables [ w_rB ]  [ B0 B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 B12 B13 B14 B15 ];
attach variables [ w_rAL ] [ AL0 AL1 AL2 AL3 AL4 AL5 AL6 AL7 AL8 AL9 AL10 AL11 AL12 AL13 AL14 AL15 ];
attach variables [ m_s m_dA0 m_dA1 ] [ A0 A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15 ];
attach variables [ m_sB ] [ B0 B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 B12 B13 B14 B15 ];
attach variables [ m_sAL m_dAL0 m_dAL1 ] [ AL0 AL1 AL2 AL3 AL4 AL5 AL6 AL7 AL8 AL9 AL10 AL11 AL12 AL13 AL14 AL15 ];
attach variables [ m_dD1 ] [ D0 D1 D2 D3 D4 D5 D6 D7 D8 D9 D10 D11 D12 D13 D14 D15 ];
attach variables [ m_dAM1 ] [ AM0 AM1 AM2 AM3 AM4 AM5 AM6 AM7 AM8 AM9 AM10 AM11 AM12 AM13 AM14 AM15 ];
attach variables [ m_c5a m_c5b ] [ CPUID PMR DNUM TSC TSR RP BPCR FPCR FSR ECLMR EASGR EPRI EER EESET EECLR DEPR
                                   EFR EFSET EFCLR IESET ESTP_SS ESTP_S ESTP_GS EDR ECSP_SS ECSP_S ECSP_GS TCSP
                                   RXMR_SS RXMR_S AHPEE PHPEE ];

# unit-less group: op[19:14] arg[25:20] 0x84e (with p-bit)
define pcodeop idle;
define pcodeop protect;
define pcodeop unprotect;
define pcodeop tick;
define pcodeop exception_handler;
define pcodeop iinval;
define pcodeop mtag;
define pcodeop software_breakpoint;
define pcodeop debug;
define pcodeop mark;
define pcodeop mfence;
define pcodeop mfencest;

NOPN: val is w_arg [ val = w_arg + 1; ] { export *[const]:8 val; }
MMUSEL: "MMUNONE" is w_arg=0 { export 0:1; }
MMUSEL: "MMU0"    is w_arg=1 { export 1:1; }
MMUSEL: "MMU1"    is w_arg=2 { export 2:1; }
MMUSEL: "MMUALL"  is w_arg=3 { export 3:1; }
COLOR:  "COLOR0"  is w_arg=0 { export 0:1; }
COLOR:  "COLOR1"  is w_arg=1 { export 1:1; }
MCOLOR: "SWITCH_COLOR" is w_arg=0x1f { export 0x1f:1; }
MCOLOR: COLOR is COLOR { export COLOR; }
FCOLOR: "ALL_COLORS" is w_arg=0x1f { export 0x1f:1; }
FCOLOR: COLOR is COLOR { export COLOR; }

instr: "NOP" NOPN       is (w_lo=0x84e | w_lo=0x84f) & w_op=0x00 & w_hi=0 & NOPN { }
instr: "IDLE"           is (w_lo=0x84e | w_lo=0x84f) & w_op=0x01 & w_arg=0 & w_hi=0 { idle(); }
instr: "PROTCLR"        is (w_lo=0x84e | w_lo=0x84f) & w_op=0x02 & w_arg=0 & w_hi=0 { protect(0:1); }
instr: "TICK"           is (w_lo=0x84e | w_lo=0x84f) & w_op=0x03 & w_arg=0 & w_hi=0 { tick(); }
instr: "EHDL"           is (w_lo=0x84e | w_lo=0x84f) & w_op=0x04 & w_arg=0 & w_hi=0 { exception_handler(0:1); }
instr: "IINVAL" MMUSEL  is (w_lo=0x84e | w_lo=0x84f) & w_op=0x05 & w_hi=0 & MMUSEL { iinval(MMUSEL); }
instr: "MTAG" MCOLOR    is (w_lo=0x84e | w_lo=0x84f) & w_op=0x06 & w_hi=0 & MCOLOR { mtag(MCOLOR); }
instr: "DHDL"           is (w_lo=0x84e | w_lo=0x84f) & w_op=0x07 & w_arg=0 & w_hi=0 { exception_handler(1:1); }
instr: "PROT"           is (w_lo=0x84e | w_lo=0x84f) & w_op=0x08 & w_arg=0 & w_hi=0 { protect(1:1); }
instr: "UNPROT" w_arg   is (w_lo=0x84e | w_lo=0x84f) & w_op=0x09 & w_hi=0 & w_arg { unprotect(w_arg:1); }
instr: "DSWBP"          is (w_lo=0x84e | w_lo=0x84f) & w_op=0x0a & w_arg=0 & w_hi=0 { software_breakpoint(0:1); }
instr: "ESWBP"          is (w_lo=0x84e | w_lo=0x84f) & w_op=0x0c & w_arg=0 & w_hi=0 { software_breakpoint(1:1); }
instr: "DDBG"           is (w_lo=0x84e | w_lo=0x84f) & w_op=0x0d & w_arg=0 & w_hi=0 { debug(0:1); }
instr: "MARK" w_arg5    is (w_lo=0x84e | w_lo=0x84f) & w_op=0x0e & w_hi2=0 & w_arg5 { mark(w_arg5:1); }
instr: "EDBG"           is (w_lo=0x84e | w_lo=0x84f) & w_op=0x0f & w_arg=0 & w_hi=0 { debug(1:1); }
instr: "MFENCE" FCOLOR  is (w_lo=0x84e | w_lo=0x84f) & w_op=0x10 & w_hi=0 & FCOLOR { mfence(FCOLOR); }
instr: "MFENCEST" FCOLOR is (w_lo=0x84e | w_lo=0x84f) & w_op=0x11 & w_hi=0 & FCOLOR { mfencest(FCOLOR); }

# MVCI (.S1): two operand orders selected by bit 6 (derived black-box from dis7x)
#   bit6=1: MVCI ctrl,src,dst   ctrl[24:20] (bit25=1), src[19:14], dst[31:26] (A/D/AM/AL)
#   bit6=0: MVCI src,ctrl,dst   src[19:14], ctrl[30:26] (bit31=1), dst[23:20] (+bit25: A/AL, bit24=0)
define pcodeop mvci;

MSRC: m_s   is m_sg=0 & m_s   { export m_s; }
MSRC: m_sB  is m_sg=1 & m_sB  { export m_sB; }
MSRC: m_sAL is m_sg=2 & m_sAL { export m_sAL; }
MUNIT: ".S1X" is m_sg=1 { }
MUNIT: ".S1"  is m_sg=0 { }
MUNIT: ".S1"  is m_sg=2 { }
MDST1: m_dA1  is m_dg=0 & m_dA1  { export m_dA1; }
MDST1: m_dD1  is m_dg=1 & m_dD1  { export m_dD1; }
MDST1: m_dAM1 is m_dg=2 & m_dAM1 { export m_dAM1; }
MDST1: m_dAL1 is m_dg=3 & m_dAL1 { export m_dAL1; }
MDST0: m_dA0  is m_b24=0 & m_b25=0 & m_dA0  { export m_dA0; }
MDST0: m_dAL0 is m_b24=0 & m_b25=1 & m_dAL0 { export m_dAL0; }
# condition-extension predicate for the .S1 slot
CCS1:          is cc0v=0 { }
CCS1:          is cc0v=1 & ccS1=0 { }
CCS1: "[A0]"   is cc0v=1 & ccS1=2  { if (A0 == 0) goto inst_next; }
CCS1: "[!A0]"  is cc0v=1 & ccS1=3  { if (A0 != 0) goto inst_next; }
CCS1: "[A1]"   is cc0v=1 & ccS1=4  { if (A1 == 0) goto inst_next; }
CCS1: "[!A1]"  is cc0v=1 & ccS1=5  { if (A1 != 0) goto inst_next; }
CCS1: "[A2]"   is cc0v=1 & ccS1=6  { if (A2 == 0) goto inst_next; }
CCS1: "[!A2]"  is cc0v=1 & ccS1=7  { if (A2 != 0) goto inst_next; }
CCS1: "[A3]"   is cc0v=1 & ccS1=8  { if (A3 == 0) goto inst_next; }
CCS1: "[!A3]"  is cc0v=1 & ccS1=9  { if (A3 != 0) goto inst_next; }
CCS1: "[A4]"   is cc0v=1 & ccS1=10 { if (A4 == 0) goto inst_next; }
CCS1: "[!A4]"  is cc0v=1 & ccS1=11 { if (A4 != 0) goto inst_next; }
CCS1: "[A5]"   is cc0v=1 & ccS1=12 { if (A5 == 0) goto inst_next; }
CCS1: "[!A5]"  is cc0v=1 & ccS1=13 { if (A5 != 0) goto inst_next; }
instr: CCS1^"MVCI" MUNIT m_c5a^","^MSRC^","^MDST1 is m_lo=0x1432 & m_b25=1 & CCS1 & MUNIT & m_c5a & MSRC & MDST1
{ build CCS1; local t:8 = mvci(m_c5a, MSRC); MDST1 = t; }
instr: CCS1^"MVCI" MUNIT MSRC^","^m_c5b^","^MDST0 is m_lo=0x1412 & m_b31=1 & CCS1 & MUNIT & m_c5b & MSRC & MDST0
{ build CCS1; local t:8 = mvci(MSRC, m_c5b); MDST0 = t; }

# indirect branch / call on .S1:  src[19:14] (A0-A15, B0-B15 via cross path, AL0-AL15)
BAREG: w_rA  is w_rgrp=0 & w_rA  { export w_rA; }
BAREG: w_rAL is w_rgrp=2 & w_rAL { export w_rAL; }
BAX:   ".S1"  is w_rgrp=0 { }
BAX:   ".S1"  is w_rgrp=2 { }
instr: "BA" ".S1X" w_rB    is w_lo=0x0004 & w_arg=0x04 & w_hi=0 & w_rgrp=1 & w_rB { goto [w_rB]; }
instr: "BA" BAX BAREG      is w_lo=0x0004 & w_arg=0x04 & w_hi=0 & BAX & BAREG { goto [BAREG]; }
instr: "CALLA" ".S1X" w_rB is w_lo=0x0044 & w_arg=0x04 & w_hi=0 & w_rgrp=1 & w_rB { local t:8 = w_rB; RP = inst_next; call [t]; }
instr: "CALLA" BAX BAREG   is w_lo=0x0044 & w_arg=0x04 & w_hi=0 & BAX & BAREG { local t:8 = BAREG; RP = inst_next; call [t]; }

@if SIL == "7100"
@include "c7x_gen_7100.sinc"
@endif
@if SIL == "7120"
@include "c7x_gen_7120.sinc"
@endif
@if SIL == "7504"
@include "c7x_gen_7504.sinc"
@endif
@if SIL == "7524"
@include "c7x_gen_7524.sinc"
@endif

# ------------------------------------------------------------------ root
:^PAR^instr^PKT is PAR & instr & PKT { build instr; }
