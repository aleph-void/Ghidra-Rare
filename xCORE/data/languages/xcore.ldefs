  <language processor="xCORE" endian="little" size="32" variant="XS2" version="1.0"
            slafile="xcore_xs2.sla" processorspec="xcore.pspec" id="xCORE:LE:32:XS2">
    <description>XMOS xCORE XS2 (xCORE-200): dual issue, double-word load/store, long arithmetic extensions</description>
    <compiler name="default" spec="xcore.cspec" id="default"/>
    <external_name tool="DWARF.register.mapping.file" name="xcore.dwarf"/>
  </language>
  <language processor="xCORE" endian="little" size="32" variant="XS1" version="1.0"
