<opinions>
  <!-- EM_XCORE = 203 (0xCB); 0xB49E is the pre-registration XMOS value. XS3 is preferred because
       it is the current architecture; select XS1/XS2 manually for older firmware. -->
  <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
    <constraint primary="203"   processor="xCORE" endian="little" size="32" variant="XS3"/>
    <constraint primary="46238" processor="xCORE" endian="little" size="32" variant="XS3"/>
  </constraint>
</opinions>
