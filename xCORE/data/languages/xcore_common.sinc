# XMOS xCORE common definitions (shared by XS1, XS2 and XS3 specifications).
#
# Instructions are a stream of 16-bit little-endian halfwords; 32-bit ("long") forms are
# two halfwords where the halfword at the lower address is a prefix / operand word.

define endian=little;
define alignment=2;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

# Operand registers r0..r11 plus the four pointer registers that share the 4-bit encoding space.
define register offset=0x00 size=4 [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 cp dp sp lr ];

# Program counter, status register and kernel/exception state registers.
define register offset=0x40 size=4 [ pc sr ed et kep ksp spc ssr sed dspc dssr dssp ];

# XS3 vector unit: 256-bit vR/vD/vC, vector control (vSR) and headroom (vH) registers.
define register offset=0x100 size=32 [ vR vD vC ];
define register offset=0x180 size=4  [ vSR vH ];

define register offset=0x200 size=4 [ contextreg ];

