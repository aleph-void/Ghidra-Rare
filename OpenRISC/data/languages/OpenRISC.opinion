<opinions>
  <!-- EM_OPENRISC = 92 (0x5c); the pre-standard 0x8472 (EM_OR1K) was used by early
       toolchains. GNU or1k toolchains produce big-endian ELF with delay slots; a
       little-endian ELF selects the little-endian (no delay slot) language. -->
  <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
    <constraint primary="92" processor="OpenRISC" endian="big" size="32" />
    <constraint primary="92" processor="OpenRISC" endian="little" size="32" />
    <constraint primary="33906" processor="OpenRISC" endian="big" size="32" />
  </constraint>
</opinions>
