<?xml version="1.0" encoding="UTF-8"?>

<language_definitions>
  <language processor="OpenRISC"
            endian="little"
            size="32"
            variant="default"
            version="1.0"
            slafile="OpenRISC-le.sla"
            processorspec="OpenRISC.pspec"
            id="OpenRISC:LE:32:default">
    <description>OpenRISC 1000 ORBIS32 LE, no delay slot (hx330x)</description>
    <compiler name="default" spec="OpenRISC.cspec" id="default" />
    <external_name tool="gnu" name="or1knd" />
    <external_name tool="DWARF.register.mapping.file" name="OpenRISC.dwarf" />
  </language>
  <language processor="OpenRISC"
            endian="big"
            size="32"
            variant="default"
            version="1.0"
            slafile="OpenRISC.sla"
            processorspec="OpenRISC.pspec"
            id="OpenRISC:BE:32:default">
    <description>OpenRISC 1000 ORBIS32 BE</description>
    <compiler name="default" spec="OpenRISC.cspec" id="default" />
    <external_name tool="gnu" name="or1k" />
    <external_name tool="DWARF.register.mapping.file" name="OpenRISC.dwarf" />
  </language>
</language_definitions>
