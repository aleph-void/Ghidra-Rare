# OpenRISC ORBIS32 Instruction Set, v1.3

#
# Delay slot handling. With a delay slot the link address is the instruction after the delay
# slot (jump + 8); without one (CPUCFGR[ND]) it is jump + 4 (arch manual 1.4, l.jal/l.jalr).
# In SLEIGH, inst_next of an instruction with a delay slot already points past the delay slot,
# so the link address is inst_next in both cases.
#
@ifdef NO_DELAY_SLOT
@define DELAY_SLOT ""
@else
@define DELAY_SLOT "delayslot(1);"
@endif
@define LINK_ADDR "inst_next"

#
# Macros
#
macro halfAdd(result, left, right) {
	CY = carry(left, right);
	OV = scarry(left, right);
	result = left + right;
}

macro fullAdd(result, left, right) {
	local carry = zext(CY);
	halfAdd(result, left, right);
	CY = CY || carry(result, carry);
	OV = OV ^^ scarry(result, carry);
	result = result + carry;
}

macro halfSub(result, left, right) {
	CY = left < right;
	OV = sborrow(left, right);
	result = left - right;
}

macro mul64s(result, left, right) {
	local left_ext:8  = sext(left);
	local right_ext:8 = sext(right);
	result = left_ext * right_ext;
}

macro mul64z(result, left, right) {
	local left_ext:8  = zext(left);
	local right_ext:8 = zext(right);
	result = left_ext * right_ext;
}

macro getmac(var) {
	var = zext(MACHI) << 32 | zext(MACLO);
}

macro setmac(var) {
	MACHI = var(4);
	MACLO = var:4;
}

#
# Custom operations
#
define pcodeop csync;
define pcodeop msync;
define pcodeop psync;

define pcodeop cust1;
define pcodeop cust2;
define pcodeop cust3;
define pcodeop cust4;
define pcodeop cust5;
define pcodeop cust6;
define pcodeop cust7;
define pcodeop cust8;

define pcodeop syscall;
define pcodeop trap;

#
# Operands
#
iI: imm16 is imm16 {
	local val:4 = imm16;
	export val;
}

iK: uimm16 is uimm16 {
	local val:4 = uimm16;
	export val;
}

# 6-bit shift amount as encoded (binutils prints all 6 bits); a 32-bit core uses the low 5
iL: uimm6 is uimm6 {
	local val:4 = uimm6 & 0x1f;
	export val;
}

mB: imm16(rA) is imm16 & rA {
	local ea = rA + imm16;
	export ea;
}

mD: offset(rA) is rA & imm16a & imm16b [ offset = imm16a << 11 | imm16b; ] {
	local ea = rA + offset;
	export ea;
}

mN: ea is imm26 [ ea = (imm26 << 2) + inst_start; ] {
	export *:4 ea;
}

# l.adrp: rD <- (PC & ~0x1fff) + exts(N << 13); shown as the resolved page address
mNadrp: page is imm21 [ page = ((imm21 << 13) + (inst_start & 0xffffe000)) & 0xffffffff; ] {
	export *[const]:4 page;
}

sprD: ea is uimm16a & uimm16b [ ea = uimm16a << 11 | uimm16b; ] {
	local tmp:4 = ea;
	export tmp;
}

#
# Instructions
#
# Decoding follows the binutils 2.45 opcode masks (opcodes/or1k-opc.c): reserved bits that
# binutils requires to be zero must be zero here too.
#
:l.j mN is opcode = 0x0 & mN {
	$(DELAY_SLOT)
	goto mN;
}

:l.jal mN is opcode = 0x1 & mN {
	r9 = $(LINK_ADDR);
	$(DELAY_SLOT)
	call mN;
}

# PIC code reads the PC with "l.jal 8" (to the instruction after the delay slot; "l.jal 4"
# without a delay slot), e.g. before adding the GOT offset to r9. That is not a call: model
# it as setting r9 and falling through, or every PIC function would be split in two.
@ifdef NO_DELAY_SLOT
:l.jal mN is opcode = 0x1 & imm26 = 1 & mN {
	r9 = inst_next;
}
@else
:l.jal mN is opcode = 0x1 & imm26 = 2 & mN {
	r9 = inst_next;
	delayslot(1);
}
@endif

:l.adrp rD, mNadrp is opcode = 0x2 & rD & mNadrp {
	rD = mNadrp;
}

:l.bnf mN is opcode = 0x3 & mN {
	local flag = F;
	$(DELAY_SLOT)
	if (!flag) goto mN;
}

:l.bf mN is opcode = 0x4 & mN {
	local flag = F;
	$(DELAY_SLOT)
	if (flag) goto mN;
}

:l.nop iK is opcode = 0x5 & op5code = 0x1 & f_16_23 = 0 & iK {}

with : opcode = 0x6 & f_17_20 = 0 {
	:l.movhi rD, iK is op6code = 0x0 & rD & iK {
		rD = iK << 16;
	}

	:l.macrc rD is op6code = 0x1 & uimm16 = 0x0 & rD {
		rD = MACLO;
		MACLO = 0;
		MACHI = 0;
	}
}

with : opcode = 0x8 {
	# Linux: l.sys 1 with the system call number in r11, arguments in r3..r8, result in r11.
	# The exception handler returns to the next instruction, so this falls through.
	:l.sys iK is op8code = 0x000 & iK {
		EPCR0 = inst_next;
		r11 = syscall(iK, r11, r3, r4, r5, r6, r7, r8);
	}

	# Breakpoints and gcc's __builtin_trap(); a debugger may resume after it.
	:l.trap iK is op8code = 0x100 & iK {
		EPCR0 = inst_start;
		trap(iK);
	}

	:l.msync is op8code = 0x200 & uimm16 = 0x0 { msync(); }
	:l.psync is op8code = 0x280 & uimm16 = 0x0 { psync(); }
	:l.csync is op8code = 0x300 & uimm16 = 0x0 { csync(); }
}

:l.rfe is opcode = 0x9 & imm26 = 0 {
	SR = ESR0;
	return [EPCR0];
}

:l.jr rB is opcode = 0x11 & op8code = 0 & f_0_10 = 0 & rB {
	local ea = rB;
	$(DELAY_SLOT)
	goto [ea];
}

:l.jr rB is opcode = 0x11 & op8code = 0 & f_0_10 = 0 & rB & f_11_15 = 9 {
	local ea = rB;
	$(DELAY_SLOT)
	return [ea];
}

:l.jalr rB is opcode = 0x12 & op8code = 0 & f_0_10 = 0 & rB {
	local ea = rB;
	r9 = $(LINK_ADDR);
	$(DELAY_SLOT)
	call [ea];
}

:l.maci rA, iI is opcode = 0x13 & f_21_25 = 0 & rA & iI {
	local previous;
	local result;
	getmac(previous);
	mul64s(result, rA, iI);
	OV = scarry(previous, result);
	result = previous + result;
	setmac(result);
}

:l.lf  rD, mB is opcode = 0x1a & rD & mB { rD = *:4 mB; }
:l.lwa rD, mB is opcode = 0x1b & rD & mB { rD = *:4 mB; }

:l.cust1 is opcode = 0x1c & imm26 = 0 { cust1(); }
:l.cust2 is opcode = 0x1d & imm26 = 0 { cust2(); }
:l.cust3 is opcode = 0x1e & imm26 = 0 { cust3(); }
:l.cust4 is opcode = 0x1f & imm26 = 0 { cust4(); }

:l.lwz rD, mB is opcode = 0x21 & rD & mB { rD = *:4 mB; }
:l.lws rD, mB is opcode = 0x22 & rD & mB { rD = *:4 mB; }
:l.lbz rD, mB is opcode = 0x23 & rD & mB { rD = zext(*:1 mB); }
:l.lbs rD, mB is opcode = 0x24 & rD & mB { rD = sext(*:1 mB); }
:l.lhz rD, mB is opcode = 0x25 & rD & mB { rD = zext(*:2 mB); }
:l.lhs rD, mB is opcode = 0x26 & rD & mB { rD = sext(*:2 mB); }

:l.addi  rD, rA, iI is opcode = 0x27 & rD & rA & iI { halfAdd(rD, rA, iI); }
:l.addic rD, rA, iI is opcode = 0x28 & rD & rA & iI { fullAdd(rD, rA, iI); }
:l.andi  rD, rA, iK is opcode = 0x29 & rD & rA & iK { rD = rA & iK; }
:l.ori   rD, rA, iK is opcode = 0x2a & rD & rA & iK { rD = rA | iK; }
:l.xori  rD, rA, iI is opcode = 0x2b & rD & rA & iI { rD = rA ^ iI; }

:l.muli  rD, rA, iI is opcode = 0x2c & rD & rA & iI {
	local result;
	mul64s(result, rA, iI);
	OV = result s> 0x7fffffff || result s< -0x80000000;
	rD = result:4;
}

:l.mfspr rD, rA, iK is opcode = 0x2d & rD & rA & iK {
	local ea = rA | iK;
	rD = *[register]ea;
}

with : opcode = 0x2e & f_8_15 = 0 {
	:l.slli rD, rA, uimm6 is mod = 0x0 & rD & rA & uimm6 & iL { rD = rA  << iL; }
	:l.srli rD, rA, uimm6 is mod = 0x1 & rD & rA & uimm6 & iL { rD = rA  >> iL; }
	:l.srai rD, rA, uimm6 is mod = 0x2 & rD & rA & uimm6 & iL { rD = rA s>> iL; }
	:l.rori rD, rA, uimm6 is mod = 0x3 & rD & rA & uimm6 & iL { rD = (rA >> iL) | (rA << ((32 - iL) & 0x1f)); }
}

with : opcode = 0x2f {
	:l.sfeqi  rA, iI is cond = 0x0 & rA & iI { F = rA  == iI; }
	:l.sfnei  rA, iI is cond = 0x1 & rA & iI { F = rA  != iI; }
	:l.sfgtui rA, iI is cond = 0x2 & rA & iI { F = rA  >  iI; }
	:l.sfgeui rA, iI is cond = 0x3 & rA & iI { F = rA  >= iI; }
	:l.sfltui rA, iI is cond = 0x4 & rA & iI { F = rA  <  iI; }
	:l.sfleui rA, iI is cond = 0x5 & rA & iI { F = rA  <= iI; }
	:l.sfgtsi rA, iI is cond = 0xa & rA & iI { F = rA s>  iI; }
	:l.sfgesi rA, iI is cond = 0xb & rA & iI { F = rA s>= iI; }
	:l.sfltsi rA, iI is cond = 0xc & rA & iI { F = rA s<  iI; }
	:l.sflesi rA, iI is cond = 0xd & rA & iI { F = rA s<= iI; }
}

:l.mtspr rA, rB, sprD is opcode = 0x30 & rA & rB & sprD {
	local ea = rA | sprD;
	*[register]ea = rB;
}

with : opcode = 0x31 & f_21_25 = 0 {
	:l.mac rA, rB is f_0_10 = 0x1 & rA & rB {
		local previous;
		local result;
		getmac(previous);
		mul64s(result, rA, rB);
		OV = scarry(previous, result);
		result = previous + result;
		setmac(result);
	}

	:l.msb rA, rB is f_0_10 = 0x2 & rA & rB {
		local previous;
		local result;
		getmac(previous);
		mul64s(result, rA, rB);
		OV = sborrow(previous, result);
		result = previous - result;
		setmac(result);
	}

	:l.macu rA, rB is f_0_10 = 0x3 & rA & rB {
		local previous;
		local result;
		getmac(previous);
		mul64z(result, rA, rB);
		CY = carry(previous, result);
		result = previous + result;
		setmac(result);
	}

	:l.msbu rA, rB is f_0_10 = 0x4 & rA & rB {
		local previous;
		local result;
		getmac(previous);
		mul64z(result, rA, rB);
		CY = previous < result;
		result = previous - result;
		setmac(result);
	}
}

# Assume atomic stores always succeed
:l.swa mD, rB is opcode = 0x33 & mD & rB {
	*mD = rB:4;
	F = 1;
}

:l.sw  mD, rB is opcode = 0x35 & mD & rB { *mD = rB:4; }
:l.sb  mD, rB is opcode = 0x36 & mD & rB { *mD = rB:1; }
:l.sh  mD, rB is opcode = 0x37 & mD & rB { *mD = rB:2; }

with : opcode = 0x38 {
	:l.add  rD, rA, rB is f_0_10 = 0x000 & rD & rA & rB { halfAdd(rD, rA, rB); }
	:l.addc rD, rA, rB is f_0_10 = 0x001 & rD & rA & rB { fullAdd(rD, rA, rB); }
	:l.sub  rD, rA, rB is f_0_10 = 0x002 & rD & rA & rB { halfSub(rD, rA, rB); }
	:l.and  rD, rA, rB is f_0_10 = 0x003 & rD & rA & rB { rD = rA & rB; }
	:l.or   rD, rA, rB is f_0_10 = 0x004 & rD & rA & rB { rD = rA | rB; }
	:l.xor  rD, rA, rB is f_0_10 = 0x005 & rD & rA & rB { rD = rA ^ rB; }

	# shift amounts use the low 5 bits of rB
	:l.sll rD, rA, rB is f_0_10 = 0x008 & rD & rA & rB { rD = rA  << (rB & 0x1f); }
	:l.srl rD, rA, rB is f_0_10 = 0x048 & rD & rA & rB { rD = rA  >> (rB & 0x1f); }
	:l.sra rD, rA, rB is f_0_10 = 0x088 & rD & rA & rB { rD = rA s>> (rB & 0x1f); }
	:l.ror rD, rA, rB is f_0_10 = 0x0c8 & rD & rA & rB {
		local n = rB & 0x1f;
		rD = (rA >> n) | (rA << ((32 - n) & 0x1f));
	}

	:l.exths rD, rA is f_0_10 = 0x00c & f_11_15 = 0 & rD & rA { rD = sext(rA:2); }
	:l.extbs rD, rA is f_0_10 = 0x04c & f_11_15 = 0 & rD & rA { rD = sext(rA:1); }
	:l.exthz rD, rA is f_0_10 = 0x08c & f_11_15 = 0 & rD & rA { rD = zext(rA:2); }
	:l.extbz rD, rA is f_0_10 = 0x0cc & f_11_15 = 0 & rD & rA { rD = zext(rA:1); }
	:l.extws rD, rA is f_0_10 = 0x00d & f_11_15 = 0 & rD & rA { rD = rA; }
	:l.extwz rD, rA is f_0_10 = 0x04d & f_11_15 = 0 & rD & rA { rD = rA; }

	# Branch-free: gcc puts l.cmov in delay slots, where a "goto inst_next" would skip the
	# jump the slot belongs to.
	:l.cmov rD, rA, rB is f_0_10 = 0x00e & rD & rA & rB {
		local m:4 = -zext(F);
		rD = (rA & m) | (rB & ~m);
	}

	# first set bit, counting from 1 at the LSB (0 if none)
	:l.ff1 rD, rA is f_0_10 = 0x00f & rD & rA {
		local v = rA;
		local n:4 = popcount((v & -v) - 1);
		rD = (n + 1) * zext(v != 0);
	}

	# last set bit, counting from 1 at the LSB (0 if none)
	:l.fl1 rD, rA is f_0_10 = 0x10f & rD & rA {
		rD = 32 - lzcount(rA);
	}

	:l.mul rD, rA, rB is f_0_10 = 0x306 & rD & rA & rB {
		local result;
		mul64s(result, rA, rB);
		OV = result s> 0x7fffffff || result s< -0x80000000;
		rD = result:4;
	}

	:l.div rD, rA, rB is f_0_10 = 0x309 & rD & rA & rB {
		OV = rB == 0;
		rD = rA s/ rB;
	}

	:l.divu rD, rA, rB is f_0_10 = 0x30a & rD & rA & rB {
		CY = rB == 0;
		rD = rA / rB;
	}

	:l.mulu rD, rA, rB is f_0_10 = 0x30b & rD & rA & rB {
		local result;
		mul64z(result, rA, rB);
		CY = result > 0xffffffff;
		rD = result:4;
	}

	:l.muld rA, rB is f_0_10 = 0x307 & f_21_25 = 0 & rA & rB {
		local result;
		mul64s(result, rA, rB);
		setmac(result);
	}

	# Arch manual 1.4 and QEMU encode l.muldu with secondary opcode 0xc; binutils 2.45 uses
	# 0xd (cpu/or1korbis.cpu OPC_ALU_REGREG_MULDU). The manual's encoding is used here.
	:l.muldu rA, rB is f_0_10 = 0x30c & f_21_25 = 0 & rA & rB {
		local result;
		mul64z(result, rA, rB);
		setmac(result);
	}
}

with : opcode = 0x39 & f_0_10 = 0 {
	:l.sfeq  rA, rB is cond = 0x0 & rA & rB { F = rA  == rB; }
	:l.sfne  rA, rB is cond = 0x1 & rA & rB { F = rA  != rB; }
	:l.sfgtu rA, rB is cond = 0x2 & rA & rB { F = rA  >  rB; }
	:l.sfgeu rA, rB is cond = 0x3 & rA & rB { F = rA  >= rB; }
	:l.sfltu rA, rB is cond = 0x4 & rA & rB { F = rA  <  rB; }
	:l.sfleu rA, rB is cond = 0x5 & rA & rB { F = rA  <= rB; }
	:l.sfgts rA, rB is cond = 0xa & rA & rB { F = rA s>  rB; }
	:l.sfges rA, rB is cond = 0xb & rA & rB { F = rA s>= rB; }
	:l.sflts rA, rB is cond = 0xc & rA & rB { F = rA s<  rB; }
	:l.sfles rA, rB is cond = 0xd & rA & rB { F = rA s<= rB; }
}

:l.cust5 is opcode = 0x3c & imm26 = 0 { cust5(); }
:l.cust6 is opcode = 0x3d & imm26 = 0 { cust6(); }
:l.cust7 is opcode = 0x3e & imm26 = 0 { cust7(); }
:l.cust8 is opcode = 0x3f & imm26 = 0 { cust8(); }
