dpD: "r29,r31" is rD=29 & pD=1 { r29 = fpres(4); r31 = fpres:4; }
dpD: "r30,r31" is rD=30 & pD=0 { r30 = fpres(4); r31 = fpres:4; }

dpDv: "r0,r1" is rD=0 & pD=0 { local v:8 = (zext(r0) << 32) | zext(r1); export v; }
dpDv: "r0,r2" is rD=0 & pD=1 { local v:8 = (zext(r0) << 32) | zext(r2); export v; }
