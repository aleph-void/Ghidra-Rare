# STMicroelectronics ST9 / ST9+ 8/16-bit microcontrollers.
#
# Written from the "ST9+ Family Programming Manual" (STMicroelectronics) and the "ST9 Family 8/16 Bit
# MCU Programming Manual" (SGS-Thomson, 1991). This file holds the address spaces, registers,
# tokens, context and helper macros. The instruction constructors and operand subtables are
# generated by tools/gen_st9.py into st9_gen.sinc / st9p_gen.sinc.
#
# Address spaces
#   code      program memory: 64K (ST9) or 4M (ST9+, 64 segments of 64K selected by CSR)
#   data      data memory, 64K. On the ST9+ this is the 16-bit logical address; the DPR0-3
#             page registers that map it to physical memory are not modelled.
#   rf        the register file: R0-R255 at rf:0000-00FF; the 64 pages of group F (R240-R255)
#             at rf:0100 + page*16 + n.
#   register  the system group (R224-R239), the flags, PC, CSR and the context register.
#
# Working registers r0-r15 are register-file addresses relative to the register pointers
# RP0R/RP1R. The context tracks the pointers after SRP/SRP0/SRP1 (and LD RP0R/RP1R,#N): with
# known pointers a working register is a fixed rf address, otherwise the address is computed from
# RP0R/RP1R at run time. Group F registers are handled the same way with the page pointer PPR
# (context after SPP). References to the system group E go to the named registers in the register
# space, so the flags, register pointers and stack pointers are real registers for the decompiler.

define endian=big;
define alignment=1;

@ifdef ST9PLUS
define space code     type=ram_space      size=3  default;
@else
define space code     type=ram_space      size=2  default;
@endif
define space data     type=ram_space      size=2;
define space rf       type=ram_space      size=2;
define space register type=register_space size=2;

# system register group E (R224-R239)
define register offset=0xE0 size=1 [ P0DR P1DR P2DR P3DR P4DR P5DR CICR FLAGR
                                     RP0R RP1R PPR MODER USPHR USPLR SSPHR SSPLR ];
define register offset=0xE0 size=2 [ RRE0 RRE2 RRE4 RRE6 RPR RREA USPR SSPR ];

# FLAGR bits 7..2 (C Z S V D H) as separate flags; FLAGR itself is packed/unpacked around
# explicit accesses to R231.
define register offset=0x100 size=1 [ CF ZF SF VF DF HF ];

@ifdef ST9PLUS
define register offset=0x200 size=3 [ PC ];
define register offset=0x208 size=1 [ CSR ];
@else
define register offset=0x200 size=2 [ PC ];
@endif
define register offset=0x300 size=4 [ contextreg ];

define context contextreg
	rmode = (0,1)        # register pointer mode: 0 unknown, 1 single (SRP), 2 twin (SRP0/SRP1)
	rpk0  = (2,2)        # rp0 below is known
	rp0   = (3,7)        # RP0R[7:3]
	rpk1  = (8,8)        # rp1 below is known
	rp1   = (9,13)       # RP1R[7:3]
	ppk   = (14,14)      # page below is known
	page  = (15,20)      # PPR[7:2]
	dp    = (21,21)      # FLAGR.0: 1 = operands in data memory (SDM), 0 = program memory (SPM)
	sstk  = (22,22)      # MODER.7: 1 = system stack in the register file, 0 = in data memory
	ustk  = (23,23)      # MODER.6: 1 = user stack in the register file, 0 = in data memory
	encsr = (24,24)      # ST9+ EMR2.ENCSR: 1 = interrupts also save CSR (IRET pops it)
;

define token ib (8)
	b     = (0,7)
	bs    = (0,7) signed
	hi    = (4,7)
	lo    = (0,3)
	lob3  = (3,3)
	hib3  = (7,7)
	bit0  = (0,0)
	bit4  = (4,4)
	pl    = (1,3)
	ph    = (5,7)
	pb    = (1,7)
	btn   = (5,7) dec
	btn2  = (5,7) dec
	kf    = (4,7)
	w5    = (3,7)
	l3    = (0,2)
	p6    = (2,7)
	l2    = (0,1)
	seg6  = (0,5)
	top2  = (6,7)
	rlo   = (0,3)
	rhi   = (4,7)
	rrlo  = (1,3)
	rrhi  = (5,7)
	rname = (0,7)
	rrname = (1,7)
	sysr  = (0,3)
	syspr = (1,3)
	imm8  = (0,7)
	simm8 = (0,7) signed
;

define token w16 (16)
	imm16 = (0,15)
	simm16 = (0,15) signed
;

define token w16le (16) endian=little
	imm16le = (0,15)
;

attach names [ rlo rhi ] [ "r0" "r1" "r2" "r3" "r4" "r5" "r6" "r7"
                           "r8" "r9" "r10" "r11" "r12" "r13" "r14" "r15" ];
attach names [ rrlo rrhi ] [ "rr0" "rr2" "rr4" "rr6" "rr8" "rr10" "rr12" "rr14" ];
attach variables [ sysr ] [ P0DR P1DR P2DR P3DR P4DR P5DR CICR FLAGR
                            RP0R RP1R PPR MODER USPHR USPLR SSPHR SSPLR ];
attach variables [ syspr ] [ RRE0 RRE2 RRE4 RRE6 RPR RREA USPR SSPR ];



define pcodeop halt;
define pcodeop wait_for_interrupt;
define pcodeop emulator_trap;
define pcodeop emulator_return;

macro packflags() {
	FLAGR = (CF << 7) | (ZF << 6) | (SF << 5) | (VF << 4) | (DF << 3) | (HF << 2) | (FLAGR & 3);
}

macro unpackflags() {
	CF = (FLAGR >> 7) & 1;
	ZF = (FLAGR >> 6) & 1;
	SF = (FLAGR >> 5) & 1;
	VF = (FLAGR >> 4) & 1;
	DF = (FLAGR >> 3) & 1;
	HF = (FLAGR >> 2) & 1;
}

# run-time address of working register n (0-7 / 8-15) from RP0R/RP1R (RP0R.2 = twin mode)
macro wreg_lo(a, n) {
	local twin:1 = (RP0R & 4) >> 2;
	a = (zext(RP0R & 0xf0) + n) * zext(twin ^ 1) + (zext(RP0R & 0xf8) + n) * zext(twin);
}

macro wreg_hi(a, n) {
	local twin:1 = (RP0R & 4) >> 2;
	a = (zext(RP0R & 0xf0) + n) * zext(twin ^ 1) + (zext(RP1R & 0xf8) + n - 8) * zext(twin);
}

# run-time address of group F register n in the page selected by PPR
macro preg(a, n) {
	a = 0x100 + (zext(PPR & 0xfc) << 2) + n;
}
