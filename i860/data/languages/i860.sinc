# Intel i860 (80860 XR / XP), little-endian. Hand-written base: spaces, registers, fields,
# operand subtables and the dual-instruction-mode context machinery. The instruction
# constructors are generated by tools/gen_i860.py into i860_gen.sinc.
#
# Sources: Intel, "i860 64-Bit Microprocessor Family Programmer's Reference Manual"
# (order 240875-001, May 1991): chapter 3 (registers), chapter 7 (core instructions),
# chapter 8 (floating-point, graphics, dual-instruction mode), appendix B (encodings).

define endian=little;
define alignment=4;

define space ram      type=ram_space      size=4 default;
define space io       type=ram_space      size=4;
define space register type=register_space size=4;

# Integer registers. r0 reads as zero (the operand subtables below export a constant for it);
# r1 holds the return address of call/calli, r2 is the stack pointer and r3 the frame pointer
# in the SVR4 ABI.
define register offset=0x000 size=4 [
	r0  r1  sp  fp  r4  r5  r6  r7  r8  r9  r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];

# Floating-point registers f0-f31 (f0 and f1 read as zero). 64-bit values use an even/odd pair
# with the low half in the lower register (fdN = fN:fN+1); 128-bit values use an aligned group
# of four (fqN = fN..fN+3).
define register offset=0x100 size=4 [
	f0  f1  f2  f3  f4  f5  f6  f7  f8  f9  f10 f11 f12 f13 f14 f15
	f16 f17 f18 f19 f20 f21 f22 f23 f24 f25 f26 f27 f28 f29 f30 f31 ];
define register offset=0x100 size=8 [
	fd0 fd2 fd4 fd6 fd8 fd10 fd12 fd14 fd16 fd18 fd20 fd22 fd24 fd26 fd28 fd30 ];
define register offset=0x100 size=16 [ fq0 fq4 fq8 fq12 fq16 fq20 fq24 fq28 ];

define register offset=0x200 size=4 [ pc ];

# Control registers (ld.c / st.c). psr and epsr hold the bits that are not kept in the separate
# flag registers below; ld.c/st.c of psr and epsr assemble and split them.
define register offset=0x300 size=4 [ fir psr dirbase db fsr epsr bear ccr p0 p1 p2 p3 ];

# psr.CC (bit 2), psr.LCC (bit 3), psr.SC (bits 21-17), psr.PS (bits 23-22), psr.PM (bits 31-24),
# epsr.OF (bit 24). CCold is the condition code before a dual-mode floating-point compare
# (a bc/bnc paired with the compare tests the old value, manual 8.6.1).
define register offset=0x380 size=1 [ CC LCC OF SC PS PM CCold ];

# Special-purpose 64-bit registers of the floating-point unit (manual 3.9) and the pipeline
# stages (manual 8.1). A1-A3: adder pipeline (3 stages); M1-M3: multiplier pipeline (3 stages
# for single-precision sources, 2 for double); G1: graphics pipeline (1 stage); L1-L3: load
# pipeline of pfld (3 stages, up to 128 bits). Stage values hold single-precision results in
# their low 32 bits.
define register offset=0x400 size=8 [ KR KI T MERGE A1 A2 A3 M1 M2 M3 G1 ];
define register offset=0x480 size=16 [ L1 L2 L3 ];

# Disassembly context. dual: this instruction executes in dual-instruction mode. dnext: mode of
# the next instruction (or pair). dnn: mode of the step after that, decided by the D bit of the
# floating-point slot of a pair. slot: 0 = low (floating-point) word of a dual pair, 1 = high
# (core) word. cmpslot: the core word's floating-point companion is a pfgt/pfle/pfeq.
define register offset=0x500 size=4 [ contextreg ];
define context contextreg
	dual    = (0,0)
	dnext   = (1,1)
	dnn     = (2,2)
	slot    = (3,3) noflow
	cmpslot = (4,4) noflow
;

define token instr(32)
	op6    = (26,31)
	op5    = (27,31)
	op4    = (28,31)
	opI    = (26,26)
	src2   = (21,25)
	dest   = (16,20)
	src1   = (11,15)
	imm16  = (0,15)
	simm16 = (0,15) signed
	low11  = (0,10)
	dhi    = (16,20) signed
	lbroff = (0,25) signed
	bit0   = (0,0)
	bit1   = (1,1)
	bit2   = (2,2)
	lo3    = (0,2)
	b21    = (1,2)
	b30    = (0,3)
	# floating-point escape
	fP     = (10,10)
	fD     = (9,9)
	fS     = (8,8)
	fR     = (7,7)
	fSR    = (7,8)
	fop    = (0,6)
	fdpc   = (0,3)
	fsub   = (4,4)
	fhi    = (4,6)
	# core escape
	escop  = (0,4)
	escrsv = (5,8)
	escsz  = (9,10)
	# register attach fields
	rs1f   = (11,15)
	rs2f   = (21,25)
	rdf    = (16,20)
	fs1f   = (11,15)
	fs2f   = (21,25)
	fdf    = (16,20)
	fs1df  = (11,15)
	fs2df  = (21,25)
	fddf   = (16,20)
	fdqf   = (16,20)
	creg   = (21,25)
;

attach variables [ rs1f rs2f rdf ] [
	r0  r1  sp  fp  r4  r5  r6  r7  r8  r9  r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];
attach variables [ fs1f fs2f fdf ] [
	f0  f1  f2  f3  f4  f5  f6  f7  f8  f9  f10 f11 f12 f13 f14 f15
	f16 f17 f18 f19 f20 f21 f22 f23 f24 f25 f26 f27 f28 f29 f30 f31 ];
# Misaligned register pairs and groups produce undefined results (manual 3.2): not decoded.
attach variables [ fs1df fs2df fddf ] [
	fd0 _ fd2 _ fd4 _ fd6 _ fd8 _ fd10 _ fd12 _ fd14 _
	fd16 _ fd18 _ fd20 _ fd22 _ fd24 _ fd26 _ fd28 _ fd30 _ ];
attach variables [ fdqf ] [
	fq0 _ _ _ fq4 _ _ _ fq8 _ _ _ fq12 _ _ _ fq16 _ _ _ fq20 _ _ _ fq24 _ _ _ fq28 _ _ _ ];

define pcodeop trap;             # trap isrc1, isrc2: instruction trap (psr.IT)
define pcodeop overflow_trap;    # intovr with epsr.OF set
define pcodeop lock;             # begin interlocked sequence
define pcodeop unlock;           # end interlocked sequence
define pcodeop flush;            # write back / invalidate the data-cache line at the address
define pcodeop load_interrupt_vector;  # ldint (XP): interrupt acknowledge bus cycle
define pcodeop special_cycle;    # scyc (XP): special bus cycle

# ---- integer operands (r0 reads as zero) ----
rs1: rs1f is rs1f { export rs1f; }
rs1: "r0" is src1=0 { export 0:4; }
rs2: rs2f is rs2f { export rs2f; }
rs2: "r0" is src2=0 { export 0:4; }
rd: rdf is rdf { export rdf; }

# ---- floating-point operands (f0/f1 and fd0 read as zero) ----
fs1s: fs1f is fs1f { export fs1f; }
fs1s: "f0" is src1=0 { export 0:4; }
fs1s: "f1" is src1=1 { export 0:4; }
fs2s: fs2f is fs2f { export fs2f; }
fs2s: "f0" is src2=0 { export 0:4; }
fs2s: "f1" is src2=1 { export 0:4; }
fs1d: fs1df is fs1df { export fs1df; }
fs1d: "fd0" is src1=0 { export 0:8; }
fs2d: fs2df is fs2df { export fs2df; }
fs2d: "fd0" is src2=0 { export 0:8; }
fds: fdf is fdf { export fdf; }
fdd: fddf is fddf { export fddf; }
fdq: fdqf is fdqf { export fdqf; }
# destination field read as a source (fst, pst)
fdrs: fdf is fdf { export fdf; }
fdrs: "f0" is dest=0 { export 0:4; }
fdrs: "f1" is dest=1 { export 0:4; }
fdrd: fddf is fddf { export fddf; }
fdrd: "fd0" is dest=0 { export 0:8; }
fdrq: fdqf is fdqf { export fdqf; }
fdrq: "fq0" is dest=0 { local z:16 = zext(fd2) << 64; export z; }

# ---- branch targets ----
lbr: reloc is lbroff [ reloc = inst_start + 4 + lbroff * 4; ] { export *:4 reloc; }
sbr: reloc is dhi & low11 [ reloc = inst_start + 4 + ((dhi << 11) | low11) * 4; ] { export *:4 reloc; }

# ---- dual-instruction-mode context (manual 8.6, figure 8-12) ----
# Every instruction carries one of these. It sets the context of the next sequential word
# (inst_start + 4, which is also the delay slot of a branch):
#  - single mode: the next instruction runs in the mode decided one step earlier (dnext); a
#    floating-point instruction (or shrd, whose bit 9 is interpreted as the D bit) decides the
#    mode of the step after that, a core instruction leaves it unchanged;
#  - low word of a dual pair: the high word runs in dual mode; the pair's D bit decides the mode
#    of the step after the next one (dnn);
#  - high word of a dual pair: the next word starts the next step.
nxtadr: addr is epsilon [ addr = inst_start + 4; ] { export *:4 addr; }
# (fpcls: the floating-point escape op6 = 0x12 and shrd op6 = 0x2c; SLEIGH does not backtrack
# into subtables, so each case is spelled out.)
cx: is dual=0 & op6=0x12 & fD & nxtadr [ dual = dnext; dnext = fD; dnn = fD; slot = 0; cmpslot = 0;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }
cx: is dual=0 & op6=0x2c & fD & nxtadr [ dual = dnext; dnext = fD; dnn = fD; slot = 0; cmpslot = 0;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }
cx: is dual=0 & nxtadr [ dual = dnext; dnn = dnext; slot = 0; cmpslot = 0;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }
cx: is dual=1 & slot=0 & op6=0x12 & fP=1 & fop=0x34 & fD & nxtadr [ dnn = fD; slot = 1; cmpslot = 1;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }
cx: is dual=1 & slot=0 & op6=0x12 & fP=1 & fop=0x35 & fD & nxtadr [ dnn = fD; slot = 1; cmpslot = 1;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }
cx: is dual=1 & slot=0 & op6=0x12 & fD & nxtadr [ dnn = fD; slot = 1; cmpslot = 0;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }
cx: is dual=1 & slot=0 & op6=0x2c & fD & nxtadr [ dnn = fD; slot = 1; cmpslot = 0;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }
cx: is dual=1 & slot=0 & nxtadr [ dnn = dnext; slot = 1; cmpslot = 0;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }
cx: is dual=1 & slot=1 & nxtadr [ dual = dnext; dnext = dnn; slot = 0; cmpslot = 0;
	globalset(nxtadr, dual); globalset(nxtadr, dnext); globalset(nxtadr, dnn); globalset(nxtadr, slot); globalset(nxtadr, cmpslot); ] { }

# ---- psr / epsr assembly ----
macro psr_read(v) {
	v = (psr & 0x0001fff3) | (zext(CC & 1) << 2) | (zext(LCC & 1) << 3) | (zext(SC & 0x1f) << 17)
		| (zext(PS & 3) << 22) | (zext(PM) << 24);
}
macro psr_write(v) {
	psr = v & 0x0001fff3;
	local t:4 = v >> 2;
	CC = t:1 & 1;
	t = v >> 3;
	LCC = t:1 & 1;
	t = v >> 17;
	SC = t:1 & 0x1f;
	t = v >> 22;
	PS = t:1 & 3;
	t = v >> 24;
	PM = t:1;
}
macro epsr_read(v) {
	v = (epsr & 0xfeffffff) | (zext(OF & 1) << 24);
}
macro epsr_write(v) {
	epsr = v & 0xfeffffff;
	local t:4 = v >> 24;
	OF = t:1 & 1;
}

@include "i860_gen.sinc"
