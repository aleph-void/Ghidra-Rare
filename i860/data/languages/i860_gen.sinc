:ld.c "psr",rd is op6=0x0c & creg=1 & rd & cx {
	psr_read(rd);
}
:st.c rs1,"psr" is op6=0x0e & creg=1 & rs1 & cx {
	psr_write(rs1);
}
:ld.c "dirbase",rd is op6=0x0c & creg=2 & rd & cx {
	rd = dirbase;
}
:st.c rs1,"dirbase" is op6=0x0e & creg=2 & rs1 & cx {
	dirbase = rs1;
}
