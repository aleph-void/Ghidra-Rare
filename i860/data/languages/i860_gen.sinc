# ---- pipelined floating-point load (7.4): fdest gets the data of the third previous pfld ----
:pfld.l eafl,fds is op6=0x18 & bit1=1 & eafl & fds & cx {
	local v:4 = *:4 eafl;
	fds = L3:4;
	L3 = L2; L2 = L1; L1 = zext(v);
}
:pfld.d eafd,fdd is op6=0x18 & b21=0 & eafd & fdd & cx {
	local v:8 = *:8 eafd;
	fdd = L3:8;
	L3 = L2; L2 = L1; L1 = zext(v);
}
@ifdef XP
:pfld.q eafq,fdq is op6=0x18 & b21=2 & eafq & fdq & cx {
	local v:16 = *:16 eafq;
	fdq = L3;
	L3 = L2; L2 = L1; L1 = v;
}
@endif
:pfld.l eafl,fds is op6=0x19 & bit1=1 & eafl & fds & cx {
	local v:4 = *:4 eafl;
	fds = L3:4;
	L3 = L2; L2 = L1; L1 = zext(v);
}
:pfld.d eafd,fdd is op6=0x19 & b21=0 & eafd & fdd & cx {
	local v:8 = *:8 eafd;
	fdd = L3:8;
	L3 = L2; L2 = L1; L1 = zext(v);
}
@ifdef XP
:pfld.q eafq,fdq is op6=0x19 & b21=2 & eafq & fdq & cx {
	local v:16 = *:16 eafq;
	fdq = L3;
	L3 = L2; L2 = L1; L1 = v;
}
@endif

# ---- pixel store (7.6): stores the pixels enabled by psr.PM, then shifts PM ----
:pst.d fdrd,eaim is op6=0x0f & b21=0 & eaim & fdrd & cx {
	local v:8 = fdrd;
	local old:8 = *:8 eaim;
	local m:8 = 0;
	local pm:8 = zext(PM);
	local ps:8 = zext(PS & 3);
	m = m | ((((pm >> (0 >> ps)) & 1) * 0xff) << 0);
	m = m | ((((pm >> (1 >> ps)) & 1) * 0xff) << 8);
	m = m | ((((pm >> (2 >> ps)) & 1) * 0xff) << 16);
	m = m | ((((pm >> (3 >> ps)) & 1) * 0xff) << 24);
	m = m | ((((pm >> (4 >> ps)) & 1) * 0xff) << 32);
	m = m | ((((pm >> (5 >> ps)) & 1) * 0xff) << 40);
	m = m | ((((pm >> (6 >> ps)) & 1) * 0xff) << 48);
	m = m | ((((pm >> (7 >> ps)) & 1) * 0xff) << 56);
	*:8 eaim = (old & ~m) | (v & m);
	PM = PM >> (8 >> (PS & 3));
}

# ---- cache flush (7.13). The manual requires bits 2-1 to be zero, but GNU as sets bit 2,
# ---- so they are ignored here.
:flush eafl16 is op6=0x0d & eafl16 & cx {
	flush(eafl16);
}

# ---- control registers (7.12) ----
:ld.c "fir",rd is op6=0x0c & creg=0 & rd & cx {
	rd = fir;
}
:st.c rs1,"fir" is op6=0x0e & creg=0 & rs1 & cx {
	
