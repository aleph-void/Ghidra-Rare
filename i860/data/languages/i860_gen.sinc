# ---- control transfer (7.11). Delayed forms execute one more instruction, or one more
# ---- pair in dual-instruction mode; call/calli link the address after it in r1.
:br lbr is op6=0x1a & lbr & slot=0 & cx {
	delayslot(4);
	goto lbr;
}
:call lbr is op6=0x1b & lbr & slot=0 & cx {
	r1 = inst_next;
	delayslot(4);
	call lbr;
}
:bc.t lbr is op6=0x1d & lbr & slot=0 & cx {
	if (CC == 0) goto inst_next;
	delayslot(4);
	goto lbr;
}
:bnc.t lbr is op6=0x1f & lbr & slot=0 & cx {
	if (CC != 0) goto inst_next;
	delayslot(4);
	goto lbr;
}
:bri rs1 is op6=0x10 & rs1 & src1=1 & slot=0 & cx {
	local t:4 = rs1;
	delayslot(4);
	return [t];
}
:bri rs1 is op6=0x10 & rs1 & slot=0 & cx {
	local t:4 = rs1;
	delayslot(4);
	goto [t];
}
:calli rs1 is op6=0x13 & escop=2 & escrsv=0 & escsz=0 & src2=0 & dest=0 & rs1 & slot=0 & cx {
	local t:4 = rs1;
	r1 = inst_next;
	delayslot(4);
	call [t];
}
:bla rs1,rs2,sbr is op6=0x2d & rs1 & rs2 & rs2f & sbr & slot=0 & cx {
	local a:4 = rs1;
	local b:4 = rs2;
	local s:4 = a + b;
	local lt:1 = !((s s< 0) != scarry(a, b));
	rs2f = s;
	local go:1 = LCC;
	delayslot(4);
	LCC = lt;
	if (go) goto sbr;
}
:br lbr is op6=0x1a & lbr & dual=1 & slot=1 & cx {
	delayslot(8);
	goto lbr;
}
:call lbr is op6=0x1b & lbr & dual=1 & slot=1 & cx {
	r1 = inst_next;
	delayslot(8);
	call lbr;
}
:bc.t lbr is op6=0x1d & lbr & dual=1 & slot=1 & cx {
	if (CC == 0) goto inst_next;
	delayslot(8);
	goto lbr;
}
:bnc.t lbr is op6=0x1f & lbr & dual=1 & slot=1 & cx {
	if (CC != 0) goto inst_next;
	delayslot(8);
	goto lbr;
}
:bri rs1 is op6=0x10 & rs1 & src1=1 & dual=1 & slot=1 & cx {
	local t:4 = rs1;
	delayslot(8);
	return [t];
}
:bri rs1 is op6=0x10 & rs1 & dual=1 & slot=1 & cx {
	local t:4 = rs1;
	delayslot(8);
	goto [t];
}
:calli rs1 is op6=0x13 & escop=2 & escrsv=0 & escsz=0 & src2=0 & dest=0 & rs1 & dual=1 & slot=1 & cx {
	local t:4 = rs1;
	r1 = inst_next;
	delayslot(8);
	call [t];
}
:bla rs1,rs2,sbr is op6=0x2d & rs1 & rs2 & rs2f & sbr & dual=1 & slot=1 & cx {
	local a:4 = rs1;
	local b:4 = rs2;
	local s:4 = a + b;
	local lt:1 = !((s s< 0) != scarry(a, b));
	rs2f = s;
	local go:1 = LCC;
	delayslot(8);
	LCC = lt;
	if (go) goto sbr;
}
:bc lbr is op6=0x1c & lbr & cmpslot=0 & cx {
	if (CC != 0) goto lbr;
}
:bnc lbr is op6=0x1e & lbr & cmpslot=0 & cx {
	if (CC == 0) goto lbr;
}
:bc lbr is op6=0x1c & lbr & cmpslot=1 & cx {
	if (CCold != 0) goto lbr;
}
:bnc lbr is op6=0x1e & lbr & cmpslot=1 & cx {
	if (CCold == 0) goto lbr;
}
:btne rs1,rs2,sbr is op6=0x14 & rs1 & rs2 & sbr & cx {
	if (rs1 != rs2) goto sbr;
}
:btne src1,rs2,sbr is op6=0x15 & src1 & rs2 & sbr & cx {
	if (src1 != rs2) goto sbr;
}
:bte rs1,rs2,sbr is op6=0x16 & rs1 & rs2 & sbr & cx {
	if (rs1 == rs2) goto sbr;
}
:bte src1,rs2,sbr is op6=0x17 & src1 & rs2 & sbr & cx {
	if (src1 == rs2) goto sbr;
}

# ---- traps, bus lock, I/O (7.9, 7.14-7.17). Unused core-escape fields must be zero. ----
:trap rs1,rs2,rd is op6=0x11 & rs1 & rs2 & rd & cx {
	trap(rs1, rs2);
}
:lock is op6=0x13 & escrsv=0 & escop=1 & escsz=0 & src1=0 & src2=0 & dest=0 & cx {
	lock();
}
:intovr is op6=0x13 & escrsv=0 & escop=4 & escsz=0 & src1=0 & src2=0 & dest=0 & cx {
	if (OF == 0) goto inst_next;
	overflow_trap();
}
:unlock is op6=0x13 & escrsv=0 & escop=7 & escsz=0 & src1=0 & src2=0 & dest=0 & cx {
	unlock();
}
@ifdef XP
:ldio.b rs2,rd is op6=0x13 & escrsv=0 & escop=8 & escsz=0 & src1=0 & rs2 & rd & cx {
	rd = sext(*[io]:1 rs2);
}
@endif
@ifdef XP
:stio.b rs1,rs2 is op6=0x13 & escrsv=0 & escop=9 & escsz=0 & dest=0 & rs1 & rs2 & cx {
	*[io]:1 rs2 = rs1:1;
}
@endif
@ifdef XP
:ldint.b rs2,rd is op6=0x13 & escrsv=0 & escop=10 & escsz=0 & src1=0 & rs2 & rd & cx {
	local v:4 = load_interrupt_vector(rs2, 1:1);
	rd = sext(v:1);
}
@endif
@ifdef XP
:scyc.b rs2 is op6=0x13 & escrsv=0 & escop=11 & escsz=0 & src1=0 & dest=0 & rs2 & cx {
	special_cycle(rs2, 1:1);
}
@endif
@ifdef XP
:ldio.s rs2,rd is op6=0x13 & escrsv=0 & escop=8 & escsz=1 & src1=0 & rs2 & rd & cx {
