# ---- shifts (7.8); counts are taken modulo 32 ----
:shl rs1,rs2,rd is op6=0x28 & rs1 & rs2 & rd & cx {
	local n:4 = rs1 & 31;
	rd = rs2 << n;
}
:shl simm16,rs2,rd is op6=0x29 & simm16 & rs2 & rd & cx {
	local n:4 = simm16 & 31;
	rd = rs2 << n;
}
:shr rs1,rs2,rd is op6=0x2a & rs1 & rs2 & rd & cx {
	local n:4 = rs1 & 31;
	local b:4 = rs2;
	SC = n:1;
	rd = b >> n;
}
:shr simm16,rs2,rd is op6=0x2b & simm16 & rs2 & rd & cx {
	local n:4 = simm16 & 31;
	local b:4 = rs2;
	SC = n:1;
	rd = b >> n;
}
:shra rs1,rs2,rd is op6=0x2e & rs1 & rs2 & rd & cx {
	local n:4 = rs1 & 31;
	rd = rs2 s>> n;
}
:shra simm16,rs2,rd is op6=0x2f & simm16 & rs2 & rd & cx {
	local n:4 = simm16 & 31;
	rd = rs2 s>> n;
}
:shrd rs1,rs2,rd is op6=0x2c & fD=0 & rs1 & rs2 & rd & cx {
	local v:8 = (zext(rs1) << 32) | zext(rs2);
	v = v >> zext(SC & 0x1f);
	rd = v:4;
}
:d.shrd rs1,rs2,rd is op6=0x2c & fD=1 & rs1 & rs2 & rd & cx {
	local v:8 = (zext(rs1) << 32) | zext(rs2);
