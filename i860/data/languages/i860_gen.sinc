}
@endif
@ifdef XP
:ldio.l rs2,rd is op6=0x13 & escrsv=0 & escop=8 & escsz=2 & src1=0 & rs2 & rd & cx {
	rd = *[io]:4 rs2;
}
@endif
@ifdef XP
:stio.l rs1,rs2 is op6=0x13 & escrsv=0 & escop=9 & escsz=2 & dest=0 & rs1 & rs2 & cx {
	*[io]:4 rs2 = rs1;
}
@endif
@ifdef XP
:ldint.l rs2,rd is op6=0x13 & escrsv=0 & escop=10 & escsz=2 & src1=0 & rs2 & rd & cx {
	local v:4 = load_interrupt_vector(rs2, 4:1);
	rd = v;
}
@endif
@ifdef XP
:scyc.l rs2 is op6=0x13 & escrsv=0 & escop=11 & escsz=2 & src1=0 & dest=0 & rs2 & cx {
	special_cycle(rs2, 4:1);
}
@endif

# ---- floating-point multiplier and adder (8.2, 8.3) ----
:fmul.ss fs1s,fs2s,fds is op6=0x12 & fop=0x20 & fP=0 & fD=0 & fS=0 & fR=0 & fs1s & fs2s & fds & cx {
	local r:4 = fs1s f* fs2s;
	fds = r;
	M3 = zext(r);
}
:d.fmul.ss fs1s,fs2s,fds is op6=0x12 & fop=0x20 & fP=0 & fD=1 & fS=0 & fR=0 & fs1s & fs2s & fds & cx {
	local r:4 = fs1s f* fs2s;
	fds = r;
	M3 = zext(r);
}
:pfmul.ss fs1s,fs2s,fds is op6=0x12 & fop=0x20 & fP=1 & fD=0 & fS=0 & fR=0 & fs1s & fs2s & fds & cx {
	local out:4 = M3:4;
	fds = out;
	local r:4 = fs1s f* fs2s;
	M3 = M2; M2 = M1; M1 = zext(r);
}
:d.pfmul.ss fs1s,fs2s,fds is op6=0x12 & fop=0x20 & fP=1 & fD=1 & fS=0 & fR=0 & fs1s & fs2s & fds & cx {
