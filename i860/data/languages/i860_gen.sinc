:fmlow.dd fs1d,fs2d,fdd is op6=0x12 & fop=0x21 & fP=0 & fD=0 & fS=1 & fR=1 & fs1d & fs2d & fdd & cx {
	local x:8 = fs1d;
	local y:8 = fs2d;
	local hx:8 = zext((x & 0x7ff0000000000000) != 0) << 52;
	local hy:8 = zext((y & 0x7ff0000000000000) != 0) << 52;
	local mx:16 = zext((x & 0x000fffffffffffff) | hx);
	local my:16 = zext((y & 0x000fffffffffffff) | hy);
	local p:16 = mx * my;
	local hi:16 = (p >> 105) & 1;
	local r:16 = (p & 0x1fffffffffffff) | (hi << 53);
