<opinions>
    <!-- EM_860 = 7. The ELF header does not distinguish the XR from the XP; XR code runs
         unchanged on the XP, so the XP language (a superset) is the default. -->
    <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
        <constraint primary="7" processor="i860" endian="little" size="32" variant="XP"/>
    </constraint>
</opinions>
