# Renesas RX (RXv1 / RXv2 / RXv3) - common definitions.
#
# Written from the Renesas "RX Family RXv1/RXv2/RXv3 Instruction Set Architecture User's Manual:
# Software" (R01US0032, R01US0071, R01US0316). The instruction constructors are generated by
# tools/gen_rx.py into rx_gen.sinc; this file holds the address spaces, registers, tokens, helper
# subtables and p-code macros they use.
#
# The including .slaspec defines RXV (1, 2 or 3) before including this file.

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

# General-purpose registers. R0 is the stack pointer (SP); which of ISP/USP it currently is
# (PSW.U) is not modelled - R0 is the active stack pointer.
define register offset=0x00 size=4 [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 R11 R12 R13 R14 R15 ];

# Control registers (manual 1.2.2). PSW is kept split into its fields below; the PSW register
# itself is only a name for disassembly and is rebuilt from the fields when read.
define register offset=0x40 size=4 [ PSW PC USP FPSW BPSW BPC ISP FINTV INTB EXTB ];

# PSW fields (C Z S O I U PM IPL) and the MOVLI/MOVCO link flag LI.
define register offset=0x80 size=1 [ C Z S O I U PM IPL LI ];

# Accumulators: A0/A1 hold bits 63..0, A0G/A1G bits 71..64 (the guard byte). RXv1 has a single
# 64-bit accumulator, ACC, which is A0 here.
define register offset=0x100 size=8 [ A0 A1 ];
define register offset=0x110 size=1 [ A0G A1G ];

# Double-precision coprocessor (RXv3 option): DR0-DR15, their halves and the control registers.
define register offset=0x200 size=8 [ DR0 DR1 DR2 DR3 DR4 DR5 DR6 DR7 DR8 DR9 DR10 DR11 DR12 DR13 DR14 DR15 ];
define register offset=0x200 size=4 [ DRL0 DRH0 DRL1 DRH1 DRL2 DRH2 DRL3 DRH3 DRL4 DRH4 DRL5 DRH5
	DRL6 DRH6 DRL7 DRH7 DRL8 DRH8 DRL9 DRH9 DRL10 DRH10 DRL11 DRH11 DRL12 DRH12 DRL13 DRH13
	DRL14 DRH14 DRL15 DRH15 ];
define register offset=0x300 size=4 [ DPSW DCMR DECNT DEPC ];

define register offset=0x400 size=4 contextreg;
define context contextreg
	unused=(0,0)
;

@include "rx_tokens.sinc"

# ------------------------------------------------------------------------------------------------
# User operations for processor state p-code cannot express.
define pcodeop software_interrupt;   # INT #n / BRK: exception entry through INTB
define pcodeop wait_for_interrupt;   # WAIT
define pcodeop register_bank_save;   # SAVE (RXv3 register bank save function)
define pcodeop register_bank_restore;# RSTR

# ------------------------------------------------------------------------------------------------
# Macros

macro setZS(r) {
	Z = (r == 0);
	S = (r s< 0);
}

macro push4(v) {
	R0 = R0 - 4;
	*:4 R0 = v;
}

macro pop4(v) {
	v = *:4 R0;
	R0 = R0 + 4;
}

# Rebuild / unpack the PSW from its fields (manual 1.2.2.4).
macro packPSW(p) {
	p = zext(C) | (zext(Z) << 1) | (zext(S) << 2) | (zext(O) << 3) | (zext(I) << 16) |
		(zext(U) << 17) | (zext(PM) << 20) | (zext(IPL & 15) << 24);
}

macro unpackPSW(p) {
	C = (p & 1) != 0;
	Z = (p & 2) != 0;
	S = (p & 4) != 0;
	O = (p & 8) != 0;
	I = (p & 0x10000) != 0;
	U = (p & 0x20000) != 0;
	PM = (p & 0x100000) != 0;
	IPL = p(3) & 15;
}

# MVTC/POPC to PSW (supervisor mode: PM is not written).
macro writePSW(p) {
	C = (p & 1) != 0;
	Z = (p & 2) != 0;
	S = (p & 4) != 0;
	O = (p & 8) != 0;
	I = (p & 0x10000) != 0;
	U = (p & 0x20000) != 0;
	IPL = p(3) & 15;
}

macro addflags(a, b, r) {
	C = carry(a, b);
	O = scarry(a, b);
	setZS(r);
}

macro subflags(a, b, r) {
	C = b <= a;
	O = sborrow(a, b);
	setZS(r);
}

# 72-bit accumulator helpers. acc/g = bits 63..0 / 71..64; v = a signed 64-bit addend.
macro accAdd(acc, g, v) {
	local lo:8 = acc + v;
	g = g + carry(acc, v) + ((v s< 0) * 0xff);
	acc = lo;
}

macro accSub(acc, g, v) {
	local lo:8 = acc - v;
	g = g - (acc < v) - ((v s< 0) * 0xff);
	acc = lo;
}

macro accSet(acc, g, v) {
	acc = v;
	g = (v s< 0) * 0xff;
}
