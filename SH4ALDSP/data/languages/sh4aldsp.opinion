<opinions>
    <!-- ELF e_machine 42 (EM_SH) with the e_flags machine value EF_SH4AL_DSP (6): preferred over
         Ghidra's SuperH4 opinion, which matches e_machine 42 without e_flags -->
    <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
        <constraint primary="42" secondary="0b.... .... .... .... .... .... ...0 0110" processor="SH4ALDSP" endian="big" size="32" />
        <constraint primary="42" secondary="0b.... .... .... .... .... .... ...0 0110" processor="SH4ALDSP" endian="little" size="32" />
    </constraint>
</opinions>
