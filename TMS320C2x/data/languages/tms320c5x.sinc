w16: wv is wv { export *[const]:2 wv; }
lk16: "#"^wv is wv { export *[const]:2 wv; }
pma16: wv is wv { export *[prog]:2 wv; }
pmai16: "#"^wv is wv { export *[prog]:2 wv; }
dlki16: "#"^wv is wv { export *[data]:2 wv; }
pa16: wv is wv { export *[io]:2 wv; }
retaddr: r is epsilon [ r = inst_next; ] { export *[const]:2 r; }
retaddrd: r is epsilon [ r = inst_next + 2; ] { export *[const]:2 r; }
bsh: v is bshf [ v = bshf + 1; ] { export *[const]:1 v; }
xcnum: "1" is xcnf=0 { }
xcnum: "2" is xcnf=1 { }
xcskip: a is xcnf [ a = inst_next + xcnf + 1; ] { export *[prog]:2 a; }
rptbm1: a is wv [ a = wv - 1; ] { export *[prog]:2 a; }
rbsaddr: is rbs { export *[prog]:2 rbs; }
cond: "BIO" is cndf=0x0 { local c:1 = (BIO == 0); export c; }
cond: "NC","BIO" is cndf=0x1 { local c:1 = (C == 0) && (BIO == 0); export c; }
cond: "NOV","BIO" is cndf=0x2 { local c:1 = (OV == 0) && (BIO == 0); export c; }
cond: "NOV","NC","BIO" is cndf=0x3 { local c:1 = (OV == 0) && (C == 0) && (BIO == 0); export c; }
cond: "GT","BIO" is cndf=0x4 { local c:1 = (ACC s> 0) && (BIO == 0); export c; }
cond: "GT","NC","BIO" is cndf=0x5 { local c:1 = (ACC s> 0) && (C == 0) && (BIO == 0); export c; }
cond: "GT","NOV","BIO" is cndf=0x6 { local c:1 = (ACC s> 0) && (OV == 0) && (BIO == 0); export c; }
