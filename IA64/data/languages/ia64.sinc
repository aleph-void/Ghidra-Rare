# Intel IA-64 (Itanium) SLEIGH specification, shared by the little- and big-endian languages.
# Written from the Intel Itanium Architecture Software Developer's Manual, revision 2.3.
# Instruction tables are generated by tools/gen_ia64.py into ia64_gen.sinc; registers into
# ia64_regs.sinc. See README.md for the model (one Ghidra instruction per slot).

define alignment=1;
@ifndef ADDRSIZE
@define ADDRSIZE "8"
@endif
@ifndef GEN
@define GEN "ia64_gen.sinc"
@endif
define space ram type=ram_space size=$(ADDRSIZE) default;
define space register type=register_space size=4;

@include "ia64_regs.sinc"

define register offset=0x1800 size=8 [ ip cfm psr ];
# The caller's stacked registers r32.. saved around br.call while the callee sees the outputs as
# r32.. (decompiler model, see ARGS / ARGR / ARGL in ia64_gen.sinc)
define register offset=0x2000 size=8 [ argsave0 argsave1 argsave2 argsave3 argsave4 argsave5 argsave6 argsave7 argsave8 argsave9 argsave10 argsave11 argsave12 argsave13 argsave14 argsave15 argsave16 argsave17 argsave18 argsave19 argsave20 argsave21 argsave22 argsave23 argsave24 argsave25 argsave26 argsave27 argsave28 argsave29 argsave30 argsave31 argsave32 argsave33 argsave34 argsave35 argsave36 argsave37 argsave38 argsave39 argsave40 argsave41 argsave42 argsave43 argsave44 argsave45 argsave46 argsave47 argsave48 argsave49 argsave50 argsave51 argsave52 argsave53 argsave54 argsave55 argsave56 argsave57 argsave58 argsave59 argsave60 argsave61 argsave62 argsave63 argsave64 argsave65 argsave66 argsave67 argsave68 argsave69 argsave70 argsave71 argsave72 argsave73 argsave74 argsave75 argsave76 argsave77 argsave78 argsave79 argsave80 argsave81 argsave82 argsave83 argsave84 argsave85 argsave86 argsave87 argsave88 argsave89 argsave90 argsave91 argsave92 argsave93 argsave94 argsave95 ];
# DECOMPILE_MODE is 1 for the decompiler (pspec tracked_set) and 0 in the emulator: br.call and
# br.ret run the register stack engine (backing store at ar.bsp) only when it is 0.
define register offset=0x1880 size=1 [ DECOMPILE_MODE ];
define register offset=0x1900 size=4 contextreg;

# slot / tmpl / s1lo / s2lo carry the bundle to the next slot (globalset, noflow).
# cfm_sol / cfm_out / cfm_sor: the current frame from the last alloc (sol, sof - sol, sor);
# they flow through the function and are read by br.call (outputs) and the rotating branches.
define context contextreg
  slot=(0,1) noflow
  tmpl=(2,6) noflow
  s1lo=(7,8) noflow
  s2lo=(9,9) noflow
  cfm_sol=(10,16)
  cfm_out=(17,23)
  cfm_sor=(24,27)
;

