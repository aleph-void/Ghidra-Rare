# mov r1 = pr (p0 reads as 1)
macro pr_read(dst) {
  dst = 1 | (zext(p1) << 1) | (zext(p2) << 2) | (zext(p3) << 3) | (zext(p4) << 4) | (zext(p5) << 5) | (zext(p6) << 6) | (zext(p7) << 7) | (zext(p8) << 8) | (zext(p9) << 9) | (zext(p10) << 10) | (zext(p11) << 11) | (zext(p12) << 12) | (zext(p13) << 13) | (zext(p14) << 14) | (zext(p15) << 15) | (zext(p16) << 16) | (zext(p17) << 17) | (zext(p18) << 18) | (zext(p19) << 19) | (zext(p20) << 20) | (zext(p21) << 21) | (zext(p22) << 22) | (zext(p23) << 23) | (zext(p24) << 24) | (zext(p25) << 25) | (zext(p26) << 26) | (zext(p27) << 27) | (zext(p28) << 28) | (zext(p29) << 29) | (zext(p30) << 30) | (zext(p31) << 31) | (zext(p32) << 32) | (zext(p33) << 33) | (zext(p34) << 34) | (zext(p35) << 35) | (zext(p36) << 36) | (zext(p37) << 37) | (zext(p38) << 38) | (zext(p39) << 39) | (zext(p40) << 40) | (zext(p41) << 41) | (zext(p42) << 42) | (zext(p43) << 43) | (zext(p44) << 44) | (zext(p45) << 45) | (zext(p46) << 46) | (zext(p47) << 47) | (zext(p48) << 48) | (zext(p49) << 49) | (zext(p50) << 50) | (zext(p51) << 51) | (zext(p52) << 52) | (zext(p53) << 53) | (zext(p54) << 54) | (zext(p55) << 55) | (zext(p56) << 56) | (zext(p57) << 57) | (zext(p58) << 58) | (zext(p59) << 59) | (zext(p60) << 60) | (zext(p61) << 61) | (zext(p62) << 62) | (zext(p63) << 63);
}

# mov pr = r2, mask17: mask bits 1-15 select p1-p15, bit 16 selects p16-p63
macro pr_write(src, mask) {
  p1 = (p1 && (((mask >> 1) & 1) == 0)) || ((((src >> 1) & 1) != 0) && (((mask >> 1) & 1) != 0));
  p2 = (p2 && (((mask >> 2) & 1) == 0)) || ((((src >> 2) & 1) != 0) && (((mask >> 2) & 1) != 0));
  p3 = (p3 && (((mask >> 3) & 1) == 0)) || ((((src >> 3) & 1) != 0) && (((mask >> 3) & 1) != 0));
  p4 = (p4 && (((mask >> 4) & 1) == 0)) || ((((src >> 4) & 1) != 0) && (((mask >> 4) & 1) != 0));
  p5 = (p5 && (((mask >> 5) & 1) == 0)) || ((((src >> 5) & 1) != 0) && (((mask >> 5) & 1) != 0));
  p6 = (p6 && (((mask >> 6) & 1) == 0)) || ((((src >> 6) & 1) != 0) && (((mask >> 6) & 1) != 0));
  p7 = (p7 && (((mask >> 7) & 1) == 0)) || ((((src >> 7) & 1) != 0) && (((mask >> 7) & 1) != 0));
  p8 = (p8 && (((mask >> 8) & 1) == 0)) || ((((src >> 8) & 1) != 0) && (((mask >> 8) & 1) != 0));
  p9 = (p9 && (((mask >> 9) & 1) == 0)) || ((((src >> 9) & 1) != 0) && (((mask >> 9) & 1) != 0));
  p10 = (p10 && (((mask >> 10) & 1) == 0)) || ((((src >> 10) & 1) != 0) && (((mask >> 10) & 1) != 0));
  p11 = (p11 && (((mask >> 11) & 1) == 0)) || ((((src >> 11) & 1) != 0) && (((mask >> 11) & 1) != 0));
  p12 = (p12 && (((mask >> 12) & 1) == 0)) || ((((src >> 12) & 1) != 0) && (((mask >> 12) & 1) != 0));
  p13 = (p13 && (((mask >> 13) & 1) == 0)) || ((((src >> 13) & 1) != 0) && (((mask >> 13) & 1) != 0));
  p14 = (p14 && (((mask >> 14) & 1) == 0)) || ((((src >> 14) & 1) != 0) && (((mask >> 14) & 1) != 0));
  p15 = (p15 && (((mask >> 15) & 1) == 0)) || ((((src >> 15) & 1) != 0) && (((mask >> 15) & 1) != 0));
  p16 = (p16 && (((mask >> 16) & 1) == 0)) || ((((src >> 16) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p17 = (p17 && (((mask >> 16) & 1) == 0)) || ((((src >> 17) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p18 = (p18 && (((mask >> 16) & 1) == 0)) || ((((src >> 18) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p19 = (p19 && (((mask >> 16) & 1) == 0)) || ((((src >> 19) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p20 = (p20 && (((mask >> 16) & 1) == 0)) || ((((src >> 20) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p21 = (p21 && (((mask >> 16) & 1) == 0)) || ((((src >> 21) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p22 = (p22 && (((mask >> 16) & 1) == 0)) || ((((src >> 22) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p23 = (p23 && (((mask >> 16) & 1) == 0)) || ((((src >> 23) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p24 = (p24 && (((mask >> 16) & 1) == 0)) || ((((src >> 24) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p25 = (p25 && (((mask >> 16) & 1) == 0)) || ((((src >> 25) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p26 = (p26 && (((mask >> 16) & 1) == 0)) || ((((src >> 26) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p27 = (p27 && (((mask >> 16) & 1) == 0)) || ((((src >> 27) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p28 = (p28 && (((mask >> 16) & 1) == 0)) || ((((src >> 28) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p29 = (p29 && (((mask >> 16) & 1) == 0)) || ((((src >> 29) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p30 = (p30 && (((mask >> 16) & 1) == 0)) || ((((src >> 30) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p31 = (p31 && (((mask >> 16) & 1) == 0)) || ((((src >> 31) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p32 = (p32 && (((mask >> 16) & 1) == 0)) || ((((src >> 32) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p33 = (p33 && (((mask >> 16) & 1) == 0)) || ((((src >> 33) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p34 = (p34 && (((mask >> 16) & 1) == 0)) || ((((src >> 34) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p35 = (p35 && (((mask >> 16) & 1) == 0)) || ((((src >> 35) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p36 = (p36 && (((mask >> 16) & 1) == 0)) || ((((src >> 36) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p37 = (p37 && (((mask >> 16) & 1) == 0)) || ((((src >> 37) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p38 = (p38 && (((mask >> 16) & 1) == 0)) || ((((src >> 38) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p39 = (p39 && (((mask >> 16) & 1) == 0)) || ((((src >> 39) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p40 = (p40 && (((mask >> 16) & 1) == 0)) || ((((src >> 40) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p41 = (p41 && (((mask >> 16) & 1) == 0)) || ((((src >> 41) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p42 = (p42 && (((mask >> 16) & 1) == 0)) || ((((src >> 42) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p43 = (p43 && (((mask >> 16) & 1) == 0)) || ((((src >> 43) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p44 = (p44 && (((mask >> 16) & 1) == 0)) || ((((src >> 44) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p45 = (p45 && (((mask >> 16) & 1) == 0)) || ((((src >> 45) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p46 = (p46 && (((mask >> 16) & 1) == 0)) || ((((src >> 46) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p47 = (p47 && (((mask >> 16) & 1) == 0)) || ((((src >> 47) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p48 = (p48 && (((mask >> 16) & 1) == 0)) || ((((src >> 48) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p49 = (p49 && (((mask >> 16) & 1) == 0)) || ((((src >> 49) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p50 = (p50 && (((mask >> 16) & 1) == 0)) || ((((src >> 50) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p51 = (p51 && (((mask >> 16) & 1) == 0)) || ((((src >> 51) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p52 = (p52 && (((mask >> 16) & 1) == 0)) || ((((src >> 52) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p53 = (p53 && (((mask >> 16) & 1) == 0)) || ((((src >> 53) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p54 = (p54 && (((mask >> 16) & 1) == 0)) || ((((src >> 54) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p55 = (p55 && (((mask >> 16) & 1) == 0)) || ((((src >> 55) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p56 = (p56 && (((mask >> 16) & 1) == 0)) || ((((src >> 56) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p57 = (p57 && (((mask >> 16) & 1) == 0)) || ((((src >> 57) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p58 = (p58 && (((mask >> 16) & 1) == 0)) || ((((src >> 58) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p59 = (p59 && (((mask >> 16) & 1) == 0)) || ((((src >> 59) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p60 = (p60 && (((mask >> 16) & 1) == 0)) || ((((src >> 60) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p61 = (p61 && (((mask >> 16) & 1) == 0)) || ((((src >> 61) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p62 = (p62 && (((mask >> 16) & 1) == 0)) || ((((src >> 62) & 1) != 0) && (((mask >> 16) & 1) != 0));
  p63 = (p63 && (((mask >> 16) & 1) == 0)) || ((((src >> 63) & 1) != 0) && (((mask >> 16) & 1) != 0));
}

# mov pr.rot = imm44
macro pr_rot_write(v) {
  p16 = ((v >> 16) & 1) != 0;
  p17 = ((v >> 17) & 1) != 0;
  p18 = ((v >> 18) & 1) != 0;
  p19 = ((v >> 19) & 1) != 0;
  p20 = ((v >> 20) & 1) != 0;
  p21 = ((v >> 21) & 1) != 0;
  p22 = ((v >> 22) & 1) != 0;
  p23 = ((v >> 23) & 1) != 0;
  p24 = ((v >> 24) & 1) != 0;
  p25 = ((v >> 25) & 1) != 0;
  p26 = ((v >> 26) & 1) != 0;
  p27 = ((v >> 27) & 1) != 0;
  p28 = ((v >> 28) & 1) != 0;
  p29 = ((v >> 29) & 1) != 0;
  p30 = ((v >> 30) & 1) != 0;
  p31 = ((v >> 31) & 1) != 0;
  p32 = ((v >> 32) & 1) != 0;
  p33 = ((v >> 33) & 1) != 0;
  p34 = ((v >> 34) & 1) != 0;
  p35 = ((v >> 35) & 1) != 0;
  p36 = ((v >> 36) & 1) != 0;
  p37 = ((v >> 37) & 1) != 0;
  p38 = ((v >> 38) & 1) != 0;
  p39 = ((v >> 39) & 1) != 0;
  p40 = ((v >> 40) & 1) != 0;
  p41 = ((v >> 41) & 1) != 0;
  p42 = ((v >> 42) & 1) != 0;
  p43 = ((v >> 43) & 1) != 0;
  p44 = ((v >> 44) & 1) != 0;
  p45 = ((v >> 45) & 1) != 0;
  p46 = ((v >> 46) & 1) != 0;
  p47 = ((v >> 47) & 1) != 0;
  p48 = ((v >> 48) & 1) != 0;
  p49 = ((v >> 49) & 1) != 0;
  p50 = ((v >> 50) & 1) != 0;
  p51 = ((v >> 51) & 1) != 0;
  p52 = ((v >> 52) & 1) != 0;
  p53 = ((v >> 53) & 1) != 0;
  p54 = ((v >> 54) & 1) != 0;
  p55 = ((v >> 55) & 1) != 0;
  p56 = ((v >> 56) & 1) != 0;
  p57 = ((v >> 57) & 1) != 0;
  p58 = ((v >> 58) & 1) != 0;
  p59 = ((v >> 59) & 1) != 0;
  p60 = ((v >> 60) & 1) != 0;
  p61 = ((v >> 61) & 1) != 0;
  p62 = ((v >> 62) & 1) != 0;
  p63 = ((v >> 63) & 1) != 0;
}

# getf.exp: 15-bit exponent + sign (80-bit model) to the 17-bit register format of GR r1
macro exp15to17(dst, e15) {
  local e:8 = zext(e15 & 0x7fff);
  local s:8 = zext(e15 >> 15);
  local z:1 = e == 0;
  local m:1 = e == 0x7fff;
  local e17:8 = (e + 0xc000) * zext(!z && !m) + 0x1ffff * zext(m);
  dst = (s << 17) | e17;
}

# setf.exp: GR bits 16:0 exponent, bit 17 sign, to the 15-bit exponent of the model
macro exp17to15(dst, src) {
  local e:8 = src & 0x1ffff;
  local s:8 = (src >> 17) & 1;
  local z:1 = e == 0;
  local m:1 = e == 0x1ffff;
  local e15:8 = ((e - 0xc000) & 0x7fff) * zext(!z && !m) + 0x7fff * zext(m);
  local r:8 = (s << 15) | e15;
  dst = r:2;
}

@include "$(GEN)"
