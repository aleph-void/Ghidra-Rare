<?xml version="1.0" encoding="UTF-8"?>

<!-- IA-64 software conventions (as followed by GCC and checked against its output):
     arguments in the stacked registers r32-r39 (the callee's in0-in7; br.call moves the caller's
     outputs there, see README) and f8-f15, the rest at sp+16 above the 16-byte scratch area;
     results in r8-r11 / f8-f15; gp = r1, sp = r12, tp = r13, return link b0. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="16"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="4"/>
    <pointer_size value="4"/>
    <wchar_size value="4"/>
    <short_size value="2"/>
    <integer_size value="4"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="16"/>
    <size_alignment_map>
      <entry size="1" alignment="1"/>
      <entry size="2" alignment="2"/>
      <entry size="4" alignment="4"/>
      <entry size="8" alignment="8"/>
      <entry size="16" alignment="16"/>
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="r12" space="ram"/>
  <returnaddress>
    <register name="b0"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f8"/></pentry>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f9"/></pentry>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f10"/></pentry>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f11"/></pentry>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f12"/></pentry>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f13"/></pentry>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f14"/></pentry>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f15"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r32"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r33"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r34"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r35"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r36"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r37"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r38"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r39"/></pentry>
        <pentry minsize="1" maxsize="500" align="8"><addr offset="16" space="stack"/></pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="10" metatype="float" extension="float"><register name="f8"/></pentry>
        <pentry minsize="1" maxsize="8" extension="sign"><register name="r8"/></pentry>
        <pentry minsize="9" maxsize="16"><addr space="join" piece1="r9" piece2="r8"/></pentry>
      </output>
      <unaffected>
        <register name="r1"/>
        <register name="r4"/>
        <register name="r5"/>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r12"/>
        <register name="r13"/>
