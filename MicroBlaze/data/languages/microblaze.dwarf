<dwarf>
  <!-- GCC/binutils MicroBlaze DWARF numbering: 0..31 are r0..r31 (r1 is the stack pointer).
       At function entry the CFA is r1 + 0 (gcc emits "DW_CFA_def_cfa: r1 ofs 0"). -->
  <register_mappings>
    <register_mapping dwarf="0" ghidra="r0"/>
    <register_mapping dwarf="1" ghidra="r1" stackpointer="true"/>
    <register_mapping dwarf="2" ghidra="r2" auto_count="30"/> <!-- r2..r31 -->
  </register_mappings>
  <call_frame_cfa value="0"/>
</dwarf>
