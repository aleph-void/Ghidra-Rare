<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <global>
    <range space="bus"/>
  </global>
  <stackpointer register="SP" space="bus" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="1" size="2"/>
  </returnaddress>
  <default_proto>
    <!-- JSR/RTS: 2-byte return address. Hand-written 65816 code has no fixed calling
         convention; A/C, X and Y are the usual register arguments and results. -->
    <prototype name="__near" extrapop="2" stackshift="2" strategy="register">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="C"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="X"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="Y"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="C"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
    </prototype>
  </default_proto>
  <prototype name="__far" extrapop="3" stackshift="3" strategy="register">
    <!-- JSL/RTL: 3-byte return address (bank included). -->
    <input>
      <pentry minsize="1" maxsize="2">
        <register name="C"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="X"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="Y"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2">
        <register name="C"/>
      </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
    </unaffected>
  </prototype>
</compiler_spec>
