<?xml version="1.0" encoding="UTF-8"?>
<processor_spec>
  <programcounter register="PC"/>
  <context_data>
    <!-- r0 is zero by convention (crt0 clears it and gcc never writes it) -->
    <tracked_set space="ram">
      <set name="r0" val="0"/>
    </tracked_set>
  </context_data>
  <register_data>
    <!-- interrupt pending, cycle counter and JTAG receive change outside program control -->
    <register name="IP" volatile="true"/>
    <register name="CC" volatile="true"/>
    <register name="JRX" volatile="true"/>
  </register_data>
</processor_spec>
