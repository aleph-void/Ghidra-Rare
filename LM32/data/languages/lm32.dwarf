<dwarf>
  <!-- gcc lm32 DWARF register numbers: 0..31 are r0..r25, gp, fp, sp, ra, ea, ba.
       At function entry the CFA is sp + 0. -->
  <register_mappings>
    <register_mapping dwarf="0" ghidra="r0" auto_count="26"/>
    <register_mapping dwarf="26" ghidra="gp"/>
    <register_mapping dwarf="27" ghidra="fp"/>
    <register_mapping dwarf="28" ghidra="sp" stackpointer="true"/>
    <register_mapping dwarf="29" ghidra="ra"/>
    <register_mapping dwarf="30" ghidra="ea"/>
    <register_mapping dwarf="31" ghidra="ba"/>
  </register_mappings>
  <call_frame_cfa value="0"/>
</dwarf>
