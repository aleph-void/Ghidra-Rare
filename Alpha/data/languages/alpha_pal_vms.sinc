# CALL_PAL functions of the OpenVMS PALcode;
# names from the OpenVMS PALcode function list (as MAME alpha_vms prints them).
# Included by alpha.sinc; HALT, DRAINA and IMB are common to all and defined there.
# System calls and the thread-pointer functions model their register results; the rest are
# do_call_pal (a call_pal pcodeop) and fall through.
:CFLUSH       is opcode=0x00 & pcode=0x01 { do_call_pal(0x1:4); }
:LDQP         is opcode=0x00 & pcode=0x03 { do_call_pal(0x3:4); }
:STQP         is opcode=0x00 & pcode=0x04 { do_call_pal(0x4:4); }
:SWPCTX       is opcode=0x00 & pcode=0x05 { do_call_pal(0x5:4); }
:MFPR_ASN     is opcode=0x00 & pcode=0x06 { do_call_pal(0x6:4); }
:CSERVE       is opcode=0x00 & pcode=0x09 { do_call_pal(0x9:4); }
:SWPPAL       is opcode=0x00 & pcode=0x0a { do_call_pal(0xa:4); }
:MFPR_FEN     is opcode=0x00 & pcode=0x0b { do_call_pal(0xb:4); }
:MTPR_FEN     is opcode=0x00 & pcode=0x0c { do_call_pal(0xc:4); }
:MTPR_IPIR    is opcode=0x00 & pcode=0x0d { do_call_pal(0xd:4); }
:MFPR_IPL     is opcode=0x00 & pcode=0x0e { do_call_pal(0xe:4); }
:MTPR_IPL     is opcode=0x00 & pcode=0x0f { do_call_pal(0xf:4); }
:MFPR_MCES    is opcode=0x00 & pcode=0x10 { do_call_pal(0x10:4); }
:MTPR_MCES    is opcode=0x00 & pcode=0x11 { do_call_pal(0x11:4); }
:MFPR_PCBB    is opcode=0x00 & pcode=0x12 { do_call_pal(0x12:4); }
:MFPR_PRBR    is opcode=0x00 & pcode=0x13 { do_call_pal(0x13:4); }
:MTPR_PRBR    is opcode=0x00 & pcode=0x14 { do_call_pal(0x14:4); }
:MFPR_PTBR    is opcode=0x00 & pcode=0x15 { do_call_pal(0x15:4); }
:MFPR_SCBB    is opcode=0x00 & pcode=0x16 { do_call_pal(0x16:4); }
:MTPR_SCBB    is opcode=0x00 & pcode=0x17 { do_call_pal(0x17:4); }
:MTPR_SIRR    is opcode=0x00 & pcode=0x18 { do_call_pal(0x18:4); }
:MFPR_SISR    is opcode=0x00 & pcode=0x19 { do_call_pal(0x19:4); }
:MFPR_TBCHK   is opcode=0x00 & pcode=0x1a { do_call_pal(0x1a:4); }
:MTPR_TBIA    is opcode=0x00 & pcode=0x1b { do_call_pal(0x1b:4); }
:MTPR_TBIAP   is opcode=0x00 & pcode=0x1c { do_call_pal(0x1c:4); }
:MTPR_TBIS    is opcode=0x00 & pcode=0x1d { do_call_pal(0x1d:4); }
:MFPR_ESP     is opcode=0x00 & pcode=0x1e { do_call_pal(0x1e:4); }
:MTPR_ESP     is opcode=0x00 & pcode=0x1f { do_call_pal(0x1f:4); }
:MFPR_SSP     is opcode=0x00 & pcode=0x20 { do_call_pal(0x20:4); }
:MTPR_SSP     is opcode=0x00 & pcode=0x21 { do_call_pal(0x21:4); }
:MFPR_USP     is opcode=0x00 & pcode=0x22 { do_call_pal(0x22:4); }
:MTPR_USP     is opcode=0x00 & pcode=0x23 { do_call_pal(0x23:4); }
:MTPR_TBISD   is opcode=0x00 & pcode=0x24 { do_call_pal(0x24:4); }
:MTPR_TBISI   is opcode=0x00 & pcode=0x25 { do_call_pal(0x25:4); }
:MTPR_ASTEN   is opcode=0x00 & pcode=0x26 { do_call_pal(0x26:4); }
:MTPR_ASTSR   is opcode=0x00 & pcode=0x27 { do_call_pal(0x27:4); }
:MFPR_VPTB    is opcode=0x00 & pcode=0x29 { do_call_pal(0x29:4); }
:MTPR_VPTB    is opcode=0x00 & pcode=0x2a { do_call_pal(0x2a:4); }
:MTPR_PERFMON is opcode=0x00 & pcode=0x2b { do_call_pal(0x2b:4); }
:MTPR_DATFX   is opcode=0x00 & pcode=0x2e { do_call_pal(0x2e:4); }
:WTINT        is opcode=0x00 & pcode=0x3e { do_call_pal(0x3e:4); }
:MFPR_WHAMI   is opcode=0x00 & pcode=0x3f { do_call_pal(0x3f:4); }
:BPT          is opcode=0x00 & pcode=0x80 { do_call_pal(0x80:4); }
:BUGCHK       is opcode=0x00 & pcode=0x81 { do_call_pal(0x81:4); }
:CHME         is opcode=0x00 & pcode=0x82 { do_call_pal(0x82:4); }
:CHMK         is opcode=0x00 & pcode=0x83 { R0 = syscall(R0, R16, R17, R18, R19, R20, R21); }
:CHMS         is opcode=0x00 & pcode=0x84 { do_call_pal(0x84:4); }
:CHMU         is opcode=0x00 & pcode=0x85 { do_call_pal(0x85:4); }
:INSQHIL      is opcode=0x00 & pcode=0x87 { do_call_pal(0x87:4); }
:INSQTIL      is opcode=0x00 & pcode=0x88 { do_call_pal(0x88:4); }
:INSQHIQ      is opcode=0x00 & pcode=0x89 { do_call_pal(0x89:4); }
:INSQTIQ      is opcode=0x00 & pcode=0x8a { do_call_pal(0x8a:4); }
:INSQUEL      is opcode=0x00 & pcode=0x8b { do_call_pal(0x8b:4); }
:INSQUEQ      is opcode=0x00 & pcode=0x8c { do_call_pal(0x8c:4); }
:INSQUEL^"/D" is opcode=0x00 & pcode=0x8d { do_call_pal(0x8d:4); }
:INSQUEQ^"/D" is opcode=0x00 & pcode=0x8e { do_call_pal(0x8e:4); }
:PROBER       is opcode=0x00 & pcode=0x8f { do_call_pal(0x8f:4); }
:PROBEW       is opcode=0x00 & pcode=0x90 { do_call_pal(0x90:4); }
:RD_PS        is opcode=0x00 & pcode=0x91 { do_call_pal(0x91:4); }
:REI          is opcode=0x00 & pcode=0x92 { do_call_pal(0x92:4); }
:REMQHIL      is opcode=0x00 & pcode=0x93 { do_call_pal(0x93:4); }
:REMQTIL      is opcode=0x00 & pcode=0x94 { do_call_pal(0x94:4); }
:REMQHIQ      is opcode=0x00 & pcode=0x95 { do_call_pal(0x95:4); }
:REMQTIQ      is opcode=0x00 & pcode=0x96 { do_call_pal(0x96:4); }
:REMQUEL      is opcode=0x00 & pcode=0x97 { do_call_pal(0x97:4); }
:REMQUEQ      is opcode=0x00 & pcode=0x98 { do_call_pal(0x98:4); }
:REMQUEL^"/D" is opcode=0x00 & pcode=0x99 { do_call_pal(0x99:4); }
:REMQUEQ^"/D" is opcode=0x00 & pcode=0x9a { do_call_pal(0x9a:4); }
:SWASTEN      is opcode=0x00 & pcode=0x9b { do_call_pal(0x9b:4); }
:WR_PS_SW     is opcode=0x00 & pcode=0x9c { do_call_pal(0x9c:4); }
:RSCC         is opcode=0x00 & pcode=0x9d { do_call_pal(0x9d:4); }
:READ_UNQ     is opcode=0x00 & pcode=0x9e { R0 = read_unique(); }
:WRITE_UNQ    is opcode=0x00 & pcode=0x9f { write_unique(R16); }
:AMOVRR       is opcode=0x00 & pcode=0xa0 { do_call_pal(0xa0:4); }
:AMOVRM       is opcode=0x00 & pcode=0xa1 { do_call_pal(0xa1:4); }
:INSQHILR     is opcode=0x00 & pcode=0xa2 { do_call_pal(0xa2:4); }
:INSQTILR     is opcode=0x00 & pcode=0xa3 { do_call_pal(0xa3:4); }
:INSQHIQR     is opcode=0x00 & pcode=0xa4 { do_call_pal(0xa4:4); }
:INSQTIQR     is opcode=0x00 & pcode=0xa5 { do_call_pal(0xa5:4); }
:REMQHILR     is opcode=0x00 & pcode=0xa6 { do_call_pal(0xa6:4); }
:REMQTILR     is opcode=0x00 & pcode=0xa7 { do_call_pal(0xa7:4); }
:REMQHIQR     is opcode=0x00 & pcode=0xa8 { do_call_pal(0xa8:4); }
:REMQTIQR     is opcode=0x00 & pcode=0xa9 { do_call_pal(0xa9:4); }
:GENTRAP      is opcode=0x00 & pcode=0xaa { do_call_pal(0xaa:4); }
:CLRFEN       is opcode=0x00 & pcode=0xae { do_call_pal(0xae:4); }
