# CALL_PAL functions of the Windows NT PALcode;
# names from the Alpha AXP Windows NT PALcode function list (as MAME alpha_nt prints them).
# Included by alpha.sinc; HALT, DRAINA and IMB are common to all and defined there.
# System calls and the thread-pointer functions model their register results; the rest are
# do_call_pal (a call_pal pcodeop) and fall through.
:RESTART      is opcode=0x00 & pcode=0x01 { do_call_pal(0x1:4); }
:REBOOT       is opcode=0x00 & pcode=0x03 { do_call_pal(0x3:4); }
:INITPAL      is opcode=0x00 & pcode=0x04 { do_call_pal(0x4:4); }
:WRENTRY      is opcode=0x00 & pcode=0x05 { do_call_pal(0x5:4); }
:SWPIRQL      is opcode=0x00 & pcode=0x06 { do_call_pal(0x6:4); }
:RDIRQL       is opcode=0x00 & pcode=0x07 { do_call_pal(0x7:4); }
:DI           is opcode=0x00 & pcode=0x08 { do_call_pal(0x8:4); }
:EI           is opcode=0x00 & pcode=0x09 { do_call_pal(0x9:4); }
:SWPPAL       is opcode=0x00 & pcode=0x0a { do_call_pal(0xa:4); }
:SSIR         is opcode=0x00 & pcode=0x0c { do_call_pal(0xc:4); }
:CSIR         is opcode=0x00 & pcode=0x0d { do_call_pal(0xd:4); }
:RFE          is opcode=0x00 & pcode=0x0e { do_call_pal(0xe:4); }
:RETSYS       is opcode=0x00 & pcode=0x0f { do_call_pal(0xf:4); }
:SWPCTX       is opcode=0x00 & pcode=0x10 { do_call_pal(0x10:4); }
:SWPPROCESS   is opcode=0x00 & pcode=0x11 { do_call_pal(0x11:4); }
:RDMCES       is opcode=0x00 & pcode=0x12 { do_call_pal(0x12:4); }
:WRMCES       is opcode=0x00 & pcode=0x13 { do_call_pal(0x13:4); }
:TBIA         is opcode=0x00 & pcode=0x14 { do_call_pal(0x14:4); }
:TBIS         is opcode=0x00 & pcode=0x15 { do_call_pal(0x15:4); }
:DTBIS        is opcode=0x00 & pcode=0x16 { do_call_pal(0x16:4); }
:TBISASN      is opcode=0x00 & pcode=0x17 { do_call_pal(0x17:4); }
:RDKSP        is opcode=0x00 & pcode=0x18 { do_call_pal(0x18:4); }
:SWPKSP       is opcode=0x00 & pcode=0x19 { do_call_pal(0x19:4); }
:RDPSR        is opcode=0x00 & pcode=0x1a { do_call_pal(0x1a:4); }
:RDPCR        is opcode=0x00 & pcode=0x1c { do_call_pal(0x1c:4); }
:RDTHREAD     is opcode=0x00 & pcode=0x1e { do_call_pal(0x1e:4); }
:WRPERFMON    is opcode=0x00 & pcode=0x20 { do_call_pal(0x20:4); }
:RDCOUNTERS   is opcode=0x00 & pcode=0x30 { do_call_pal(0x30:4); }
:RDSTATE      is opcode=0x00 & pcode=0x31 { do_call_pal(0x31:4); }
:BPT          is opcode=0x00 & pcode=0x80 { do_call_pal(0x80:4); }
:CALLSYS      is opcode=0x00 & pcode=0x83 { v0 = syscall(v0, a0, a1, a2, a3, a4, a5); }
:GENTRAP      is opcode=0x00 & pcode=0xaa { do_call_pal(0xaa:4); }
:RDTEB        is opcode=0x00 & pcode=0xab { v0 = read_teb(); }
:KBPT         is opcode=0x00 & pcode=0xac { do_call_pal(0xac:4); }
:CALLKD       is opcode=0x00 & pcode=0xad { do_call_pal(0xad:4); }
