# CALL_PAL functions of the Digital UNIX / Tru64 / Linux (OSF/1 PALcode) PALcode;
# names from the Linux kernel asm/pal.h; rduniq/wruniq as GNU as spells them.
# Included by alpha.sinc; HALT, DRAINA and IMB are common to all and defined there.
# System calls and the thread-pointer functions model their register results; the rest are
# do_call_pal (a call_pal pcodeop) and fall through.
:CFLUSH       is opcode=0x00 & pcode=0x01 { do_call_pal(0x1:4); }
:CSERVE       is opcode=0x00 & pcode=0x09 { do_call_pal(0x9:4); }
:SWPPAL       is opcode=0x00 & pcode=0x0a { do_call_pal(0xa:4); }
:WRIPIR       is opcode=0x00 & pcode=0x0d { do_call_pal(0xd:4); }
:RDMCES       is opcode=0x00 & pcode=0x10 { do_call_pal(0x10:4); }
:WRMCES       is opcode=0x00 & pcode=0x11 { do_call_pal(0x11:4); }
:WRFEN        is opcode=0x00 & pcode=0x2b { do_call_pal(0x2b:4); }
:WRVPTPTR     is opcode=0x00 & pcode=0x2d { do_call_pal(0x2d:4); }
:SWPCTX       is opcode=0x00 & pcode=0x30 { do_call_pal(0x30:4); }
:WRVAL        is opcode=0x00 & pcode=0x31 { do_call_pal(0x31:4); }
:RDVAL        is opcode=0x00 & pcode=0x32 { do_call_pal(0x32:4); }
:TBI          is opcode=0x00 & pcode=0x33 { do_call_pal(0x33:4); }
:WRENT        is opcode=0x00 & pcode=0x34 { do_call_pal(0x34:4); }
:SWPIPL       is opcode=0x00 & pcode=0x35 { do_call_pal(0x35:4); }
:RDPS         is opcode=0x00 & pcode=0x36 { do_call_pal(0x36:4); }
:WRKGP        is opcode=0x00 & pcode=0x37 { do_call_pal(0x37:4); }
:WRUSP        is opcode=0x00 & pcode=0x38 { do_call_pal(0x38:4); }
:WRPERFMON    is opcode=0x00 & pcode=0x39 { do_call_pal(0x39:4); }
:RDUSP        is opcode=0x00 & pcode=0x3a { do_call_pal(0x3a:4); }
:WHAMI        is opcode=0x00 & pcode=0x3c { do_call_pal(0x3c:4); }
:RETSYS       is opcode=0x00 & pcode=0x3d { do_call_pal(0x3d:4); }
:WTINT        is opcode=0x00 & pcode=0x3e { do_call_pal(0x3e:4); }
:RTI          is opcode=0x00 & pcode=0x3f { do_call_pal(0x3f:4); }
:BPT          is opcode=0x00 & pcode=0x80 { do_call_pal(0x80:4); }
:BUGCHK       is opcode=0x00 & pcode=0x81 { do_call_pal(0x81:4); }
:CALLSYS      is opcode=0x00 & pcode=0x83 { v0 = syscall(v0, a0, a1, a2, a3, a4, a5); a3 = syscall_error(); }
:URTI         is opcode=0x00 & pcode=0x92 { do_call_pal(0x92:4); }
:RDUNIQ       is opcode=0x00 & pcode=0x9e { v0 = read_unique(); }
:WRUNIQ       is opcode=0x00 & pcode=0x9f { write_unique(a0); }
:GENTRAP      is opcode=0x00 & pcode=0xaa { do_call_pal(0xaa:4); }
:CLRFEN       is opcode=0x00 & pcode=0xae { do_call_pal(0xae:4); }
