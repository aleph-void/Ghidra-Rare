<?xml version="1.0" encoding="UTF-8"?>

<processor_spec>
  <programcounter register="PC"/>
  <data_space space="ram"/>

  <!-- Near (16-bit) addresses are in F0000-FFFFF; ES: addresses in (ES & 0xF) << 16:
       segment(seg, offset) = zext(seg) << 16 | zext(offset) -->
  <segmentop space="ram" userop="segment" farpointer="no">
    <pcode>
      <input name="base" size="1"/>
      <input name="inner" size="2"/>
      <output name="res" size="3"/>
      <body><![CDATA[
        res = (zext(base) << 16) | zext(inner);
      ]]></body>
    </pcode>
    <constresolve>
      <register name="NEARSEG"/>
    </constresolve>
  </segmentop>

  <context_data>
    <tracked_set space="ram">
      <set name="NEARSEG" val="0xF"/>
    </tracked_set>
  </context_data>

  <register_data>
    <register name="contextreg" hidden="true"/>
    <register name="NEARSEG" hidden="true"/>
  </register_data>

  <!-- Special function registers: every access is kept (status polling, transmit buffers). -->
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="ram" first="0xF0000" last="0xF07FF"/>  <!-- 2nd SFR area -->
    <range space="ram" first="0xFFF00" last="0xFFFEF"/>  <!-- SFR area -->
  </volatile>

  <!-- Vectors hold 16-bit handler addresses; ghidra_scripts/RL78Vectors.java follows them in a
       raw image (an ELF import starts from its entry point and symbols). -->
  <default_symbols>
    <symbol name="RESET" address="ram:000000" type="code_ptr"/>
    <symbol name="vector_table" address="ram:000002"/>
    <symbol name="callt_area" address="ram:000080"/>
    <symbol name="option_byte_area" address="ram:0000C0"/>
    <symbol name="security_settings_area" address="ram:0000C4"/>
  </default_symbols>
</processor_spec>
