# sleigh specification file for Renesas RL78
# Definitions shared by rl78.slaspec (RL78-S3 core) and rl78_s2.slaspec (RL78-S1/S2 cores).
# The instructions themselves are generated into rl78.sinc by tools/gen_rl78.py.

define endian=little;
define alignment=1;

# 20-bit address space; data accesses without the ES: prefix go to the near area F0000-FFFFF.
define space ram      type=ram_space      size=3  default;
define space register type=register_space size=1;

# General-purpose registers, four banks (PSW.RBS1:RBS0 selects one), and the CPU registers are
# memory-mapped: bank 3 at FFEE0, bank 2 at FFEE8, bank 1 at FFEF0, bank 0 at FFEF8, and
# SPL SPH PSW - CS ES PMC MEM at FFFF8-FFFFF. They are named varnodes in RAM so that accesses by
# address (GCC keeps its virtual registers r8-r31 in banks 1-3 and reads them as saddr) alias
# the registers. The current bank is the "bank" context field, set by SEL RBn.
define ram offset=0xFFEE0 size=1 [
	RB3_X RB3_A RB3_C RB3_B RB3_E RB3_D RB3_L RB3_H
	RB2_X RB2_A RB2_C RB2_B RB2_E RB2_D RB2_L RB2_H
	RB1_X RB1_A RB1_C RB1_B RB1_E RB1_D RB1_L RB1_H
	X A C B E D L H
];
define ram offset=0xFFEE0 size=2 [
	RB3_AX RB3_BC RB3_DE RB3_HL
	RB2_AX RB2_BC RB2_DE RB2_HL
	RB1_AX RB1_BC RB1_DE RB1_HL
	AX BC DE HL
];
define ram offset=0xFFEE0 size=4 [
	RB3_BCAX RB3_HLDE
	RB2_BCAX RB2_HLDE
	RB1_BCAX RB1_HLDE
	BCAX HLDE
];
define ram offset=0xFFFF8 size=2 [ SP ];
define ram offset=0xFFFF8 size=1 [ SPL SPH PSW _ CS ES PMC MEM ];
# Multiply-accumulate result register (RL78-S3), an SFR at FFFF0-FFFF3
define ram offset=0xFFFF0 size=4 [ MACR ];
define ram offset=0xFFFF0 size=2 [ MACRL MACRH ];

define register offset=0x00 size=3 [ PC ];
define register offset=0x10 size=4 contextreg;
# Segment (upper four address bits) of the near area F0000-FFFFF: always 0xF. The pspec tracks it
# as a constant; the segment() userop (pspec segmentop: zext(seg) << 16 | zext(offset)) lets the
# decompiler treat 16-bit near pointers and SP as pointers.
define register offset=0x20 size=1 [ NEARSEG ];
define pcodeop segment;

define bitrange CY=PSW[0,1]
                ISP0=PSW[1,1]
                ISP1=PSW[2,1]
                RBS0=PSW[3,1]
                AC=PSW[4,1]
                RBS1=PSW[5,1]
                Z=PSW[6,1]
                IE=PSW[7,1]
;

define context contextreg
	phase = (0,0)          # 0: prefix/skip wrappers, 1: the instruction itself
	esp   = (1,1)          # an ES: prefix (0x11) precedes the instruction
	skip  = (2,4) noflow   # condition of a preceding SKcc (1 c, 2 nc, 3 z, 4 nz, 5 h, 6 nh)
	bank  = (5,6)          # register bank selected by SEL RBn
;

define token opbyte (8)
	op    = (0,7)
	op_hi = (4,7)
	op_lo = (0,3)
	r3    = (0,2)
	b0    = (0,0)
	b3    = (3,3)
	b7    = (7,7)
	frp12 = (1,2)
	frp45 = (4,5)
	frg01 = (0,1)
	bitn  = (4,6)
	cnt   = (4,6)
	wcnt  = (4,7)
	nnn   = (4,6)
	mm    = (0,1)
;
define token immbyte (8)
	imm8  = (0,7)
	simm8 = (0,7) signed
	s_hi3 = (5,7)
;
define token immword (16)
	imm16  = (0,15)
	simm16 = (0,15) signed
;
define token immaddr (24)
	imm20 = (0,19)
;

define pcodeop halt;
define pcodeop stop;
define pcodeop brk;
define pcodeop brk1;

# ---- flag helpers ----
macro add8(d, s) {
	local a:1 = d; local b:1 = s;
	AC = ((a & 0xF) + (b & 0xF)) > 0xF;
	CY = carry(a, b);
	d = a + b;
	Z = (a + b) == 0;
}
macro addc8(d, s) {
	local a:1 = d; local b:1 = s; local c:1 = CY;
	AC = ((a & 0xF) + (b & 0xF) + c) > 0xF;
	local w:2 = zext(a) + zext(b) + zext(c);
	CY = w > 0xFF;
	local r:1 = a + b + c;
	d = r;
	Z = r == 0;
}
macro sub8(d, s) {
	local a:1 = d; local b:1 = s;
	AC = (a & 0xF) < (b & 0xF);
	CY = a < b;
	local r:1 = a - b;
	d = r;
	Z = r == 0;
}
macro subc8(d, s) {
	local a:1 = d; local b:1 = s; local c:1 = CY;
	AC = (a & 0xF) < ((b & 0xF) + c);
	local bb:2 = zext(b) + zext(c);
	CY = zext(a) < bb;
	local r:1 = a - b - c;
	d = r;
	Z = r == 0;
}
macro cmp8(d, s) {
	local a:1 = d; local b:1 = s;
	AC = (a & 0xF) < (b & 0xF);
	CY = a < b;
	Z = a == b;
}
macro and8(d, s) { local r:1 = d & s; d = r; Z = r == 0; }
macro or8(d, s)  { local r:1 = d | s; d = r; Z = r == 0; }
macro xor8(d, s) { local r:1 = d ^ s; d = r; Z = r == 0; }
macro cmp0(d) { Z = d == 0; AC = 0; CY = 0; }
macro inc8(d) { local a:1 = d; AC = (a & 0xF) == 0xF; local r:1 = a + 1; d = r; Z = r == 0; }
macro dec8(d) { local a:1 = d; AC = (a & 0xF) == 0; local r:1 = a - 1; d = r; Z = r == 0; }

# 16-bit: AC is undefined after ADDW/SUBW/CMPW (manual) and is left unchanged here.
macro add16(d, s) { local a:2 = d; local b:2 = s; CY = carry(a, b); local r:2 = a + b; d = r; Z = r == 0; }
macro sub16(d, s) { local a:2 = d; local b:2 = s; CY = a < b; local r:2 = a - b; d = r; Z = r == 0; }
macro cmp16(d, s) { local a:2 = d; local b:2 = s; CY = a < b; Z = a == b; }

# Shifts by a count encoded in the instruction (0 leaves the operand and CY unchanged).
macro shl8(d, n)  { if (n == 0) goto <e>; CY = (d >> (8 - n)) & 1; d = d << n; <e> }
macro shr8(d, n)  { if (n == 0) goto <e>; CY = (d >> (n - 1)) & 1; d = d >> n; <e> }
macro sar8(d, n)  { if (n == 0) goto <e>; CY = (d s>> (n - 1)) & 1; d = d s>> n; <e> }
macro shl16(d, n) { if (n == 0) goto <e>; CY = ((d >> (16 - n)) & 1) != 0; d = d << n; <e> }
macro shr16(d, n) { if (n == 0) goto <e>; CY = ((d >> (n - 1)) & 1) != 0; d = d >> n; <e> }
macro sar16(d, n) { if (n == 0) goto <e>; CY = ((d s>> (n - 1)) & 1) != 0; d = d s>> n; <e> }

# CALL/CALLT/BRK save PC as three bytes at SP-4..SP-2; SP-1 holds PSW for BRK and interrupts.
macro pushpc(ret) {
	local sp:2 = SP - 4;
	local sa:3 = segment(NEARSEG, sp);
	local r:3 = ret;
	*[ram]:3 sa = r;
	SP = SP - 4;
}

# ---- prefix and skip wrappers ----
# ES: prefix: applies ES to the memory operand of the following instruction.
:^instruction is phase=1 & op=0x11; instruction [ esp = 1; ] { build instruction; }

# SKcc skips the next instruction when its condition holds (the skip instruction sets "skip" on
# the following address).
:^instruction is phase=0 & skip=0 & instruction [ phase = 1; ] { build instruction; }
:^instruction is phase=0 & skip=1 & instruction [ phase = 1; ] { if (CY == 1) goto inst_next; build instruction; }
:^instruction is phase=0 & skip=2 & instruction [ phase = 1; ] { if (CY == 0) goto inst_next; build instruction; }
:^instruction is phase=0 & skip=3 & instruction [ phase = 1; ] { if (Z == 1) goto inst_next; build instruction; }
:^instruction is phase=0 & skip=4 & instruction [ phase = 1; ] { if (Z == 0) goto inst_next; build instruction; }
:^instruction is phase=0 & skip=5 & instruction [ phase = 1; ] { if ((Z | CY) == 0) goto inst_next; build instruction; }
:^instruction is phase=0 & skip=6 & instruction [ phase = 1; ] { if ((Z | CY) == 1) goto inst_next; build instruction; }

@include "rl78.sinc"
