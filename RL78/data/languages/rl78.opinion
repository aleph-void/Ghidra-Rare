<opinions>
    <!-- EM_RL78 = 197. e_flags bits 2-3 give the CPU: 0x0c G14 (RL78-S3), 0x08 G13, 0x04 G10
         (RL78-S2/S1, no multiply/divide), 0 unspecified. -->
    <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
        <constraint primary="197" processor="RL78" endian="little" size="16" variant="default"
            secondary="0b.... .... .... .... .... .... .... 00.."/>
        <constraint primary="197" processor="RL78" endian="little" size="16" variant="default"
            secondary="0b.... .... .... .... .... .... .... 11.."/>
        <constraint primary="197" processor="RL78" endian="little" size="16" variant="S2"
            secondary="0b.... .... .... .... .... .... .... 10.."/>
        <constraint primary="197" processor="RL78" endian="little" size="16" variant="S2"
            secondary="0b.... .... .... .... .... .... .... 01.."/>
    </constraint>
</opinions>
