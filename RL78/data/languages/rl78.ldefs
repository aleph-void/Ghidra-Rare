<?xml version="1.0" encoding="UTF-8"?>

<language_definitions>

   <language processor="RL78"
            endian="little"
            size="16"
            variant="default"
            version="1.1"
            slafile="rl78.sla"
            processorspec="rl78.pspec"
            id="RL78:LE:16:default">
    <description>Renesas RL78-S3 core (RL78/G14, G23, ...): includes multiply/divide/MAC</description>
    <compiler name="default" spec="rl78.cspec" id="default"/>
    <external_name tool="gnu" name="rl78"/>
    <external_name tool="DWARF.register.mapping.file" name="rl78.dwarf"/>
  </language>

   <language processor="RL78"
            endian="little"
            size="16"
            variant="S2"
            version="1.1"
            slafile="rl78_s2.sla"
            processorspec="rl78.pspec"
            id="RL78:LE:16:S2">
    <description>Renesas RL78-S1/S2 cores (RL78/G10, G12, G13, ...): no multiply/divide/MAC</description>
    <compiler name="default" spec="rl78.cspec" id="default"/>
    <external_name tool="gnu" name="rl78"/>
    <external_name tool="DWARF.register.mapping.file" name="rl78.dwarf"/>
  </language>

</language_definitions>
