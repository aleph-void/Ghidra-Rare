# ---- 16-bit ALU ----
:addw rAX, abs2 is phase=1 & op=0x02 & rAX; abs2 { add16(rAX, abs2); }
:addw rAX, #imm16 is phase=1 & op=0x04 & rAX; imm16 { add16(rAX, imm16:2); }
:addw rAX, saddr2 is phase=1 & op=0x06 & rAX; saddr2 { add16(rAX, saddr2); }
:addw rAX, rp12 is phase=1 & op_hi=0 & b3=0 & b0=1 & rAX & rp12 { add16(rAX, rp12); }
:addw rAX, dspHL2 is phase=1 & op=0x61; op=0x09 & rAX; dspHL2 { add16(rAX, dspHL2); }
:subw rAX, abs2 is phase=1 & op=0x22 & rAX; abs2 { sub16(rAX, abs2); }
:subw rAX, #imm16 is phase=1 & op=0x24 & rAX; imm16 { sub16(rAX, imm16:2); }
:subw rAX, saddr2 is phase=1 & op=0x26 & rAX; saddr2 { sub16(rAX, saddr2); }
:subw rAX, rp12 is phase=1 & op_hi=2 & b3=0 & b0=1 & rAX & rp12 { sub16(rAX, rp12); }
:subw rAX, dspHL2 is phase=1 & op=0x61; op=0x29 & rAX; dspHL2 { sub16(rAX, dspHL2); }
:cmpw rAX, abs2 is phase=1 & op=0x42 & rAX; abs2 { cmp16(rAX, abs2); }
:cmpw rAX, #imm16 is phase=1 & op=0x44 & rAX; imm16 { cmp16(rAX, imm16:2); }
:cmpw rAX, saddr2 is phase=1 & op=0x46 & rAX; saddr2 { cmp16(rAX, saddr2); }
:cmpw rAX, rp12 is phase=1 & op_hi=4 & b3=0 & b0=1 & rAX & rp12 & frp12!=0 { cmp16(rAX, rp12); }
:cmpw rAX, dspHL2 is phase=1 & op=0x61; op=0x49 & rAX; dspHL2 { cmp16(rAX, dspHL2); }
:addw "SP", #imm8 is phase=1 & op=0x10; imm8 { SP = SP + imm8; }
:subw "SP", #imm8 is phase=1 & op=0x20; imm8 { SP = SP - imm8; }

# ---- inc/dec ----
:inc r8 is phase=1 & op_hi=8 & b3=0 & r8 { inc8(r8); }
:inc abs1 is phase=1 & op=0xA0; abs1 { inc8(abs1); }
:inc saddr1 is phase=1 & op=0xA4; saddr1 { inc8(saddr1); }
:inc dspHL1 is phase=1 & op=0x61; op=0x59; dspHL1 { inc8(dspHL1); }
:dec r8 is phase=1 & op_hi=9 & b3=0 & r8 { dec8(r8); }
:dec abs1 is phase=1 & op=0xB0; abs1 { dec8(abs1); }
:dec saddr1 is phase=1 & op=0xB4; saddr1 { dec8(saddr1); }
:dec dspHL1 is phase=1 & op=0x61; op=0x69; dspHL1 { dec8(dspHL1); }
:incw rp12 is phase=1 & op_hi=10 & b3=0 & b0=1 & rp12 { rp12 = rp12 + 1; }
:incw abs2 is phase=1 & op=0xA2; abs2 { abs2 = abs2 + 1; }
:incw saddr2 is phase=1 & op=0xA6; saddr2 { saddr2 = saddr2 + 1; }
:incw dspHL2 is phase=1 & op=0x61; op=0x79; dspHL2 { dspHL2 = dspHL2 + 1; }
:decw rp12 is phase=1 & op_hi=11 & b3=0 & b0=1 & rp12 { rp12 = rp12 - 1; }
:decw abs2 is phase=1 & op=0xB2; abs2 { abs2 = abs2 - 1; }
:decw saddr2 is phase=1 & op=0xB6; saddr2 { saddr2 = saddr2 - 1; }
:decw dspHL2 is phase=1 & op=0x61; op=0x89; dspHL2 { dspHL2 = dspHL2 - 1; }

# ---- mov ----
:mov r8, #imm8 is phase=1 & op_hi=5 & b3=0 & r8; imm8 { r8 = imm8; }
:mov rA, r8 is phase=1 & op_hi=6 & b3=0 & r3!=1 & r8 & rA { rA = r8; }
:mov r8, rA is phase=1 & op_hi=7 & b3=0 & r3!=1 & r8 & rA { r8 = rA; }
:mov saddr1, #imm8 is phase=1 & op=0xCD; saddr1; imm8 { saddr1 = imm8; }
:mov sfr1, #imm8 is phase=1 & op=0xCE; sfr1; imm8 { sfr1 = imm8; }
:mov abs1, #imm8 is phase=1 & op=0xCF; abs1; imm8 { abs1 = imm8; }
:mov rA, saddr1 is phase=1 & op=0x8D & rA; saddr1 { rA = saddr1; }
:mov saddr1, rA is phase=1 & op=0x9D & rA; saddr1 { saddr1 = rA; }
:mov rA, sfr1 is phase=1 & op=0x8E & rA; sfr1 { rA = sfr1; }
:mov sfr1, rA is phase=1 & op=0x9E & rA; sfr1 { sfr1 = rA; }
:mov rA, abs1 is phase=1 & op=0x8F & rA; abs1 { rA = abs1; }
:mov abs1, rA is phase=1 & op=0x9F & rA; abs1 { abs1 = rA; }
:mov "ES", #imm8 is phase=1 & op=0x41; imm8 { ES = imm8; }
:mov "ES", saddr1 is phase=1 & op=0x61; op=0xB8; saddr1 { ES = saddr1; }
:mov rA, indDE1 is phase=1 & op=0x89 & rA & indDE1 { rA = indDE1; }
:mov indDE1, rA is phase=1 & op=0x99 & rA & indDE1 { indDE1 = rA; }
:mov rA, indHL1 is phase=1 & op=0x8B & rA & indHL1 { rA = indHL1; }
:mov indHL1, rA is phase=1 & op=0x9B & rA & indHL1 { indHL1 = rA; }
:mov rA, dspDE1 is phase=1 & op=0x8A & rA; dspDE1 { rA = dspDE1; }
:mov dspDE1, rA is phase=1 & op=0x9A & rA; dspDE1 { dspDE1 = rA; }
:mov dspDE1, #imm8 is phase=1 & op=0xCA; dspDE1; imm8 { dspDE1 = imm8; }
:mov rA, dspHL1 is phase=1 & op=0x8C & rA; dspHL1 { rA = dspHL1; }
:mov dspHL1, rA is phase=1 & op=0x9C & rA; dspHL1 { dspHL1 = rA; }
:mov dspHL1, #imm8 is phase=1 & op=0xCC; dspHL1; imm8 { dspHL1 = imm8; }
:mov rA, dspSP1 is phase=1 & op=0x88 & rA; dspSP1 { rA = dspSP1; }
:mov dspSP1, rA is phase=1 & op=0x98 & rA; dspSP1 { dspSP1 = rA; }
:mov dspSP1, #imm8 is phase=1 & op=0xC8; dspSP1; imm8 { dspSP1 = imm8; }
:mov rA, idxB1 is phase=1 & op=0x61; op=0xC9 & rA & idxB1 { rA = idxB1; }
:mov idxB1, rA is phase=1 & op=0x61; op=0xD9 & rA & idxB1 { idxB1 = rA; }
:mov rA, idxC1 is phase=1 & op=0x61; op=0xE9 & rA & idxC1 { rA = idxC1; }
:mov idxC1, rA is phase=1 & op=0x61; op=0xF9 & rA & idxC1 { idxC1 = rA; }
:mov rA, wdB1 is phase=1 & op=0x09 & rA; wdB1 { rA = wdB1; }
:mov wdB1, rA is phase=1 & op=0x18 & rA; wdB1 { wdB1 = rA; }
:mov wdB1, #imm8 is phase=1 & op=0x19; wdB1; imm8 { wdB1 = imm8; }
:mov rA, wdC1 is phase=1 & op=0x29 & rA; wdC1 { rA = wdC1; }
:mov wdC1, rA is phase=1 & op=0x28 & rA; wdC1 { wdC1 = rA; }
:mov wdC1, #imm8 is phase=1 & op=0x38; wdC1; imm8 { wdC1 = imm8; }
:mov rA, wdBC1 is phase=1 & op=0x49 & rA; wdBC1 { rA = wdBC1; }
:mov wdBC1, rA is phase=1 & op=0x48 & rA; wdBC1 { wdBC1 = rA; }
:mov wdBC1, #imm8 is phase=1 & op=0x39; wdBC1; imm8 { wdBC1 = imm8; }
:mov rX, saddr1 is phase=1 & op=0xD8 & rX; saddr1 { rX = saddr1; }
:mov rX, abs1 is phase=1 & op=0xD9 & rX; abs1 { rX = abs1; }
:mov rB, saddr1 is phase=1 & op=0xE8 & rB; saddr1 { rB = saddr1; }
:mov rB, abs1 is phase=1 & op=0xE9 & rB; abs1 { rB = abs1; }
:mov rC, saddr1 is phase=1 & op=0xF8 & rC; saddr1 { rC = saddr1; }
:mov rC, abs1 is phase=1 & op=0xF9 & rC; abs1 { rC = abs1; }

# ---- xch ----
:xch rA, rX is phase=1 & op=0x08 & rA & rX { local t:1 = rA; rA = rX; rX = t; }
:xch rA, r8 is phase=1 & op=0x61; op_hi=8 & b3=1 & r3!=1 & r8 & rA { local t:1 = rA; rA = r8; r8 = t; }
:xch rA, saddr1 is phase=1 & op=0x61; op=0xA8 & rA; saddr1 { local t:1 = rA; rA = saddr1; saddr1 = t; }
:xch rA, idxC1 is phase=1 & op=0x61; op=0xA9 & rA & idxC1 { local t:1 = rA; rA = idxC1; idxC1 = t; }
:xch rA, abs1 is phase=1 & op=0x61; op=0xAA & rA; abs1 { local t:1 = rA; rA = abs1; abs1 = t; }
:xch rA, sfr1 is phase=1 & op=0x61; op=0xAB & rA; sfr1 { local t:1 = rA; rA = sfr1; sfr1 = t; }
:xch rA, indHL1 is phase=1 & op=0x61; op=0xAC & rA & indHL1 { local t:1 = rA; rA = indHL1; indHL1 = t; }
:xch rA, dspHL1 is phase=1 & op=0x61; op=0xAD & rA; dspHL1 { local t:1 = rA; rA = dspHL1; dspHL1 = t; }
:xch rA, indDE1 is phase=1 & op=0x61; op=0xAE & rA & indDE1 { local t:1 = rA; rA = indDE1; indDE1 = t; }
:xch rA, dspDE1 is phase=1 & op=0x61; op=0xAF & rA; dspDE1 { local t:1 = rA; rA = dspDE1; dspDE1 = t; }
:xch rA, idxB1 is phase=1 & op=0x61; op=0xB9 & rA & idxB1 { local t:1 = rA; rA = idxB1; idxB1 = t; }

# ---- oneb/clrb/cmp0/onew/clrw ----
:oneb rg01 is phase=1 & op_hi=14 & op_lo<4 & rg01 { rg01 = 1; }
:oneb saddr1 is phase=1 & op=0xE4; saddr1 { saddr1 = 1; }
:oneb abs1 is phase=1 & op=0xE5; abs1 { abs1 = 1; }
:clrb rg01 is phase=1 & op_hi=15 & op_lo<4 & rg01 { rg01 = 0; }
:clrb saddr1 is phase=1 & op=0xF4; saddr1 { saddr1 = 0; }
:clrb abs1 is phase=1 & op=0xF5; abs1 { abs1 = 0; }
:cmp0 rg01 is phase=1 & op_hi=13 & op_lo<4 & rg01 { cmp0(rg01); }
:cmp0 saddr1 is phase=1 & op=0xD4; saddr1 { cmp0(saddr1); }
:cmp0 abs1 is phase=1 & op=0xD5; abs1 { cmp0(abs1); }
:onew rAX is phase=1 & op=0xE6 & rAX { rAX = 1; }
:onew rBC is phase=1 & op=0xE7 & rBC { rBC = 1; }
:clrw rAX is phase=1 & op=0xF6 & rAX { rAX = 0; }
:clrw rBC is phase=1 & op=0xF7 & rBC { rBC = 0; }

:movs dspHL1, rX is phase=1 & op=0x61; op=0xCE & rX & rA; dspHL1 { dspHL1 = rX; Z = (rX == 0); CY = (rA == 0) || (rX == 0); }
:cmps rX, dspHL1 is phase=1 & op=0x61; op=0xDE & rX & rA; dspHL1 { local m:1 = dspHL1; AC = (rX & 0xF) < (m & 0xF); Z = (rX == m); CY = (rX != m) || (rA == 0) || (rX == 0); }

# ---- movw ----
:movw rp12, #imm16 is phase=1 & op_hi=3 & b3=0 & b0=0 & rp12; imm16 { rp12 = imm16; }
:movw rAX, rp12 is phase=1 & op_hi=1 & b3=0 & b0=1 & frp12!=0 & rp12 & rAX { rAX = rp12; }
:movw rp12, rAX is phase=1 & op_hi=1 & b3=0 & b0=0 & frp12!=0 & rp12 & rAX { rp12 = rAX; }
:movw saddr2, #imm16 is phase=1 & op=0xC9; saddr2; imm16 { saddr2 = imm16; }
:movw sfr2, #imm16 is phase=1 & op=0xCB; sfr2; imm16 { sfr2 = imm16; }
:movw rAX, saddr2 is phase=1 & op=0xAD & rAX; saddr2 { rAX = saddr2; }
:movw saddr2, rAX is phase=1 & op=0xBD & rAX; saddr2 { saddr2 = rAX; }
:movw rAX, sfr2 is phase=1 & op=0xAE & rAX; sfr2 { rAX = sfr2; }
:movw sfr2, rAX is phase=1 & op=0xBE & rAX; sfr2 { sfr2 = rAX; }
:movw rAX, abs2 is phase=1 & op=0xAF & rAX; abs2 { rAX = abs2; }
:movw abs2, rAX is phase=1 & op=0xBF & rAX; abs2 { abs2 = rAX; }
:movw rAX, indDE2 is phase=1 & op=0xA9 & rAX & indDE2 { rAX = indDE2; }
:movw indDE2, rAX is phase=1 & op=0xB9 & rAX & indDE2 { indDE2 = rAX; }
:movw rAX, indHL2 is phase=1 & op=0xAB & rAX & indHL2 { rAX = indHL2; }
:movw indHL2, rAX is phase=1 & op=0xBB & rAX & indHL2 { indHL2 = rAX; }
:movw rAX, dspDE2 is phase=1 & op=0xAA & rAX; dspDE2 { rAX = dspDE2; }
:movw dspDE2, rAX is phase=1 & op=0xBA & rAX; dspDE2 { dspDE2 = rAX; }
:movw rAX, dspHL2 is phase=1 & op=0xAC & rAX; dspHL2 { rAX = dspHL2; }
:movw dspHL2, rAX is phase=1 & op=0xBC & rAX; dspHL2 { dspHL2 = rAX; }
:movw rAX, dspSP2 is phase=1 & op=0xA8 & rAX; dspSP2 { rAX = dspSP2; }
:movw dspSP2, rAX is phase=1 & op=0xB8 & rAX; dspSP2 { dspSP2 = rAX; }
:movw rAX, wdB2 is phase=1 & op=0x59 & rAX; wdB2 { rAX = wdB2; }
:movw wdB2, rAX is phase=1 & op=0x58 & rAX; wdB2 { wdB2 = rAX; }
:movw rAX, wdC2 is phase=1 & op=0x69 & rAX; wdC2 { rAX = wdC2; }
:movw wdC2, rAX is phase=1 & op=0x68 & rAX; wdC2 { wdC2 = rAX; }
:movw rAX, wdBC2 is phase=1 & op=0x79 & rAX; wdBC2 { rAX = wdBC2; }
:movw wdBC2, rAX is phase=1 & op=0x78 & rAX; wdBC2 { wdBC2 = rAX; }
:movw rp45, saddr2 is phase=1 & op_lo=0xA & op_hi>=0xD & rp45; saddr2 { rp45 = saddr2; }
:movw rp45, absSP2 is phase=1 & op_lo=0xB & op_hi>=0xD & rp45; absSP2 { rp45 = absSP2; }
:xchw rAX, rp12 is phase=1 & op_hi=3 & b3=0 & b0=1 & frp12!=0 & rp12 & rAX { local t:2 = rAX; rAX = rp12; rp12 = t; }

# ---- shifts/rotates ----
:shl rC, cnt is phase=1 & op=0x31; op_lo=7 & b7=0 & cnt & rC { shl8(rC, cnt:1); }
:shl rB, cnt is phase=1 & op=0x31; op_lo=8 & b7=0 & cnt & rB { shl8(rB, cnt:1); }
:shl rA, cnt is phase=1 & op=0x31; op_lo=9 & b7=0 & cnt & rA { shl8(rA, cnt:1); }
:shr rA, cnt is phase=1 & op=0x31; op_lo=0xA & b7=0 & cnt & rA { shr8(rA, cnt:1); }
:sar rA, cnt is phase=1 & op=0x31; op_lo=0xB & b7=0 & cnt & rA { sar8(rA, cnt:1); }
:shlw rBC, wcnt is phase=1 & op=0x31; op_lo=0xC & wcnt & rBC { shl16(rBC, wcnt:2); }
:shlw rAX, wcnt is phase=1 & op=0x31; op_lo=0xD & wcnt & rAX { shl16(rAX, wcnt:2); }
:shrw rAX, wcnt is phase=1 & op=0x31; op_lo=0xE & wcnt & rAX { shr16(rAX, wcnt:2); }
:sarw rAX, wcnt is phase=1 & op=0x31; op_lo=0xF & wcnt & rAX { sar16(rAX, wcnt:2); }
:ror rA, 1 is phase=1 & op=0x61; op=0xDB & rA { CY = rA & 1; rA = (rA >> 1) | (rA << 7); }
:rol rA, 1 is phase=1 & op=0x61; op=0xEB & rA { CY = rA >> 7; rA = (rA << 1) | (rA >> 7); }
:rorc rA, 1 is phase=1 & op=0x61; op=0xFB & rA { local c:1 = CY; CY = rA & 1; rA = (rA >> 1) | (c << 7); }
:rolc rA, 1 is phase=1 & op=0x61; op=0xDC & rA { local c:1 = CY; CY = rA >> 7; rA = (rA << 1) | c; }
:rolwc rAX, 1 is phase=1 & op=0x61; op=0xEE & rAX { local c:2 = zext(CY); CY = rAX[15,1]; rAX = (rAX << 1) | c; }
:rolwc rBC, 1 is phase=1 & op=0x61; op=0xFE & rBC { local c:2 = zext(CY); CY = rBC[15,1]; rBC = (rBC << 1) | c; }

# ---- bit manipulation ----
:mov1 saddr1^"."^bitn, "CY" is phase=1 & op=0x71; b7=0 & op_lo=1 & bitn; saddr1 { saddr1 = (saddr1 & ~(1 << bitn)) | (CY << bitn); }
:mov1 sfr1^"."^bitn, "CY" is phase=1 & op=0x71; b7=0 & op_lo=9 & bitn; sfr1 { sfr1 = (sfr1 & ~(1 << bitn)) | (CY << bitn); }
:mov1 indHL1^"."^bitn, "CY" is phase=1 & op=0x71; b7=1 & op_lo=1 & bitn & indHL1 { indHL1 = (indHL1 & ~(1 << bitn)) | (CY << bitn); }
:mov1 rA^"."^bitn, "CY" is phase=1 & op=0x71; b7=1 & op_lo=9 & bitn & rA { rA = (rA & ~(1 << bitn)) | (CY << bitn); }
:set1 saddr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=2 & bitn; saddr1 { saddr1 = saddr1 | (1 << bitn); }
:set1 sfr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=10 & bitn; sfr1 { sfr1 = sfr1 | (1 << bitn); }
:set1 indHL1^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=2 & bitn & indHL1 { indHL1 = indHL1 | (1 << bitn); }
:set1 rA^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=10 & bitn & rA { rA = rA | (1 << bitn); }
:clr1 saddr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=3 & bitn; saddr1 { saddr1 = saddr1 & ~(1 << bitn); }
:clr1 sfr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=11 & bitn; sfr1 { sfr1 = sfr1 & ~(1 << bitn); }
:clr1 indHL1^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=3 & bitn & indHL1 { indHL1 = indHL1 & ~(1 << bitn); }
:clr1 rA^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=11 & bitn & rA { rA = rA & ~(1 << bitn); }
:mov1 "CY", saddr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=4 & bitn; saddr1 { CY = ((saddr1 >> bitn) & 1); }
:mov1 "CY", sfr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=12 & bitn; sfr1 { CY = ((sfr1 >> bitn) & 1); }
:mov1 "CY", indHL1^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=4 & bitn & indHL1 { CY = ((indHL1 >> bitn) & 1); }
:mov1 "CY", rA^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=12 & bitn & rA { CY = ((rA >> bitn) & 1); }
:and1 "CY", saddr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=5 & bitn; saddr1 { CY = CY & ((saddr1 >> bitn) & 1); }
:and1 "CY", sfr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=13 & bitn; sfr1 { CY = CY & ((sfr1 >> bitn) & 1); }
:and1 "CY", indHL1^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=5 & bitn & indHL1 { CY = CY & ((indHL1 >> bitn) & 1); }
:and1 "CY", rA^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=13 & bitn & rA { CY = CY & ((rA >> bitn) & 1); }
:or1 "CY", saddr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=6 & bitn; saddr1 { CY = CY | ((saddr1 >> bitn) & 1); }
:or1 "CY", sfr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=14 & bitn; sfr1 { CY = CY | ((sfr1 >> bitn) & 1); }
:or1 "CY", indHL1^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=6 & bitn & indHL1 { CY = CY | ((indHL1 >> bitn) & 1); }
:or1 "CY", rA^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=14 & bitn & rA { CY = CY | ((rA >> bitn) & 1); }
:xor1 "CY", saddr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=7 & bitn; saddr1 { CY = CY ^ ((saddr1 >> bitn) & 1); }
:xor1 "CY", sfr1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=15 & bitn; sfr1 { CY = CY ^ ((sfr1 >> bitn) & 1); }
:xor1 "CY", indHL1^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=7 & bitn & indHL1 { CY = CY ^ ((indHL1 >> bitn) & 1); }
:xor1 "CY", rA^"."^bitn is phase=1 & op=0x71; b7=1 & op_lo=15 & bitn & rA { CY = CY ^ ((rA >> bitn) & 1); }
:set1 abs1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=0 & bitn; abs1 { abs1 = abs1 | (1 << bitn); }
:clr1 abs1^"."^bitn is phase=1 & op=0x71; b7=0 & op_lo=8 & bitn; abs1 { abs1 = abs1 & ~(1 << bitn); }
:ei is phase=1 & op=0x71; op=0x7A; op=0xFA { IE = 1; }
:di is phase=1 & op=0x71; op=0x7B; op=0xFA { IE = 0; }
:set1 "CY" is phase=1 & op=0x71; op=0x80 { CY = 1; }
:clr1 "CY" is phase=1 & op=0x71; op=0x88 { CY = 0; }
:not1 "CY" is phase=1 & op=0x71; op=0xC0 { CY = CY ^ 1; }

# ---- flow ----
:br jabs20 is phase=1 & op=0xEC; jabs20 { goto jabs20; }
:br jabs16 is phase=1 & op=0xED; jabs16 { goto jabs16; }
:br rel16 is phase=1 & op=0xEE; rel16 { goto rel16; }
:br rel8 is phase=1 & op=0xEF; rel8 { goto rel8; }
:br rAX is phase=1 & op=0x61; op=0xCB & rAX { local t:3 = (zext(CS & 0xF) << 16) | zext(rAX); goto [t]; }
:bc rel8 is phase=1 & op=0xDC; rel8 { if (CY == 1) goto rel8; }
:bz rel8 is phase=1 & op=0xDD; rel8 { if (Z == 1) goto rel8; }
:bnc rel8 is phase=1 & op=0xDE; rel8 { if (CY == 0) goto rel8; }
:bnz rel8 is phase=1 & op=0xDF; rel8 { if (Z == 0) goto rel8; }
:bh rel8 is phase=1 & op=0x61; op=0xC3; rel8 { if ((Z | CY) == 0) goto rel8; }
:bnh rel8 is phase=1 & op=0x61; op=0xD3; rel8 { if ((Z | CY) == 1) goto rel8; }
:btclr saddr1^"."^bitn, rel8 is phase=1 & op=0x31; b7=0 & op_lo=0 & bitn; saddr1; rel8 { local m:1 = saddr1; if (((m >> bitn) & 1) == 0) goto <no>; saddr1 = m & ~(1 << bitn); goto rel8; <no> }
:btclr sfr1^"."^bitn, rel8 is phase=1 & op=0x31; b7=1 & op_lo=0 & bitn; sfr1; rel8 { local m:1 = sfr1; if (((m >> bitn) & 1) == 0) goto <no>; sfr1 = m & ~(1 << bitn); goto rel8; <no> }
:btclr rA^"."^bitn, rel8 is phase=1 & op=0x31; b7=0 & op_lo=1 & bitn & rA; rel8 { local m:1 = rA; if (((m >> bitn) & 1) == 0) goto <no>; rA = m & ~(1 << bitn); goto rel8; <no> }
:btclr indHL1^"."^bitn, rel8 is phase=1 & op=0x31; b7=1 & op_lo=1 & bitn & indHL1; rel8 { local m:1 = indHL1; if (((m >> bitn) & 1) == 0) goto <no>; indHL1 = m & ~(1 << bitn); goto rel8; <no> }
:bt saddr1^"."^bitn, rel8 is phase=1 & op=0x31; b7=0 & op_lo=2 & bitn; saddr1; rel8 { local m:1 = saddr1; if (((m >> bitn) & 1) == 0) goto <no>; goto rel8; <no> }
:bt sfr1^"."^bitn, rel8 is phase=1 & op=0x31; b7=1 & op_lo=2 & bitn; sfr1; rel8 { local m:1 = sfr1; if (((m >> bitn) & 1) == 0) goto <no>; goto rel8; <no> }
:bt rA^"."^bitn, rel8 is phase=1 & op=0x31; b7=0 & op_lo=3 & bitn & rA; rel8 { local m:1 = rA; if (((m >> bitn) & 1) == 0) goto <no>; goto rel8; <no> }
:bt indHL1^"."^bitn, rel8 is phase=1 & op=0x31; b7=1 & op_lo=3 & bitn & indHL1; rel8 { local m:1 = indHL1; if (((m >> bitn) & 1) == 0) goto <no>; goto rel8; <no> }
:bf saddr1^"."^bitn, rel8 is phase=1 & op=0x31; b7=0 & op_lo=4 & bitn; saddr1; rel8 { local m:1 = saddr1; if (((m >> bitn) & 1) != 0) goto <no>; goto rel8; <no> }
:bf sfr1^"."^bitn, rel8 is phase=1 & op=0x31; b7=1 & op_lo=4 & bitn; sfr1; rel8 { local m:1 = sfr1; if (((m >> bitn) & 1) != 0) goto <no>; goto rel8; <no> }
:bf rA^"."^bitn, rel8 is phase=1 & op=0x31; b7=0 & op_lo=5 & bitn & rA; rel8 { local m:1 = rA; if (((m >> bitn) & 1) != 0) goto <no>; goto rel8; <no> }
:bf indHL1^"."^bitn, rel8 is phase=1 & op=0x31; b7=1 & op_lo=5 & bitn & indHL1; rel8 { local m:1 = indHL1; if (((m >> bitn) & 1) != 0) goto <no>; goto rel8; <no> }
:call jabs20 is phase=1 & op=0xFC; jabs20 { pushpc(inst_next); call jabs20; }
:call jabs16 is phase=1 & op=0xFD; jabs16 { pushpc(inst_next); call jabs16; }
:call rel16 is phase=1 & op=0xFE; rel16 { pushpc(inst_next); call rel16; }
:call rp45 is phase=1 & op=0x61; op_lo=0xA & op_hi>=0xC & rp45 { local t:3 = (zext(CS & 0xF) << 16) | zext(rp45); pushpc(inst_next); call [t]; }
callt_t: "["^a^"]" is nnn & mm [ a = 0x80 + mm * 16 + nnn * 2; ] { export *[ram]:2 a; }
:callt callt_t is phase=1 & op=0x61; b7=1 & b3=0 & op_lo>=4 & op_lo<8 & callt_t { local t:3 = zext(callt_t); pushpc(inst_next); call [t]; }
:brk is phase=1 & op=0x61; op=0xCC { brk(); }
:brk1 is phase=1 & op=0xFF { brk1(); }
:ret is phase=1 & op=0xD7 { local sa:3 = segment(NEARSEG, SP); local t:3 = *[ram]:3 sa; SP = SP + 4; return [t]; }
:reti is phase=1 & op=0x61; op=0xFC { local sa:3 = segment(NEARSEG, SP); local t:3 = *[ram]:3 sa; PSW = *[ram]:1 (sa + 3); SP = SP + 4; return [t]; }
:retb is phase=1 & op=0x61; op=0xEC { local sa:3 = segment(NEARSEG, SP); local t:3 = *[ram]:3 sa; PSW = *[ram]:1 (sa + 3); SP = SP + 4; return [t]; }

# ---- conditional skips ----
:skc is phase=1 & op=0x61; op=0xC8 [ skip = 1; globalset(inst_next, skip); ] { }
:sknc is phase=1 & op=0x61; op=0xD8 [ skip = 2; globalset(inst_next, skip); ] { }
:skz is phase=1 & op=0x61; op=0xE8 [ skip = 3; globalset(inst_next, skip); ] { }
:sknz is phase=1 & op=0x61; op=0xF8 [ skip = 4; globalset(inst_next, skip); ] { }
:skh is phase=1 & op=0x61; op=0xE3 [ skip = 5; globalset(inst_next, skip); ] { }
:sknh is phase=1 & op=0x61; op=0xF3 [ skip = 6; globalset(inst_next, skip); ] { }

# ---- stack ----
:push rp12 is phase=1 & op_hi=0xC & b3=0 & b0=1 & rp12 { SP = SP - 2; local sa:3 = segment(NEARSEG, SP); *[ram]:2 sa = rp12; }
:pop rp12 is phase=1 & op_hi=0xC & b3=0 & b0=0 & rp12 { local sa:3 = segment(NEARSEG, SP); rp12 = *[ram]:2 sa; SP = SP + 2; }
:push "PSW" is phase=1 & op=0x61; op=0xDD { SP = SP - 2; local sa:3 = segment(NEARSEG, SP); *[ram]:1 (sa + 1) = PSW; *[ram]:1 sa = 0; }
:pop "PSW" is phase=1 & op=0x61; op=0xCD { local sa:3 = segment(NEARSEG, SP); PSW = *[ram]:1 (sa + 1); SP = SP + 2; }

# ---- misc ----
:nop is phase=1 & op=0x00 {}
:mulu rX is phase=1 & op=0xD6 & rX & rA & rAX { rAX = zext(rA) * zext(rX); }
:halt is phase=1 & op=0x61; op=0xED { halt(); }
:stop is phase=1 & op=0x61; op=0xFD { stop(); }
:sel "RB0" is phase=1 & op=0x61; op=0xCF [ bank = 0; globalset(inst_next, bank); ] { RBS0 = 0; RBS1 = 0; }
:sel "RB1" is phase=1 & op=0x61; op=0xDF [ bank = 1; globalset(inst_next, bank); ] { RBS0 = 1; RBS1 = 0; }
:sel "RB2" is phase=1 & op=0x61; op=0xEF [ bank = 2; globalset(inst_next, bank); ] { RBS0 = 0; RBS1 = 1; }
:sel "RB3" is phase=1 & op=0x61; op=0xFF [ bank = 3; globalset(inst_next, bank); ] { RBS0 = 1; RBS1 = 1; }

@ifdef RL78_S3
:mulhu is phase=1 & op=0xCE; op=0xFB; op=0x01 & rAX & rBC & rBCAX { rBCAX = zext(rAX) * zext(rBC); }
:mulh is phase=1 & op=0xCE; op=0xFB; op=0x02 & rAX & rBC & rBCAX { rBCAX = sext(rAX) * sext(rBC); }
:divhu is phase=1 & op=0xCE; op=0xFB; op=0x03 & rAX & rDE { local n:2 = rAX; local d:2 = rDE; if (d == 0) goto <z>; rAX = n / d; rDE = n % d; goto <e>; <z> rAX = 0xFFFF; rDE = n; <e> }
:divwu is phase=1 & op=0xCE; op=0xFB; (op=0x0B | op=0x04) & rBCAX & rHLDE { local n:4 = rBCAX; local d:4 = rHLDE; if (d == 0) goto <z>; rBCAX = n / d; rHLDE = n % d; goto <e>; <z> rBCAX = 0xFFFFFFFF; rHLDE = n; <e> }
:machu is phase=1 & op=0xCE; op=0xFB; op=0x05 & rAX & rBC { local o:4 = MACR; MACR = o + zext(rAX) * zext(rBC); CY = MACR < o; AC = 0; }
:mach is phase=1 & op=0xCE; op=0xFB; op=0x06 & rAX & rBC { local o:4 = MACR; local p:4 = sext(rAX) * sext(rBC); MACR = o + p; CY = (o ^ MACR) s< 0; AC = MACR s< 0; }
@endif
