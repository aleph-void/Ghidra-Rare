# Zilog Z8 (Z8601 / Z86xx / Z86Cxx and the UB8830/UB8840 clones).
#
# Written from Zilog UM0016 "Z8 CPU User Manual" (UM001604-0108). The instruction
# constructors and operand subtables are generated by tools/gen_z8.py into z8_gen.sinc;
# this file holds the spaces, registers, tokens, context and flag helpers.
#
# Address spaces
#   code  64K program memory (LDC/LDCI, instruction fetch)
#   data  64K external data memory (LDE/LDEI, external stack)
#   rf    the 256-byte register file (ports 00-03, GPRs 04-EF, control registers F0-FF)
#   erf   expanded register file banks 1-F, registers 00-0F of bank b at erf:(b<<4)|r
#
# FLAGS (FC), SPH (FE) and SPL (FF) live in the register space so the decompiler sees the
# flags and the stack pointer; register-file operands that name them statically are routed
# to those registers (see z8_gen.sinc). RP (FD) stays in rf.
#
# Register pointer tracking: the context holds the RP value when it is known (after SRP or
# LD RP,#imm, and at the reset entry where RP resets to 00h). With a known RP, working
# registers R0-R15 resolve to fixed register-file (or ERF) addresses; with an unknown RP
# they are computed from RP at run time.

define endian=big;
define alignment=1;

define space code     type=ram_space      size=2  default;
define space data     type=ram_space      size=2;
define space rf       type=ram_space      size=1;
define space erf      type=ram_space      size=1;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ SP ];
define register offset=0x00 size=1 [ SPH SPL ];
define register offset=0x10 size=2 [ PC ];
define register offset=0x20 size=1 [ C Z S V D H FLAGS ];
define register offset=0x40 size=4 [ contextreg ];

define context contextreg
	rpv = (0,0)     # 1: RP value below is known
	rpg = (1,4)     # RP[7:4], working register group
	rpb = (5,8)     # RP[3:0], expanded register file bank
;

define token op8 (8)
	op   = (0,7)
	ophi = (4,7)
	ophid = (4,7)
	ophir = (4,7)
	oplo = (0,3)
;
define token b1tok (8)
	b1   = (0,7)
	b1s  = (0,7) signed
	b1hi = (4,7)
	b1lo = (0,3)
	b1hid = (4,7)
	b1lod = (0,3)
	b1hir = (4,7)
	b1lor = (0,3)
;
define token b2tok (8)
	b2   = (0,7)
	b2hi = (4,7)
	b2lo = (0,3)
	b2lod = (0,3)
	b2lor = (0,3)
;
define token w16tok (16)
	da16 = (0,15)
;

# working register names (the Rn / RRn display of a 4-bit register field)
attach names [ ophid b1hid b1lod b2lod ] [ "R0" "R1" "R2" "R3" "R4" "R5" "R6" "R7" "R8" "R9" "R10" "R11" "R12" "R13" "R14" "R15" ];
attach names [ ophir b1hir b1lor b2lor ] [ "RR0" "RR1" "RR2" "RR3" "RR4" "RR5" "RR6" "RR7" "RR8" "RR9" "RR10" "RR11" "RR12" "RR13" "RR14" "RR15" ];

define pcodeop halt;
define pcodeop stop;
define pcodeop watchdog_refresh;
define pcodeop watchdog_halt_enable;

macro packflags() {
	FLAGS = (C << 7) | (Z << 6) | (S << 5) | (V << 4) | (D << 3) | (H << 2) | (FLAGS & 3);
}

macro unpackflags() {
	C = (FLAGS >> 7) & 1;
	Z = (FLAGS >> 6) & 1;
	S = (FLAGS >> 5) & 1;
	V = (FLAGS >> 4) & 1;
	D = (FLAGS >> 3) & 1;
	H = (FLAGS >> 2) & 1;
}

macro zs8(r) {
	Z = (r == 0);
	S = (r s< 0);
}

macro zs16(r) {
	Z = (r == 0);
	S = (r s< 0);
}

@ifdef EXTSTACK
macro push8(v) {
	SP = SP - 1;
	*[data]:1 SP = v;
}
macro pop8(v) {
	v = *[data]:1 SP;
	SP = SP + 1;
}
macro push16(v) {
	SP = SP - 2;
	*[data]:2 SP = v;
}
macro pop16(v) {
	v = *[data]:2 SP;
	SP = SP + 2;
}
@else
macro push8(v) {
	SPL = SPL - 1;
	*[rf]:1 SPL = v;
}
macro pop8(v) {
	v = *[rf]:1 SPL;
	SPL = SPL + 1;
}
macro push16(v) {
	SPL = SPL - 2;
	*[rf]:2 SPL = v;
}
macro pop16(v) {
	v = *[rf]:2 SPL;
	SPL = SPL + 2;
}
@endif

# relative branch target (DJNZ, JR)
rel: reloc is b1s [ reloc = inst_next + b1s; ] { export *:1 reloc; }
# direct address (JP, CALL)
dabs: da16 is da16 { export *:1 da16; }

# condition codes (UM0016 table 36), cc in the opcode's upper nibble
cc: "LT"  is ophi=0x1 { local t:1 = (S != V); export t; }
cc: "LE"  is ophi=0x2 { local t:1 = (Z != 0) || (S != V); export t; }
cc: "ULE" is ophi=0x3 { local t:1 = (C != 0) || (Z != 0); export t; }
cc: "OV"  is ophi=0x4 { local t:1 = (V != 0); export t; }
cc: "MI"  is ophi=0x5 { local t:1 = (S != 0); export t; }
cc: "Z"   is ophi=0x6 { local t:1 = (Z != 0); export t; }
cc: "C"   is ophi=0x7 { local t:1 = (C != 0); export t; }
cc: "GE"  is ophi=0x9 { local t:1 = (S == V); export t; }
cc: "GT"  is ophi=0xa { local t:1 = (Z == 0) && (S == V); export t; }
cc: "UGT" is ophi=0xb { local t:1 = (C == 0) && (Z == 0); export t; }
cc: "NOV" is ophi=0xc { local t:1 = (V == 0); export t; }
cc: "PL"  is ophi=0xd { local t:1 = (S == 0); export t; }
cc: "NZ"  is ophi=0xe { local t:1 = (Z == 0); export t; }
cc: "NC"  is ophi=0xf { local t:1 = (C == 0); export t; }

@include "z8_gen.sinc"
